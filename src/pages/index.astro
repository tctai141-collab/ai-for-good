---
import App from "../components/App";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Sprint Buddy</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!--
      Self-hosted rather than loaded from Google. Every page view used to send
      each founder's IP address to a third party, which sits badly with an
      EU-hosted service holding students' private reflections. Regenerate with
      `bun scripts/fetch-fonts.ts`.
    -->
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body>
    <App client:only="react" />
  </body>
</html>

<style is:global>
  /* ═══════════════════════════════════════
     DESIGN TOKENS
     ═══════════════════════════════════════ */
  /*
   * ── Design tokens ──
   *
   * Benchmarked against Linear. What that actually means, since "make it look
   * like Linear" is not a spec:
   *
   *   One family. Linear sets its whole product in Inter and leans on weight,
   *   size and tracking for hierarchy rather than on a second face. This app
   *   ran Inter against Source Serif 4 and put the serif at 88px on the login
   *   screen; that pairing is what read as decoration rather than product.
   *   --font-serif and --font-display now point at Inter, so every call site
   *   follows without a hundred edits, and the italic serif that carried a
   *   founder's own quoted words is now italic Inter.
   *
   *   Small type, tight tracking. Linear's body copy is 14-15px and its
   *   headings are 21-32px with negative letter-spacing, not 40-88px. The
   *   scale below is rebuilt on that; the display step exists for the login
   *   screen alone and is a third of what it was.
   *
   *   Near-black, and almost no border. Linear's canvas is #08090a with
   *   rules at 6-10% white. The old surfaces were lighter and the rules
   *   heavier, which is what made every panel look like a box.
   *
   *   The accent is Linear's indigo. That also fixes something the old palette
   *   had a comment apologising for: the accent was signal red and so is the
   *   status colour for overdue, error and strain. Accent and alarm were a
   *   shade apart, which is the one thing a status palette must not do. Red
   *   now means only one thing.
   */
  :root {
    /* ── Accent ── */
    --brand-accent: #5e6ad2;
    --brand-accent-hover: #6e79d6;

    /* ── Status. Distinct from the accent, and from each other. ── */
    --brand-red: #eb5757;
    --brand-yellow: #f2c94c;
    --brand-green: #4cb782;

    --color-cube-face: #08090a;

    /* ── Surfaces ── */
    --surface-bg: #08090a;
    --surface-sidebar: #08090a;
    --surface-card: #0f1011;
    --surface-card-2: #17181a;

    /* ── Ink ── */
    --ink: #f7f8f8;
    --ink-sub: #d0d6e0;
    --ink-faint: #8a8f98;

    /* ── Lines. Barely there on purpose. ── */
    --line: rgba(255, 255, 255, 0.06);
    --line-strong: rgba(255, 255, 255, 0.10);
    --line-visible: rgba(255, 255, 255, 0.16);

    /* ── User bubble tint ── */
    --bubble-user: rgba(94, 106, 210, 0.16);

    /* ── Legacy aliases (existing CSS reads these; do not remove) ── */
    --color-accent: var(--brand-accent);
    --color-accent-subtle: rgba(94, 106, 210, 0.16);
    --color-accent-border: rgba(94, 106, 210, 0.38);
    --color-energy: var(--brand-red);
    --color-warmth: var(--brand-yellow);
    --color-bg: var(--surface-bg);
    --color-bg-elevated: var(--surface-card);
    --color-text: var(--ink);
    --color-text-secondary: var(--ink-sub);
    --color-text-tertiary: var(--ink-faint);
    --color-text-muted: #6e7178;
    --color-text-dim: #55585e;
    --color-border: var(--line);
    --color-border-strong: var(--line-strong);
    --color-border-visible: var(--line-visible);
    --color-surface-card: var(--surface-card);
    --color-surface-hover: var(--surface-card-2);
    --color-surface-popover: rgba(23, 24, 26, 0.96);

    /* ── Spacing (4pt scale) ── */
    --space-2xs: 0.25rem;
    --space-xs: 0.5rem;
    --space-sm: 0.75rem;
    --space-md: 1rem;
    --space-lg: 1.25rem;
    --space-xl: 1.5rem;
    --space-2xl: 2rem;
    --space-3xl: 3rem;
    --space-4xl: 4rem;

    /* ── Radius ── */
    --radius-sm: 6px;
    --radius-md: 8px;
    --radius-lg: 12px;

    /* ── Typography: one face, hierarchy from weight and tracking ── */
    --font-family: Inter, ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
    /* Both kept as tokens rather than removed: they are read from about a
       hundred inline styles, and repointing them is the whole migration. */
    --font-serif: var(--font-family);
    --font-display: var(--font-family);

    --text-xs: 0.75rem;
    --text-sm: 0.8125rem;
    --text-base: 0.875rem;
    --text-lg: 0.9375rem;
    --text-xl: 1.0625rem;
    --text-h3: 1.125rem;
    --text-h2: 1.3125rem;
    --text-h1: 1.75rem;
    --text-display: clamp(2rem, 4.5vw, 3rem);
    --text-heading: var(--text-display);

    /* Tracking tightens as type grows, which is the single thing that makes
       large Inter look set rather than typed. */
    --track-display: -0.028em;
    --track-heading: -0.021em;
    --track-body: -0.011em;
    --track-label: 0.04em;

    /* ── Motion ── */
    --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
    --duration-instant: 80ms;
    --duration-fast: 200ms;
    --duration-normal: 300ms;
    --duration-slow: 500ms;
    --duration-landing: 600ms;
    --duration-transition: 700ms;
  }

  /* ── Reset & Base ── */
  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--color-bg);
  }
  body {
    min-height: 100vh;
    overflow: hidden;
    font-family: var(--font-family);
    color: var(--color-text);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* ── Focus visible (applied globally) ── */
  :focus {
    outline: none;
  }
  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── Login ── */
  .login-screen {
    position: relative;
    /* A stacking context of its own, so the canvas can sit at z-index -1
       behind the card without escaping to behind the page background. */
    isolation: isolate;
    min-height: 100vh;
    display: flex;
    align-items: stretch;
    padding: clamp(0.6rem, 2.3vw, 2rem);
    background:
      linear-gradient(90deg, rgba(94, 106, 210, 0.1), transparent 48%),
      radial-gradient(circle at 24% 48%, rgba(255, 255, 255, 0.13), transparent 18rem),
      var(--color-bg);
  }
  /* The kinetic lattice. Sits under the page's own gradients and the sign-in
     card, and can never intercept a click on the form.

     Fixed rather than absolute: the canvas is sized to the viewport, so
     anchoring it to the scrolling box would leave it misplaced the moment the
     login screen is taller than the window. */
  .kinetic-grid {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: block;
    pointer-events: none;
  }

  .login-hero {
    width: min(100%, 90rem);
    margin: auto;
    display: grid;
    grid-template-columns: minmax(20rem, 1.35fr) minmax(22rem, 0.9fr);
    align-items: center;
    gap: clamp(1.6rem, 5.4vw, 6rem);
  }
  .login-mascot-panel {
    position: relative;
    min-height: clamp(30rem, 78vh, 58rem);
    display: grid;
    place-items: center;
    perspective: 1400px;
  }
  .login-halo {
    position: absolute;
    width: clamp(30rem, 66vw, 58rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.68) 0 5%, rgba(255, 255, 255, 0.28) 18%, rgba(94, 106, 210, 0.2) 38%, transparent 70%),
      radial-gradient(circle at 38% 62%, rgba(242, 201, 76, 0.14), transparent 36%),
      radial-gradient(circle at 70% 38%, rgba(94, 106, 210, 0.18), transparent 35%);
    filter: blur(24px);
    opacity: 0.86;
  }
  /* ── The scrambling wordmark ──
     Sits above the sign-in fields. Each of the programme's three names
     arrives as noise and resolves into itself, left to right. */
  .scramble {
    position: relative;
    display: block;
    margin-bottom: var(--space-sm);
    font-weight: 600;
    /*
     * Sized against the panel, not the viewport.
     *
     * Measured: at the previous size the longest of the three names filled 72%
     * of the panel's width, which is what made it read as small next to the
     * fields rather than as their heading. 10.2cqw puts it at about 95%, and
     * because it tracks the container it holds that proportion at every
     * viewport instead of drifting as vw and the panel's max-width diverge.
     *
     * The vw line first, as the fallback: a browser without container queries
     * treats the cqw declaration as invalid and keeps this one.
     */
    font-size: clamp(1.25rem, 3.4vw, 1.75rem);
    font-size: clamp(1.25rem, 6.4cqw, 1.75rem);
    line-height: 1.2;
    letter-spacing: var(--track-display);
    color: var(--color-text);
    white-space: nowrap;
  }
  /*
   * Holds the line's width and height from the longest name, and is never
   * seen. Without it the box is sized by whatever is on screen this frame,
   * and since the noise alphabet is nothing like the letters it replaces, the
   * fields below would jog up and down for the whole animation.
   */
  .scramble-gauge {
    display: block;
    visibility: hidden;
  }
  .scramble-live {
    position: absolute;
    inset: 0;
    display: block;
  }

  .login-panel {
    /* The wordmark above the fields sizes itself in cqw against this. */
    container-type: inline-size;
    position: relative;
    /* Above the word ring. The ring is fixed and the panel is in flow, so
       without this the giant type paints over the email field. */
    z-index: 10;
    width: min(100%, 27rem);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-lg);
  }
  .login-mascot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: clamp(24rem, 56vw, 48rem);
    height: clamp(24rem, 56vw, 48rem);
    transform: translateX(-4%);
  }
  .login-mascot-anchor {
    pointer-events: none;
  }
  .persistent-buddy {
    position: fixed;
    z-index: 40;
    --buddy-size: clamp(3rem, 6vw, 5rem);
    width: var(--buddy-size);
    height: var(--buddy-size);
    display: grid;
    place-items: center;
    pointer-events: none;
    transform-origin: center;
    transition:
      top 820ms var(--ease-out-expo),
      left 820ms var(--ease-out-expo),
      transform 820ms var(--ease-out-expo),
      filter 820ms var(--ease-out-expo);
    filter: drop-shadow(0 0.8rem 1.6rem rgba(0, 0, 0, 0.26));
  }
  .persistent-buddy::before {
    content: "";
    position: absolute;
    inset: -88%;
    z-index: -1;
    /* Purely decorative glow. Without this it extends the mascot's hit area by
       ~70px in every direction and silently swallows clicks on nearby UI. */
    pointer-events: none;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.42) 0 8%, rgba(94, 106, 210, 0.25) 24%, rgba(247, 225, 89, 0.15) 48%, transparent 72%),
      radial-gradient(circle at 72% 28%, rgba(94, 106, 210, 0.18), transparent 42%);
    filter: blur(14px);
    opacity: 0;
    transform: scale(0.72);
    transition:
      opacity 520ms var(--ease-out-quart),
      transform 820ms var(--ease-out-expo);
  }
  .persistent-buddy--login {
    --buddy-size: clamp(16rem, 32vw, 30rem);
    top: 50%;
    left: clamp(10rem, 28vw, 28rem);
    transform: translate(-50%, -50%) scale(1);
    filter: drop-shadow(0 2rem 5rem rgba(0, 0, 0, 0.42));
  }
  .persistent-buddy--login::before {
    display: none;
  }
  .persistent-buddy--docked {
    top: calc(clamp(0.9rem, 2.2vw, 1.35rem) + var(--buddy-size) / 2);
    left: calc(100vw - clamp(0.9rem, 2vw, 1.35rem) - var(--buddy-size) / 2);
    transform: translate(-50%, -50%) scale(1);
    pointer-events: auto;
  }
  .persistent-buddy--docked::before {
    opacity: 0.72;
    transform: scale(1);
  }
  .persistent-buddy--docked .cube {
    cursor: pointer;
  }
  .buddy-tip {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    width: min(18rem, calc(100vw - 2rem));
    padding: 0.72rem 0.82rem 0.78rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 8px;
    background: rgba(14, 15, 18, 0.92);
    color: var(--color-text-secondary);
    box-shadow: 0 0.9rem 2rem rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(12px);
    pointer-events: none;
    animation: buddy-tip-in var(--duration-fast) var(--ease-out-quart);
  }
  .buddy-tip-arrow {
    position: absolute;
    top: -6px;
    right: 1.8rem;
    width: 10px;
    height: 10px;
    border-left: 1px solid var(--color-border-strong);
    border-top: 1px solid var(--color-border-strong);
    background: rgba(14, 15, 18, 0.92);
    transform: rotate(45deg);
  }
  .buddy-tip p {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.42;
    letter-spacing: 0;
  }
  @keyframes buddy-tip-in {
    from {
      opacity: 0;
      transform: translateY(-0.35rem) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .login-kicker,
  .organizer-kicker {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .login-title {
    margin: 0;
    color: var(--ink);
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    line-height: 0.96;
    font-weight: 900;
    text-align: left;
    letter-spacing: -0.035em;
  }
  .login-title-line {
    display: inline-block;
    text-wrap: balance;
  }
  .login-title-line--buddy {
    font-size: 1.18em;
    line-height: 0.94;
    letter-spacing: -0.04em;
  }
  .login-title-accent {
    color: var(--brand-accent);
  }
  .organizer-logout {
    min-height: 44px;
    border: 0;
    font-family: var(--font-family);
    font-weight: 700;
    cursor: pointer;
  }
  .login-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-xs);
  }
  .login-meta {
    display: flex;
    justify-content: flex-end;
  }
  .login-forgot {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--ink-faint);
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .login-forgot:hover {
    color: var(--ink);
  }
  .login-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    color: var(--ink-faint);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  .login-field input {
    min-height: 40px;
    padding: 0 var(--space-md);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  .login-field input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(94, 106, 210, 0.22);
  }
  .login-error {
    margin: 0;
    color: var(--color-energy);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  /* ── Liquid glass sign-in ──
     Three stacked layers inside one <button>. Order matters: the label is
     last and raised, because anything underneath the pane is refracted along
     with the background. */
  .glass-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    /* Matched to the fields above it. At 52px against a 40px input it read as
       a different component from the form it belongs to. */
    min-height: 40px;
    padding: 0 var(--space-lg);
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-family);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.005em;
    cursor: pointer;
    isolation: isolate;
    transition: transform 220ms var(--ease-out-quart), filter 220ms var(--ease-out-quart);
  }
  .glass-button:disabled {
    cursor: default;
    opacity: 0.55;
  }
  .glass-button:not(:disabled):hover {
    transform: scale(1.015);
    filter: brightness(1.08);
  }
  .glass-button:not(:disabled):active {
    transform: scale(0.995) translateY(1px);
  }
  .glass-button:focus-visible {
    outline: 2px solid var(--brand-accent);
    outline-offset: 3px;
  }

  /* The refracting pane. Tinted, because on a near-black ground the
     refraction alone returns near-black and the pane would not read as a
     pane at all: measured against this app's own login background, displacing
     by 8, 24 or 70 is indistinguishable. The tint is what makes it glass. */
  .glass-button-pane {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.055);
    backdrop-filter: url("#sprint-glass");
    -webkit-backdrop-filter: url("#sprint-glass");
  }

  /* The bevel. Entirely box-shadow, and on this background it is the layer
     doing nearly all the visible work. */
  .glass-button-bevel {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
    box-shadow:
      0 0 8px rgba(0, 0, 0, 0.03),
      0 2px 6px rgba(0, 0, 0, 0.08),
      inset 3px 3px 0.5px -3.5px rgba(255, 255, 255, 0.09),
      inset -3px -3px 0.5px -3.5px rgba(255, 255, 255, 0.85),
      inset 1px 1px 1px -0.5px rgba(255, 255, 255, 0.6),
      inset -1px -1px 1px -0.5px rgba(255, 255, 255, 0.6),
      inset 0 0 6px 6px rgba(255, 255, 255, 0.12),
      inset 0 0 2px 2px rgba(255, 255, 255, 0.06),
      0 0 12px rgba(0, 0, 0, 0.15);
  }

  .glass-button-label {
    position: relative;
    z-index: 2;
  }

  /* The filter lives in the flow but must never take space or paint. */
  .glass-button-filter {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-button { transition: none; }
    .glass-button:not(:disabled):hover { transform: none; }
  }
  .login-blurb {
    max-width: 26rem;
    margin: 0.3rem 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--ink-sub);
  }

  /* ── Organizer Preview ── */
  .organizer-dashboard {
    min-height: 100vh;
    padding: clamp(1.25rem, 4vw, 3rem);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .organizer-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-bottom: var(--space-3xl);
  }
  .organizer-header h1 {
    margin: 0.35rem 0 0;
    font-size: clamp(2rem, 7vw, 4.5rem);
    line-height: 0.95;
  }
  .organizer-logout {
    padding: 0 var(--space-lg);
    border-radius: 8px;
    background: var(--color-surface-hover);
    color: var(--color-text-secondary);
  }
  .organizer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }
  .organizer-metric,
  .organizer-feed {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface-card);
  }
  .organizer-metric {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
  }
  .organizer-metric span {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .organizer-metric strong {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
  }
  .organizer-metric--attention strong {
    color: var(--color-warmth);
  }
  .organizer-feed {
    max-width: 44rem;
    padding: var(--space-xl);
  }
  .organizer-feed h2 {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-lg);
  }
  .organizer-feed p {
    margin: 0;
    color: var(--color-text-tertiary);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  /* ── Screen-reader only ── */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── App Root ── */
  .app-root {
    position: relative;
    min-height: 100vh;
    background: var(--color-bg);
    overflow: hidden;
    padding-top: env(safe-area-inset-top);
  }

  /* ── Landing Overlay ── */
  .landing-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    align-content: center;
    gap: clamp(2.25rem, 5vh, 3.75rem);
    padding: 2rem;
    background: var(--color-bg);
    cursor: pointer;
    transition: opacity var(--duration-landing) var(--ease-out-quart),
      transform var(--duration-landing) var(--ease-out-quart);
  }
  .phase-transitioning .landing-overlay {
    opacity: 0;
    transform: scale(1.05);
    pointer-events: none;
  }
  .phase-app .landing-overlay {
    display: none;
  }

  .landing-overlay::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 47%, rgba(255, 255, 255, 0.11), transparent 18rem),
      radial-gradient(circle at 50% 55%, rgba(94, 106, 210, 0.1), transparent 26rem);
    mix-blend-mode: screen;
  }

  .landing-halo {
    position: absolute;
    top: clamp(2rem, 8vh, 5rem);
    width: clamp(18rem, 44vw, 38rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.8) 0 6%, rgba(255, 255, 255, 0.44) 17%, rgba(255, 255, 255, 0.13) 35%, transparent 67%),
      radial-gradient(circle at 35% 62%, rgba(247, 225, 89, 0.24), transparent 35%),
      radial-gradient(circle at 70% 40%, rgba(253, 99, 96, 0.2), transparent 34%);
    filter: blur(18px);
    opacity: 0.92;
    transform: translateY(-8%);
    z-index: -1;
    transition: opacity var(--duration-landing) var(--ease-out-quart),
      transform var(--duration-landing) var(--ease-out-quart);
  }
  .phase-transitioning .landing-halo {
    opacity: 0;
    transform: translateY(-8%) scale(0.6);
  }

  .landing-cube-wrap {
    width: clamp(15rem, 34vw, 30rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    perspective: 1100px;
    transition: transform var(--duration-transition) var(--ease-out-quart),
      opacity var(--duration-landing) var(--ease-out-quart);
  }
  .phase-transitioning .landing-cube-wrap {
    transform: translateY(-12vh) scale(0.25);
    opacity: 0;
  }

  .landing-title {
    margin: 0;
    font-size: var(--text-heading);
    line-height: 0.88;
    font-weight: 900;
    letter-spacing: 0;
    color: #f6f6f6;
    text-align: center;
    text-shadow:
      0 0 1.2rem rgba(255, 255, 255, 0.18),
      0 0 3.5rem rgba(94, 106, 210, 0.16);
    transition: opacity var(--duration-normal) var(--ease-out-quart),
      transform var(--duration-normal) var(--ease-out-quart);
  }
  .phase-transitioning .landing-title {
    opacity: 0;
    transform: translateY(-20px);
  }

  .landing-hint {
    position: fixed;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    animation: pulse-hint 2.4s ease-in-out infinite;
  }
  .phase-transitioning .landing-hint {
    opacity: 0;
  }

  @keyframes pulse-hint {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 0.7;
    }
  }

  /* ── Cube Styles (shared hero + compact) ── */
  .cube {
    position: relative;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .cube--hero {
    width: var(--size);
    height: var(--size);
  }
  .cube--compact {
    width: var(--size);
    height: var(--size);
  }

  .face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.01) 34%, rgba(0, 0, 0, 0.98) 68%),
      var(--color-cube-face);
    border: 1px solid var(--color-border-visible);
    box-shadow:
      inset 0 0 4rem rgba(255, 255, 255, 0.04),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 1.8rem rgba(255, 255, 255, 0.14);
    backface-visibility: hidden;
  }
  .front {
    transform: translateZ(var(--half));
  }
  .back {
    transform: rotateY(180deg) translateZ(var(--half));
  }
  .right {
    transform: rotateY(90deg) translateZ(var(--half));
  }
  .left {
    transform: rotateY(-90deg) translateZ(var(--half));
  }
  .top {
    transform: rotateX(90deg) translateZ(var(--half));
  }
  .bottom {
    transform: rotateX(-90deg) translateZ(var(--half));
  }

  .eyes {
    display: flex;
    gap: calc(var(--size) * 0.17);
    transform: translateY(calc(var(--size) * -0.03));
  }
  .eye {
    position: relative;
    width: calc(var(--size) * 0.12);
    height: calc(var(--size) * 0.25);
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.56);
    border-radius: 2px;
    background: #000;
    box-shadow:
      0 0 1.3rem rgba(255, 255, 255, 0.12),
      inset 0 0 1rem rgba(255, 255, 255, 0.04);
  }
  .pupil {
    width: calc(var(--size) * 0.045);
    height: calc(var(--size) * 0.1);
    background: rgba(255, 255, 255, 0.94);
    border-radius: 1px;
    box-shadow: 0 0 1rem rgba(255, 255, 255, 0.76);
    transition: transform var(--duration-instant) ease-out;
  }

  /* compact cube adjustments */
  .cube--compact .face {
    border-width: 0.5px;
    box-shadow:
      inset 0 0 1rem rgba(255, 255, 255, 0.02),
      0 0 0.6rem rgba(255, 255, 255, 0.08);
  }
  .cube--compact .eye {
    width: calc(var(--size) * 0.14);
    height: calc(var(--size) * 0.28);
  }
  .cube--compact .pupil {
    width: calc(var(--size) * 0.055);
    height: calc(var(--size) * 0.12);
  }

  /* ── The welcome screen ──
     Shown for three seconds between a successful sign-in and the app: code
     rain on a canvas, the message typed over it. */
  .splash {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    background: #05070a;
    animation: splash-in 320ms var(--ease-out-quart);
  }
  .splash-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .splash-line {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0 var(--space-lg);
    /* The line breaks where the message says it does. Left to the box it broke
       wherever the width fell, orphaning "It" at the end of the first line. */
    white-space: pre-line;
    /* Only a very long name should wrap, and then evenly rather than leaving
       one word alone on the second line. */
    max-width: 30ch;
    text-wrap: balance;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: clamp(1.1rem, 3.4vw, 2.4rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-align: center;
    color: #d8ffe8;
    /* The rain is busy; the glow is what keeps the line legible over it
       without putting a panel behind the words. */
    text-shadow:
      0 0 12px rgba(0, 255, 102, 0.55),
      0 0 34px rgba(0, 255, 102, 0.28),
      0 2px 18px rgba(0, 0, 0, 0.9);
  }
  .typewriter-cursor {
    margin-left: 0.08em;
    animation: caret 1s steps(1) infinite;
  }
  /* Once the line is finished the caret keeps blinking; it is the only thing
     still moving, and a frozen caret reads as a hang. */
  .typewriter-cursor--done {
    animation-duration: 1.15s;
  }
  @keyframes caret {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  @keyframes splash-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .splash { animation: none; }
    .typewriter-cursor { animation: none; opacity: 1; }
  }

  /* ── Shimmering text ──
     A highlight travelling through the glyphs, used on the wait while Sprint
     Buddy is answering. Two background layers clipped to the text: a flat base
     colour, and a moving window of brighter colour over it. */
  .shimmer {
    --shimmer-base: rgba(255, 255, 255, 0.34);
    --shimmer-high: rgba(255, 255, 255, 0.96);
    --shimmer-spread: 40px;
    --shimmer-duration: 1.6s;
    display: inline-block;
    background-image:
      linear-gradient(
        90deg,
        transparent calc(50% - var(--shimmer-spread)),
        var(--shimmer-high),
        transparent calc(50% + var(--shimmer-spread))
      ),
      linear-gradient(var(--shimmer-base), var(--shimmer-base));
    background-repeat: no-repeat, padding-box;
    /* The moving layer is far wider than the text so the highlight has
       somewhere to travel from and to. */
    background-size: 250% 100%, auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer var(--shimmer-duration) linear infinite;
  }
  /* Sized and coloured for the chat's own type scale rather than inheriting a
     headline's weight. */
  .composer-wait {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    --shimmer-base: rgba(255, 255, 255, 0.28);
    --shimmer-high: rgba(255, 255, 255, 0.92);
  }
  @keyframes shimmer {
    /* Both layers have to be listed: a keyframe that names one position for a
       two-layer background drops the second layer for the duration. */
    from { background-position: 100% center, 0 0; }
    to { background-position: 0% center, 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    /* No travelling highlight, and the text painted flat rather than left
       transparent with nothing moving through it. */
    .shimmer {
      animation: none;
      background-image: none;
      color: var(--shimmer-base);
    }
  }

  /* ── Hover-reveal button ──
     Used on the share control, which a founder could not tell was a control:
     at rest it read "Private" in muted grey and nothing suggested clicking it
     did anything. */
  .ihb {
    position: relative;
    display: inline-grid;
    place-items: center;
    overflow: hidden;
    min-height: 34px;
    padding: 7px 18px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-sub);
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
    cursor: pointer;
    isolation: isolate;
    transition: border-color 240ms var(--ease-out-quart), color 240ms var(--ease-out-quart);
  }
  /* The live state, so a shared thread is legible without hovering it. */
  .ihb--on {
    border-color: var(--brand-accent);
    color: var(--brand-accent);
  }
  .ihb:focus-visible {
    outline: 2px solid var(--brand-accent);
    outline-offset: 2px;
  }

  /* Both labels share one grid cell, so the pill is sized by the wider of the
     two and never changes width when they swap. */
  .ihb-label,
  .ihb-action {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    transition:
      transform 300ms var(--ease-out-quart),
      opacity 240ms var(--ease-out-quart);
  }
  .ihb-label {
    z-index: 2;
    transform: translateX(0);
  }
  .ihb-action {
    z-index: 3;
    color: oklch(15% 0.01 25);
    transform: translateX(2.5rem);
    opacity: 0;
    pointer-events: none;
  }
  .ihb-arrow {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The dot that swells to fill the pill. */
  .ihb-fill {
    position: absolute;
    top: 40%;
    left: 18%;
    z-index: 1;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--brand-accent);
    transform: scale(1);
    transition:
      top 320ms var(--ease-out-quart),
      left 320ms var(--ease-out-quart),
      width 320ms var(--ease-out-quart),
      height 320ms var(--ease-out-quart),
      transform 320ms var(--ease-out-quart);
    pointer-events: none;
  }

  .ihb:hover,
  .ihb:focus-visible {
    border-color: var(--brand-accent);
  }
  .ihb:hover .ihb-label,
  .ihb:focus-visible .ihb-label {
    transform: translateX(2.5rem);
    opacity: 0;
  }
  .ihb:hover .ihb-action,
  .ihb:focus-visible .ihb-action {
    transform: translateX(0);
    opacity: 1;
  }
  .ihb:hover .ihb-fill,
  .ihb:focus-visible .ihb-fill {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* Overshoot the pill so the rounded corners fill rather than leaving the
       dot's own radius showing inside them. */
    transform: scale(1.6);
  }
  .ihb:active {
    transform: translateY(1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .ihb, .ihb-label, .ihb-action, .ihb-fill { transition: none; }
  }
  /* Hover is not a thing on a touch screen, so the resting state has to carry
     the meaning on its own: the dot goes and the label reads as a control. */
  @media (hover: none) {
    .ihb-fill { display: none; }
    .ihb { border-color: var(--brand-accent); color: var(--color-text); }
  }

  /* ── First-run walkthrough ──
     A native <dialog>: showModal() brings the focus trap, Escape, the inert
     background and ::backdrop with it. */
  .onb {
    width: min(30rem, calc(100vw - 2rem));
    max-height: calc(100vh - 4rem);
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: 16px;
    background: #14161b;
    color: var(--color-text);
    font-family: var(--font-family);
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.6);
  }
  .onb::backdrop {
    background: rgba(4, 5, 8, 0.72);
    backdrop-filter: blur(3px);
  }
  .onb-mark {
    display: grid;
    place-items: center;
    height: 108px;
    background:
      radial-gradient(90% 130% at 20% 0%, rgba(94, 106, 210, 0.55), transparent 62%),
      radial-gradient(70% 120% at 90% 100%, rgba(247, 225, 89, 0.18), transparent 60%),
      #0d0f13;
    border-bottom: 1px solid var(--color-border-strong);
  }
  .onb-mark span {
    font-weight: 600;
    font-size: 3rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.9);
  }
  .onb-body { padding: 20px 22px 20px; }
  .onb-title {
    margin: 0 0 8px;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .onb-text {
    margin: 0 0 22px;
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .onb-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }
  .onb-dots {
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .onb-dots li {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--brand-accent);
    opacity: 0.2;
    transition: opacity 200ms var(--ease-out-quart);
  }
  .onb-dots li.is-on { opacity: 1; }
  .onb-actions { display: flex; align-items: center; gap: 8px; }
  .onb-skip,
  .onb-next {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 38px;
    padding: 8px 16px;
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
  }
  .onb-skip {
    border: 0;
    background: transparent;
    color: var(--color-text-tertiary);
  }
  .onb-skip:hover { color: var(--color-text); }
  .onb-next {
    border: 0;
    background: var(--brand-accent);
    color: oklch(13% 0.008 250);
  }
  .onb-next:hover { filter: brightness(1.08); }
  .onb-skip:focus-visible,
  .onb-next:focus-visible {
    outline: 2px solid var(--brand-accent);
    outline-offset: 2px;
  }
  .onb-arrow {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 200ms var(--ease-out-quart);
  }
  .onb-next:hover .onb-arrow { transform: translateX(2px); }
  @media (prefers-reduced-motion: reduce) {
    .onb-dots li, .onb-arrow { transition: none; }
  }

  /* ── The in-app wordmark ──
     Cut from moving light instead of set in a red block.

     Three blobs drift across the two words at different rates over a silver
     base, all clipped to the glyphs. Unequal rates on purpose: match them and
     the mark pulses in time rather than flowing.

     This is the same technique the login headline used before it became a
     scramble, and it is here for the same reason the supplied component is
     not: that one masks a WebGL shader with an SVG <text> in a data URI, and
     a data-URI SVG cannot see a webfont. Measured against the real face, it
     falls back to a generic serif 4.1% narrower with different letterforms,
     so the wordmark would quietly stop being set in the Sprint's type. It
     also loads an image from shaders.paper.design, which this app's CSP
     blocks outright. */
  @property --mark-a { syntax: "<length>"; inherits: true; initial-value: 0px; }
  @property --mark-b { syntax: "<length>"; inherits: true; initial-value: 0px; }

  .wordmark-liquid {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 30px;
    line-height: 0.9;
    letter-spacing: -0.045em;

    color: transparent;
    background-image:
      radial-gradient(closest-side, rgba(255, 255, 255, 1), transparent 100%),
      radial-gradient(closest-side, rgba(196, 200, 210, 0.9), transparent 100%),
      linear-gradient(
        168deg,
        rgba(255, 255, 255, 0.98) 0%,
        rgba(236, 239, 244, 0.94) 38%,
        rgba(196, 201, 211, 0.88) 72%,
        rgba(166, 171, 182, 0.85) 100%
      );
    background-repeat: no-repeat;
    /* The blobs are wider than the mark so a highlight crosses it rather than
       sitting inside one word. */
    background-size: 85% 240%, 65% 200%, 100% 100%;
    background-position: var(--mark-a) 15%, var(--mark-b) 85%, 0 0;
    -webkit-background-clip: text;
    background-clip: text;

    animation:
      mark-a 11s ease-in-out infinite alternate,
      mark-b 17s ease-in-out infinite alternate;
  }
  /* Distances in em, so they scale with the mark rather than being pinned to a
     pixel count that only suits one size. */
  @keyframes mark-a {
    from { --mark-a: -1.2em; }
    to { --mark-a: 4.6em; }
  }
  @keyframes mark-b {
    from { --mark-b: 4.2em; }
    to { --mark-b: -0.8em; }
  }
  @media (prefers-reduced-motion: reduce) {
    /* Held on a frame that still has both blobs over the words, rather than at
       the 0px initial value, which parks one of them off the mark entirely. */
    .wordmark-liquid {
      animation: none;
      --mark-a: 0.8em;
      --mark-b: 2.6em;
    }
  }

  /* The report link wears the sign-in button's glass, and has to opt back into
     the things an <a> does not inherit from a <button>. */
  .wg-download {
    text-decoration: none;
    justify-self: start;
    width: auto;
    padding: 0 var(--space-xl);
  }

  /* ── Working Genius quiz ──
     The question is text on the ground; the answers are the only surfaces. It
     used to be three near-identical cards, same padding, same radius, same
     border, two pixels apart in size, thirty times in a row. */
  .wg-preamble {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-sub);
    font-family: var(--font-serif);
    font-style: italic;
  }
  .wg-ask { margin: 6px 0 4px; }
  .wg-kicker {
    display: block;
    margin-bottom: 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* Constant on every item, so it can be quiet. */
    color: var(--ink-faint, rgba(255, 255, 255, 0.38));
  }
  .wg-prompt {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.4vw, 1.75rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-wrap: balance;
  }
  /* The gap is the hierarchy. */
  .wg-options {
    display: grid;
    gap: 12px;
    margin-top: 30px;
  }

  .wg-option {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: transparent;
    text-align: left;
    cursor: pointer;
    isolation: isolate;
    transition: transform 160ms var(--ease-out-quart), filter 160ms var(--ease-out-quart);
  }
  .wg-option:disabled { cursor: progress; opacity: 0.55; }
  .wg-option:not(:disabled):hover { transform: translateY(-1px); filter: brightness(1.06); }
  .wg-option:not(:disabled):active { transform: translateY(1px); }
  /* Must be clearly visible against glass, which eats a subtle ring. */
  .wg-option:focus-visible {
    outline: 2px solid var(--brand-accent);
    outline-offset: 3px;
  }

  /* The refracting pane. Tinted, because refracting a near-black ground
     returns near-black: the tint is what makes it read as glass at all, and
     the bevel below does nearly all the rest of the visible work. */
  .wg-option-pane {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.055);
    backdrop-filter: url("#wg-glass");
    -webkit-backdrop-filter: url("#wg-glass");
  }
  .wg-option-bevel {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
    box-shadow:
      0 0 8px rgba(0, 0, 0, 0.03),
      0 2px 6px rgba(0, 0, 0, 0.08),
      inset 3px 3px 0.5px -3.5px rgba(255, 255, 255, 0.09),
      inset -3px -3px 0.5px -3.5px rgba(255, 255, 255, 0.85),
      inset 1px 1px 1px -0.5px rgba(255, 255, 255, 0.6),
      inset -1px -1px 1px -0.5px rgba(255, 255, 255, 0.6),
      inset 0 0 6px 6px rgba(255, 255, 255, 0.12),
      inset 0 0 2px 2px rgba(255, 255, 255, 0.06),
      0 0 12px rgba(0, 0, 0, 0.15);
  }
  /* Raised above the pane. Underneath it the text is refracted along with the
     background and becomes unreadable, which this codebase has done once
     already. */
  .wg-option-body {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    gap: 13px;
    /* Options size to their content: forcing equal heights on uneven text
       reads as a formatting bug. */
    padding: 15px 17px;
  }
  .wg-option-label {
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-text);
  }
  /* A small glass token, so the two answers are told apart at a glance and
     have something to name in a keyboard shortcut. */
  .wg-option-key {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow:
      inset 1px 1px 1px -0.5px rgba(255, 255, 255, 0.55),
      inset -1px -1px 1px -0.5px rgba(255, 255, 255, 0.45);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--ink-sub);
  }

  /* Selected. Brighten the pane and ring it: border colour alone was the weak
     tell the old version relied on. */
  .wg-option.is-picked .wg-option-pane { background: rgba(255, 255, 255, 0.13); }
  .wg-option.is-picked .wg-option-bevel { box-shadow: 0 0 0 2px var(--brand-accent), 0 0 18px rgba(94, 106, 210, 0.28); }
  .wg-option.is-picked .wg-option-key { color: var(--color-text); }

  .wg-option--hatch .wg-option-label { color: var(--ink-sub); font-weight: 500; }
  .wg-option--hatch.is-open .wg-option-bevel { box-shadow: 0 0 0 1.5px rgba(255, 255, 255, 0.3); }

  /*
   * The writing surface: recessed, not raised.
   *
   * Same material as the options and the opposite affordance. A pane reads as
   * something to click; an inset reads as somewhere to type.
   */
  .wg-write {
    margin-top: 14px;
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.3);
    box-shadow:
      inset 0 2px 6px rgba(0, 0, 0, 0.6),
      inset 0 -1px 0 rgba(255, 255, 255, 0.05);
  }
  .wg-write-label {
    display: block;
    margin-bottom: 7px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint, rgba(255, 255, 255, 0.38));
  }
  .wg-write-box {
    display: block;
    width: 100%;
    /* One line that grows. A large empty textarea reads as homework and gets
       skipped, which is how you end up with the word "both". */
    min-height: 1.6em;
    max-height: 180px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-family: inherit;
    font-size: 15px;
    line-height: 1.55;
    resize: none;
    outline: none;
    overflow-y: auto;
  }
  .wg-write-box::placeholder { color: rgba(255, 255, 255, 0.26); }
  .wg-write-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 12px;
  }
  .wg-write-cancel {
    border: 0;
    background: transparent;
    color: var(--ink-faint, rgba(255, 255, 255, 0.4));
    font-family: inherit;
    font-size: 12.5px;
    cursor: pointer;
    padding: 6px 4px;
  }
  .wg-write-cancel:hover { color: var(--color-text); }
  /* Size only. The material is .btn-metal, which this carries alongside; it
     was a solid accent fill, and a red confirm on a routine Next read as a
     warning. */
  .wg-write-send {
    min-height: 34px;
    padding: 7px 18px;
    font-size: 13px;
    font-weight: 800;
  }
  .wg-write-cancel:focus-visible,
  .wg-write-send:focus-visible,
  .wg-write-box:focus-visible {
    outline: 2px solid var(--brand-accent);
    outline-offset: 2px;
  }

  /* Present for its <defs>, never painted. */
  .glass-filter {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  /* ── Working Genius quiz ── */
  .wg-quiz-option {
    position: relative;
  }
  .wg-quiz-option::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    opacity: 0;
    transition: opacity 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    pointer-events: none;
  }
  .wg-quiz-option:hover::after,
  .wg-quiz-option:focus-visible::after {
    opacity: 1;
    box-shadow: 0 0 0 2px rgba(94, 106, 210, 0.25), 0 12px 24px rgba(0, 0, 0, 0.24);
    transform: translateY(-1px);
  }
  .wg-quiz-option:active {
    transform: translateY(1px);
  }

  /* ── App View ── */
  .app-view {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out-quart) 0.3s;
    pointer-events: none;
  }
  .app-view--visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Triangle Header ── */
  .triangle-header {
    position: relative;
    flex-shrink: 0;
    height: clamp(8rem, 22vh, 14rem);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .triangle-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 110%;
    fill: rgba(94, 106, 210, 0.06);
    stroke: rgba(94, 106, 210, 0.12);
    stroke-width: 0.5;
  }
  .triangle-cube-wrap {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: clamp(5rem, 12vw, 8rem);
    height: clamp(5rem, 12vw, 8rem);
    transition: transform var(--duration-normal) var(--ease-out-quart);
    cursor: pointer;
  }
  .triangle-cube-wrap:hover {
    transform: scale(1.08);
  }
  .triangle-cube-wrap:active {
    transform: scale(0.95);
  }

  /* ── Tip Popover ── */
  .tip-popover {
    position: absolute;
    top: clamp(7rem, 19vh, 12rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    background: var(--color-surface-popover);
    border: 1px solid var(--color-border-strong);
    border-radius: 12px;
    padding: var(--space-md) var(--space-xl);
    max-width: min(28rem, 85vw);
    backdrop-filter: blur(12px);
    animation: tip-in var(--duration-fast) var(--ease-out-quart);
  }
  .tip-arrow {
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 12px;
    height: 12px;
    background: var(--color-surface-popover);
    border-left: 1px solid var(--color-border-strong);
    border-top: 1px solid var(--color-border-strong);
  }
  .tip-text {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  @keyframes tip-in {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  /* ── Tab Content ── */
  .tab-content {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-lg) var(--space-xl) var(--space-sm);
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }
  .tab-content::-webkit-scrollbar {
    width: 4px;
  }
  .tab-content::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 4px;
  }

  /* ── Tab Bar ── */
  .tab-bar {
    flex-shrink: 0;
    display: flex;
    border-top: 1px solid var(--color-border);
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(12px);
    padding: var(--space-xs) var(--space-sm);
    padding-bottom: max(var(--space-xs), env(safe-area-inset-bottom, var(--space-xs)));
  }
  .tab-btn {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: var(--space-sm) var(--space-md);
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-dim);
    font-family: var(--font-family);
    font-size: var(--text-xs);
    font-weight: 500;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out-quart),
      background var(--duration-fast) var(--ease-out-quart);
    -webkit-tap-highlight-color: transparent;
    min-height: 44px;
  }
  .tab-btn:hover {
    color: var(--color-text-tertiary);
    background: var(--color-surface-hover);
  }
  .tab-btn--active {
    color: var(--color-accent);
  }
  .tab-icon {
    width: 1.4rem;
    height: 1.4rem;
  }

  /* ── Chat Tab ── */
  .chat-tab {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }
  .chat-messages::-webkit-scrollbar {
    width: 4px;
  }
  .chat-messages::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 4px;
  }

  .message {
    display: flex;
  }
  .message--buddy {
    justify-content: flex-start;
  }
  .message--user {
    justify-content: flex-end;
  }

  .message-bubble {
    max-width: min(85%, 32rem);
    padding: var(--space-md) var(--space-lg);
    border-radius: 14px;
    font-size: var(--text-base);
    line-height: 1.55;
    word-wrap: break-word;
  }
  .message--buddy .message-bubble {
    background: var(--color-surface-hover);
    border: 1px solid var(--color-border);
    border-bottom-left-radius: 4px;
    color: var(--color-text-secondary);
  }
  .message--user .message-bubble {
    background: var(--color-accent-subtle);
    border: 1px solid var(--color-accent-border);
    border-bottom-right-radius: 4px;
    color: var(--color-text);
  }

  .suggestions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }
  .suggestions-label {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .suggestions-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .suggestion-chip {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border-strong);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-secondary);
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out-quart);
    -webkit-tap-highlight-color: transparent;
    min-height: 44px;
  }
  .suggestion-chip:hover {
    background: var(--color-accent-subtle);
    border-color: var(--color-accent-border);
    color: var(--color-text);
  }

  .chat-input-bar {
    display: flex;
    gap: var(--space-sm);
    padding: var(--space-md) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .chat-input {
    flex: 1;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--color-border-strong);
    border-radius: 10px;
    background: var(--color-surface-hover);
    color: var(--color-text);
    font-family: var(--font-family);
    font-size: var(--text-base);
    outline: none;
    transition: border-color var(--duration-fast) var(--ease-out-quart);
    min-height: 44px;
  }
  .chat-input:focus {
    border-color: var(--color-accent);
  }
  .chat-input::placeholder {
    color: var(--color-text-dim);
  }
  .chat-send-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: none;
    border-radius: 10px;
    background: var(--color-accent-subtle);
    color: var(--color-text-tertiary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out-quart);
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }
  .chat-send-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .chat-send-btn:not(:disabled):hover {
    background: rgba(94, 106, 210, 0.35);
    color: var(--color-text);
  }

  /* ── Check-ins Tab ── */
  .checkins-tab {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .checkins-subtitle {
    margin: 0;
    font-size: var(--text-xl);
    color: var(--color-text-tertiary);
    font-weight: 400;
    line-height: 1.5;
  }

  .insight-feed {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .insight-card {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-lg);
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-card);
    transition: border-color var(--duration-fast) var(--ease-out-quart);
  }
  .insight-card:hover {
    border-color: var(--color-border-strong);
  }
  /* Accent dot marker instead of colored left border */
  .insight-card--pattern::before,
  .insight-card--reflection::before,
  .insight-card--alert::before {
    content: "";
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-top: 0.3rem;
  }
  .insight-card--pattern::before {
    background: var(--color-accent);
  }
  .insight-card--reflection::before {
    background: var(--color-warmth);
  }
  .insight-card--alert::before {
    background: var(--color-energy);
  }

  .insight-icon {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--color-text-tertiary);
  }
  .insight-content {
    flex: 1;
    min-width: 0;
  }
  .insight-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: 0.35rem;
  }
  .insight-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .insight-date {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .insight-body {
    margin: 0;
    font-size: var(--text-xl);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .checkins-empty {
    text-align: center;
    padding: var(--space-2xl) var(--space-lg);
  }
  .checkins-empty-text {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-dim);
    font-style: italic;
  }

  /* ── Insights Tab ── */
  .insights-tab {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    padding-bottom: var(--space-lg);
  }
  .insights-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .insights-section-title {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .insights-card--action {
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out-quart);
  }
  .insights-card--action:hover {
    border-color: var(--color-accent-border);
  }
  .insights-card-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: var(--space-sm);
    color: var(--color-accent);
  }
  .insights-card-body h3 {
    margin: 0 0 0.35rem;
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-secondary);
  }
  .insights-card-body p {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-xl);
    line-height: 1.55;
    color: var(--color-text-tertiary);
  }
  .insights-card-body p:last-child {
    margin-bottom: 0;
  }

  .insights-action-btn {
    margin-top: var(--space-xs);
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--color-accent-border);
    border-radius: 8px;
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    font-family: var(--font-family);
    font-size: var(--text-xl);
    font-weight: 600;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out-quart);
    -webkit-tap-highlight-color: transparent;
    min-height: 44px;
  }
  .insights-action-btn:hover {
    background: rgba(94, 106, 210, 0.2);
  }

  .privacy-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-lg);
  }
  .privacy-row h3 {
    margin: 0 0 0.25rem;
  }
  .privacy-desc {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-tertiary);
    max-width: 20rem;
  }

  .toggle {
    position: relative;
    display: inline-block;
    width: 2.4rem;
    height: 1.4rem;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .toggle input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .toggle-slider {
    position: absolute;
    inset: 0;
    background: var(--color-border);
    border-radius: 1.4rem;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out-quart);
  }
  .toggle-slider::before {
    content: "";
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 1.1rem;
    height: 1.1rem;
    background: var(--color-text-muted);
    border-radius: 50%;
    transition: transform var(--duration-fast) var(--ease-out-quart),
      background var(--duration-fast) var(--ease-out-quart);
  }
  .toggle input:checked + .toggle-slider {
    background: rgba(94, 106, 210, 0.5);
  }
  .toggle input:checked + .toggle-slider::before {
    transform: translateX(1rem);
    background: var(--color-accent);
  }

  .insights-card--about p {
    margin: 0 0 var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }
  .insights-card--about p:last-child {
    margin-bottom: 0;
  }
  .insights-card--about strong {
    color: var(--color-text-secondary);
  }

  /* ── Reduced Motion ── */
  @media (prefers-reduced-motion: reduce) {
    .landing-overlay,
    .landing-halo,
    .landing-cube-wrap,
    .landing-title,
    .landing-hint,
    .app-view,
    .tip-popover,
    .persistent-buddy,
    .cube,
    .wg-quiz-option,
    .wg-quiz-option::after,
    /* Every new animated class on the assessment. The .wg-quiz-option entries
       above are the precedent; these are its replacements. */
    .wg-option,
    .wg-option-pane,
    .wg-option-bevel,
    .wg-write,
    .wg-write-box {
      transition: none !important;
      animation: none !important;
    }
    /* The lift on hover is a transform, so switching transitions off leaves it
       still jumping. Park it. */
    .wg-option:not(:disabled):hover,
    .wg-option:not(:disabled):active {
      transform: none !important;
      filter: none !important;
    }
    /* The cube's rotation is a JS-driven transform, so it needs parking
       explicitly rather than just having its animation switched off. */
    .cube--hero .cube,
    .cube--compact .cube {
      transform: rotateX(0) rotateY(0) !important;
    }
  }

  /* ── Touch devices ── */
  @media (pointer: coarse) {
    .landing-hint {
      display: block;
    }
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .login-screen {
      align-items: stretch;
      padding-top: clamp(2rem, 8vh, 4rem);
    }
    .login-hero {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .login-mascot-panel {
      min-height: clamp(18rem, 46vh, 25rem);
    }
    .login-mascot {
      width: clamp(16rem, 78vw, 24rem);
      height: clamp(16rem, 78vw, 24rem);
      transform: none;
    }
    .persistent-buddy--login {
