---
import App from "../components/App";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Sprint Buddy</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;0,8..60,900;1,8..60,400;1,8..60,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <App client:only="react" />
  </body>
</html>

<style is:global>
  /* ═══════════════════════════════════════
     DESIGN TOKENS
     ═══════════════════════════════════════ */
  :root {
    /* ── Brand: Aalto, full saturation, never softened ── */
    --brand-yellow: #f7e159;
    --brand-red: #fd6360;
    --brand-blue: #46a5ff;

    /* ── Surfaces (OKLCH, tinted toward Aalto Blue at low chroma) ── */
    --surface-bg: oklch(11% 0.008 250);
    --surface-card: oklch(15% 0.008 250);
    --surface-card-2: oklch(17% 0.008 250);
    --surface-sidebar: oklch(9% 0.008 250);

    /* ── Ink (text on dark surface) ── */
    --ink: oklch(94% 0.004 250);
    --ink-sub: oklch(74% 0.008 250);
    --ink-faint: oklch(60% 0.008 250);

    /* ── Lines ── */
    --line: oklch(28% 0.008 250 / 22%);
    --line-strong: oklch(35% 0.008 250 / 40%);
    --line-visible: oklch(50% 0.008 250 / 50%);

    /* ── User bubble tint (full-saturation blue at low alpha) ── */
    --bubble-user: rgba(70, 165, 255, 0.14);

    /* ── Legacy aliases (existing CSS reads these; do not remove) ── */
    --color-accent: var(--brand-blue);
    --color-accent-subtle: rgba(70, 165, 255, 0.14);
    --color-accent-border: rgba(70, 165, 255, 0.3);
    --color-energy: var(--brand-red);
    --color-warmth: var(--brand-yellow);
    --color-bg: var(--surface-bg);
    --color-bg-elevated: var(--surface-card);
    --color-text: var(--ink);
    --color-text-secondary: var(--ink-sub);
    --color-text-tertiary: var(--ink-faint);
    --color-text-muted: oklch(50% 0.008 250);
    --color-text-dim: oklch(42% 0.008 250);
    --color-border: var(--line);
    --color-border-strong: var(--line-strong);
    --color-border-visible: var(--line-visible);
    --color-surface-card: var(--surface-card);
    --color-surface-hover: var(--surface-card-2);
    --color-surface-popover: oklch(15% 0.008 250 / 95%);
    --color-cube-face: oklch(8% 0.008 250);

    /* ── Spacing (4pt scale) ── */
    --space-2xs: 0.25rem;
    --space-xs: 0.5rem;
    --space-sm: 0.75rem;
    --space-md: 1rem;
    --space-lg: 1.25rem;
    --space-xl: 1.5rem;
    --space-2xl: 2rem;
    --space-3xl: 3rem;
    --space-4xl: 4rem;

    /* ── Radius ── */
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;

    /* ── Typography: three faces, three roles ── */
    --font-family: Inter, ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-serif: "Source Serif 4", ui-serif, Georgia, "Times New Roman", serif;
    --font-display: "Source Serif 4", ui-serif, Georgia, "Times New Roman", serif;

    --text-xs: 0.75rem;
    --text-sm: 0.875rem;
    --text-base: 1rem;
    --text-lg: 1.0625rem;
    --text-xl: 1.125rem;
    --text-h3: 1.375rem;
    --text-h2: 1.75rem;
    --text-h1: 2.5rem;
    --text-display: clamp(3rem, 7vw, 5.5rem);
    --text-heading: var(--text-display);

    /* ── Motion ── */
    --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
    --duration-instant: 80ms;
    --duration-fast: 200ms;
    --duration-normal: 300ms;
    --duration-slow: 500ms;
    --duration-landing: 600ms;
    --duration-transition: 700ms;
  }

  /* ── Reset & Base ── */
  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--color-bg);
  }
  body {
    min-height: 100vh;
    overflow: hidden;
    font-family: var(--font-family);
    color: var(--color-text);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* ── Focus visible (applied globally) ── */
  :focus {
    outline: none;
  }
  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── Login ── */
  .login-screen {
    min-height: 100vh;
    display: flex;
    align-items: stretch;
    padding: clamp(0.6rem, 2.3vw, 2rem);
    background:
      linear-gradient(90deg, rgba(70, 165, 255, 0.1), transparent 48%),
      radial-gradient(circle at 24% 48%, rgba(255, 255, 255, 0.13), transparent 18rem),
      var(--color-bg);
  }
  .login-hero {
    width: min(100%, 90rem);
    margin: auto;
    display: grid;
    grid-template-columns: minmax(20rem, 1.35fr) minmax(22rem, 0.9fr);
    align-items: center;
    gap: clamp(1.6rem, 5.4vw, 6rem);
  }
  .login-mascot-panel {
    position: relative;
    min-height: clamp(30rem, 78vh, 58rem);
    display: grid;
    place-items: center;
    perspective: 1400px;
  }
  .login-halo {
    position: absolute;
    width: clamp(30rem, 66vw, 58rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.68) 0 5%, rgba(255, 255, 255, 0.28) 18%, rgba(60, 120, 255, 0.2) 38%, transparent 70%),
      radial-gradient(circle at 38% 62%, rgba(247, 225, 89, 0.22), transparent 36%),
      radial-gradient(circle at 70% 38%, rgba(253, 99, 96, 0.18), transparent 35%);
    filter: blur(24px);
    opacity: 0.86;
  }
  .login-panel {
    width: min(100%, 27rem);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-lg);
  }
  .login-mascot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: clamp(24rem, 56vw, 48rem);
    height: clamp(24rem, 56vw, 48rem);
    transform: translateX(-4%);
  }
  .login-mascot-anchor {
    pointer-events: none;
  }
  .persistent-buddy {
    position: fixed;
    z-index: 40;
    --buddy-size: clamp(3rem, 6vw, 5rem);
    width: var(--buddy-size);
    height: var(--buddy-size);
    display: grid;
    place-items: center;
    pointer-events: none;
    transform-origin: center;
    transition:
      top 820ms var(--ease-out-expo),
      left 820ms var(--ease-out-expo),
      transform 820ms var(--ease-out-expo),
      filter 820ms var(--ease-out-expo);
    filter: drop-shadow(0 0.8rem 1.6rem rgba(0, 0, 0, 0.26));
  }
  .persistent-buddy::before {
    content: "";
    position: absolute;
    inset: -88%;
    z-index: -1;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.42) 0 8%, rgba(70, 165, 255, 0.25) 24%, rgba(247, 225, 89, 0.15) 48%, transparent 72%),
      radial-gradient(circle at 72% 28%, rgba(253, 99, 96, 0.18), transparent 42%);
    filter: blur(14px);
    opacity: 0;
    transform: scale(0.72);
    transition:
      opacity 520ms var(--ease-out-quart),
      transform 820ms var(--ease-out-expo);
  }
  .persistent-buddy--login {
    --buddy-size: clamp(16rem, 32vw, 30rem);
    top: 50%;
    left: clamp(10rem, 28vw, 28rem);
    transform: translate(-50%, -50%) scale(1);
    filter: drop-shadow(0 2rem 5rem rgba(0, 0, 0, 0.42));
  }
  .persistent-buddy--login::before {
    display: none;
  }
  .persistent-buddy--docked {
    top: calc(clamp(0.9rem, 2.2vw, 1.35rem) + var(--buddy-size) / 2);
    left: calc(100vw - clamp(0.9rem, 2vw, 1.35rem) - var(--buddy-size) / 2);
    transform: translate(-50%, -50%) scale(1);
    pointer-events: auto;
  }
  .persistent-buddy--docked::before {
    opacity: 0.72;
    transform: scale(1);
  }
  .persistent-buddy--docked .cube {
    cursor: pointer;
  }
  .buddy-tip {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    width: min(18rem, calc(100vw - 2rem));
    padding: 0.72rem 0.82rem 0.78rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 8px;
    background: rgba(14, 15, 18, 0.92);
    color: var(--color-text-secondary);
    box-shadow: 0 0.9rem 2rem rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(12px);
    pointer-events: none;
    animation: buddy-tip-in var(--duration-fast) var(--ease-out-quart);
  }
  .buddy-tip-arrow {
    position: absolute;
    top: -6px;
    right: 1.8rem;
    width: 10px;
    height: 10px;
    border-left: 1px solid var(--color-border-strong);
    border-top: 1px solid var(--color-border-strong);
    background: rgba(14, 15, 18, 0.92);
    transform: rotate(45deg);
  }
  .buddy-tip p {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.42;
    letter-spacing: 0;
  }
  @keyframes buddy-tip-in {
    from {
      opacity: 0;
      transform: translateY(-0.35rem) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .login-kicker,
  .organizer-kicker {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .login-title {
    margin: 0;
    color: var(--ink);
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    line-height: 0.96;
    font-weight: 900;
    text-align: left;
    letter-spacing: -0.035em;
    font-variation-settings: "opsz" 50;
  }
  .login-title-line {
    display: inline-block;
    text-wrap: balance;
  }
  .login-title-line--buddy {
    font-size: 1.18em;
    line-height: 0.94;
    letter-spacing: -0.04em;
  }
  .login-title-line--os {
    color: var(--brand-blue);
  }
  .login-title-divider {
    display: inline-block;
    margin: 0 0.14rem;
    color: var(--ink-faint);
    font-family: var(--font-family);
    font-size: 0.55em;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.02em;
    transform: translateY(-0.18em);
    font-variation-settings: normal;
  }
  .login-submit,
  .organizer-logout {
    min-height: 44px;
    border: 0;
    font-family: var(--font-family);
    font-weight: 700;
    cursor: pointer;
  }
  .login-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-xs);
  }
  .login-meta {
    display: flex;
    justify-content: flex-end;
  }
  .login-forgot {
    border: 0;
    padding: 0;
    background: transparent;
    color: rgba(126, 192, 255, 0.74);
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .login-forgot:hover {
    color: rgba(126, 192, 255, 0.9);
  }
  .login-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .login-field input {
    min-height: 48px;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    background: rgba(8, 10, 18, 0.66);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  .login-field input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(70, 165, 255, 0.3);
  }
  .login-error {
    margin: 0;
    color: var(--color-energy);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  .login-submit {
    border-radius: 10px;
    background: var(--brand-blue);
    color: oklch(13% 0.008 250);
    font-weight: 900;
    font-size: 1rem;
    letter-spacing: 0.005em;
    box-shadow: 0 6px 18px rgba(70, 165, 255, 0.18);
  }
  .login-submit:hover {
    filter: brightness(1.06);
  }
  .login-submit:active {
    transform: translateY(1px);
  }
  .login-blurb {
    max-width: 26rem;
    margin: 0.3rem 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--ink-sub);
    font-variation-settings: "opsz" 22;
  }

  /* ── Organizer Preview ── */
  .organizer-dashboard {
    min-height: 100vh;
    padding: clamp(1.25rem, 4vw, 3rem);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .organizer-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-bottom: var(--space-3xl);
  }
  .organizer-header h1 {
    margin: 0.35rem 0 0;
    font-size: clamp(2rem, 7vw, 4.5rem);
    line-height: 0.95;
  }
  .organizer-logout {
    padding: 0 var(--space-lg);
    border-radius: 8px;
    background: var(--color-surface-hover);
    color: var(--color-text-secondary);
  }
  .organizer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }
  .organizer-metric,
  .organizer-feed {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface-card);
  }
  .organizer-metric {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
  }
  .organizer-metric span {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .organizer-metric strong {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
  }
  .organizer-metric--attention strong {
    color: var(--color-warmth);
  }
  .organizer-feed {
    max-width: 44rem;
    padding: var(--space-xl);
  }
  .organizer-feed h2 {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-lg);
  }
  .organizer-feed p {
    margin: 0;
    color: var(--color-text-tertiary);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  /* ── Screen-reader only ── */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── App Root ── */
  .app-root {
    position: relative;
    min-height: 100vh;
    background: var(--color-bg);
    overflow: hidden;
    padding-top: env(safe-area-inset-top);
  }

  /* ── Landing Overlay ── */
  .landing-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    align-content: center;
    gap: clamp(2.25rem, 5vh, 3.75rem);
    padding: 2rem;
    background: var(--color-bg);
    cursor: pointer;
    transition: opacity var(--duration-landing) var(--ease-out-quart),
      transform var(--duration-landing) var(--ease-out-quart);
  }
  .phase-transitioning .landing-overlay {
    opacity: 0;
    transform: scale(1.05);
    pointer-events: none;
  }
  .phase-app .landing-overlay {
    display: none;
  }

  .landing-overlay::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 47%, rgba(255, 255, 255, 0.11), transparent 18rem),
      radial-gradient(circle at 50% 55%, rgba(70, 165, 255, 0.1), transparent 26rem);
    mix-blend-mode: screen;
  }

  .landing-halo {
    position: absolute;
    top: clamp(2rem, 8vh, 5rem);
    width: clamp(18rem, 44vw, 38rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.8) 0 6%, rgba(255, 255, 255, 0.44) 17%, rgba(255, 255, 255, 0.13) 35%, transparent 67%),
      radial-gradient(circle at 35% 62%, rgba(247, 225, 89, 0.24), transparent 35%),
      radial-gradient(circle at 70% 40%, rgba(253, 99, 96, 0.2), transparent 34%);
    filter: blur(18px);
    opacity: 0.92;
    transform: translateY(-8%);
    z-index: -1;
    transition: opacity var(--duration-landing) var(--ease-out-quart),
      transform var(--duration-landing) var(--ease-out-quart);
  }
  .phase-transitioning .landing-halo {
    opacity: 0;
    transform: translateY(-8%) scale(0.6);
  }

  .landing-cube-wrap {
    width: clamp(15rem, 34vw, 30rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    perspective: 1100px;
    transition: transform var(--duration-transition) var(--ease-out-quart),
      opacity var(--duration-landing) var(--ease-out-quart);
  }
  .phase-transitioning .landing-cube-wrap {
    transform: translateY(-12vh) scale(0.25);
    opacity: 0;
  }

  .landing-title {
    margin: 0;
    font-size: var(--text-heading);
    line-height: 0.88;
    font-weight: 900;
    letter-spacing: 0;
    color: #f6f6f6;
    text-align: center;
    text-shadow:
      0 0 1.2rem rgba(255, 255, 255, 0.18),
      0 0 3.5rem rgba(70, 165, 255, 0.16);
    transition: opacity var(--duration-normal) var(--ease-out-quart),
      transform var(--duration-normal) var(--ease-out-quart);
  }
  .phase-transitioning .landing-title {
    opacity: 0;
    transform: translateY(-20px);
  }

  .landing-hint {
    position: fixed;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    animation: pulse-hint 2.4s ease-in-out infinite;
  }
  .phase-transitioning .landing-hint {
    opacity: 0;
  }

  @keyframes pulse-hint {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 0.7;
    }
  }

  /* ── Cube Styles (shared hero + compact) ── */
  .cube {
    position: relative;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .cube--hero {
    width: var(--size);
    height: var(--size);
  }
  .cube--compact {
    width: var(--size);
    height: var(--size);
  }

  .face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.01) 34%, rgba(0, 0, 0, 0.98) 68%),
      var(--color-cube-face);
    border: 1px solid var(--color-border-visible);
    box-shadow:
      inset 0 0 4rem rgba(255, 255, 255, 0.04),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 1.8rem rgba(255, 255, 255, 0.14);
    backface-visibility: hidden;
  }
  .front {
    transform: translateZ(var(--half));
  }
  .back {
    transform: rotateY(180deg) translateZ(var(--half));
  }
  .right {
    transform: rotateY(90deg) translateZ(var(--half));
  }
  .left {
    transform: rotateY(-90deg) translateZ(var(--half));
  }
  .top {
    transform: rotateX(90deg) translateZ(var(--half));
  }
  .bottom {
    transform: rotateX(-90deg) translateZ(var(--half));
  }

  .eyes {
    display: flex;
    gap: calc(var(--size) * 0.17);
    transform: translateY(calc(var(--size) * -0.03));
  }
  .eye {
    position: relative;
    width: calc(var(--size) * 0.12);
    height: calc(var(--size) * 0.25);
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.56);
    border-radius: 2px;
    background: #000;
    box-shadow:
      0 0 1.3rem rgba(255, 255, 255, 0.12),
