      // ---- Knowledge base ------------------------------------------------

      const kbId = document.getElementById("kb-id");
      const kbTopic = document.getElementById("kb-topic");
      const kbBody = document.getElementById("kb-body");
      const kbPosition = document.getElementById("kb-position");
      const kbSource = document.getElementById("kb-source");
      const kbMessage = document.getElementById("kb-message");
      const kbSize = document.getElementById("kb-size");
      const knowledgeList = document.getElementById("knowledge-list");

      let knowledgeEntries = [];

      function kbClear() {
        kbId.value = "";
        kbTopic.value = "";
        kbBody.value = "";
        kbSource.value = "";
        const highest = knowledgeEntries.reduce((m, e) => Math.max(m, e.position), 0);
        kbPosition.value = String(highest + 10);
      }

      // A transcript import lands dozens of entries under one source, so the
      // way out has to be as cheap as the way in.
      function sourceChips() {
        const counts = new Map();
        for (const e of knowledgeEntries) {
          if (e.status === "archived" || !e.source) continue;
          counts.set(e.source, (counts.get(e.source) || 0) + 1);
        }
        if (counts.size === 0) return "";
        return (
          '<div class="row" style="gap:8px;margin-bottom:12px">' +
          [...counts.entries()]
            .map(([source, n]) =>
              '<span style="display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);border-radius:999px;padding:3px 6px 3px 10px;font-size:0.8125rem">' +
              esc(source) + ' <span class="note" style="margin:0">' + n + "</span>" +
              '<button type="button" class="disclose" data-archive-source="' + esc(source) + '">Archive all</button>' +
              "</span>")
            .join("") +
          "</div>"
        );
      }

      let kbFilter = "";
      const kbOpen = new Set();

      function renderKnowledge() {
        if (!knowledgeEntries.length) {
          knowledgeList.innerHTML = '<p class="note">Nothing yet. Add one below, or paste a session under <strong>Add transcript</strong>.</p>';
          return;
        }

        const needle = kbFilter.trim().toLowerCase();
        const shown = needle
          ? knowledgeEntries.filter((e) =>
              (e.topic + " " + e.body + " " + (e.source || "")).toLowerCase().includes(needle))
          : knowledgeEntries;

        const rows = shown
          .map((e) => {
            const archived = e.status === "archived";
            const open = kbOpen.has(e.id);
            return (
              '<div class="rowline" style="opacity:' + (archived ? "0.5" : "1") + '">' +
              '<strong style="min-width:38px;font-size:0.8125rem">' + e.position + "</strong>" +
              '<span class="grow"><strong>' + esc(e.topic || "(no topic)") + "</strong>" +
              (e.source ? ' <span class="note" style="margin:0">· ' + esc(e.source) + "</span>" : "") +
              (archived ? ' <span class="note" style="margin:0">· archived</span>' : "") +
              "</span>" +
              '<button type="button" class="disclose" data-open="' + e.id + '">' + (open ? "Hide" : "Show") + "</button>" +
              '<button type="button" data-edit="' + e.id + '">Edit</button>' +
              '<button type="button" data-toggle="' + e.id + '">' + (archived ? "Restore" : "Archive") + "</button>" +
              '<button type="button" data-delete="' + e.id + '" title="Remove permanently">Delete</button>' +
              "</div>" +
              (open ? '<p class="note expanded" style="margin:0">' + esc(e.body) + "</p>" : "")
            );
          })
          .join("");

        const count = needle
          ? shown.length + " of " + knowledgeEntries.length + " entries"
          : knowledgeEntries.length + " entries";

        knowledgeList.innerHTML =
          sourceChips() +
          '<div class="row" style="gap:10px;align-items:center;margin-bottom:10px">' +
          '<input id="kb-filter" placeholder="Filter by topic, text or source" style="flex:1" value="' + esc(kbFilter) + '" />' +
          '<span class="note" style="margin:0">' + count + "</span>" +
          "</div>" +
          (shown.length ? '<div class="scroller">' + rows + "</div>" : '<p class="note">Nothing matches that.</p>');

        const filterBox = document.getElementById("kb-filter");
        filterBox.addEventListener("input", () => {
          kbFilter = filterBox.value;
          const at = filterBox.selectionStart;
          renderKnowledge();
          // Re-rendering replaces the input, so put the caret back.
          const again = document.getElementById("kb-filter");
          again.focus();
          again.setSelectionRange(at, at);
        });

        knowledgeList.querySelectorAll("button[data-open]").forEach((b) => {
          b.addEventListener("click", () => {
            const id = b.dataset.open;
            if (kbOpen.has(id)) kbOpen.delete(id);
            else kbOpen.add(id);
            renderKnowledge();
          });
        });

        knowledgeList.querySelectorAll("button[data-archive-source]").forEach((b) => {
          b.addEventListener("click", async () => {
            const source = b.dataset.archiveSource;
            // A two-step rather than a confirm() dialog: a modal blocks the
            // page, and this is reversible anyway.
            if (b.dataset.armed !== "yes") {
              b.dataset.armed = "yes";
              b.textContent = "Sure?";
              setTimeout(() => {
                if (!b.isConnected) return;
                b.dataset.armed = "";
                b.textContent = "Archive all";
              }, 4000);
              return;
            }
            const { ok, data } = await knowledgeApi({ action: "archiveSource", source });
            if (!ok) return;
            say(kbMessage, "Archived " + data.archived + " from " + source + ".", false);
            loadKnowledge();
      loadShared();
          });
        });

        knowledgeList.querySelectorAll("button[data-delete]").forEach((b) => {
          b.addEventListener("click", async () => {
            const entry = knowledgeEntries.find((e) => e.id === b.dataset.delete);
            if (!entry) return;
            // Two-step rather than confirm(): a modal blocks the page, and this
            // matches how Archive all already asks. Unlike archiving, there is
            // no way back from this one, so the armed label says so.
            if (b.dataset.armed !== "yes") {
              b.dataset.armed = "yes";
              b.textContent = "Delete for good?";
              setTimeout(() => {
                if (!b.isConnected) return;
                b.dataset.armed = "";
                b.textContent = "Delete";
              }, 4000);
              return;
            }
            const { ok } = await knowledgeApi({ action: "delete", id: entry.id });
            if (!ok) return;
            kbOpen.delete(entry.id);
            // Clear the edit form if it was holding the row that just went.
            if (kbId.value === entry.id) kbClear();
            say(kbMessage, "Deleted " + (entry.topic || "that entry") + ". That one is gone for good.", false);
            loadKnowledge();
      loadShared();
          });
        });

        knowledgeList.querySelectorAll("button[data-edit]").forEach((b) => {
          b.addEventListener("click", () => {
            const entry = knowledgeEntries.find((e) => e.id === b.dataset.edit);
            if (!entry) return;
            kbId.value = entry.id;
            kbTopic.value = entry.topic;
            kbBody.value = entry.body;
            kbPosition.value = String(entry.position);
            kbSource.value = entry.source || "";
            kbTopic.focus();
          });
        });

        knowledgeList.querySelectorAll("button[data-toggle]").forEach((b) => {
          b.addEventListener("click", async () => {
            const entry = knowledgeEntries.find((e) => e.id === b.dataset.toggle);
            if (!entry) return;
            await knowledgeApi({ action: entry.status === "archived" ? "restore" : "archive", id: entry.id });
            loadKnowledge();
      loadShared();
          });
        });
      }

      async function knowledgeApi(body) {
        let res;
        try {
          res = await fetch("/api/knowledge", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
        } catch {
          say(kbMessage, "Could not reach the server.", true);
          return { ok: false, data: {} };
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) say(kbMessage, data.error || "That did not work.", true);
        return { ok: res.ok, data };
      }

      async function loadKnowledge() {
        let res;
        try {
          res = await fetch("/api/knowledge");
        } catch {
          return;
        }
        if (!res.ok) return;
        const data = await res.json();
        knowledgeEntries = data.entries || [];
        const size = data.size || {};
        const pct = Math.round((size.chars / size.budgetChars) * 100);
        kbSize.textContent =
          "Active pack: ~" + (size.approxTokens || 0) + " tokens, " + pct + "% of the budget." +
          (size.truncated ? " Over budget — the lowest-ordered entries are being dropped." : "");
        renderKnowledge();
        if (!kbId.value) kbClear();
      }

      document.getElementById("kb-new").addEventListener("click", kbClear);

      document.getElementById("knowledge-form").addEventListener("submit", async (event) => {
        event.preventDefault();
        const { ok, data } = await knowledgeApi({
          action: "save",
          id: kbId.value || undefined,
          topic: kbTopic.value,
          body: kbBody.value,
          position: Number(kbPosition.value),
          source: kbSource.value,
        });
        if (!ok) return;
        if (data.warning && data.warning.length) {
          say(kbMessage,
            "Saved, but the text still contains: " + data.warning.join(", ") +
            ". Sprint Buddy will say that to the cohort. Edit it out unless you meant it.",
            true);
        } else {
          say(kbMessage, "Saved. Sprint Buddy uses it on the next message.", false);
        }
        kbId.value = data.id || "";
        loadKnowledge();
      loadShared();
      });

      // ---- Transcript ingest ------------------------------------------------
      //
      // The transcript is split here rather than server-side so each request
      // stays short. One call per piece keeps every request well inside any
      // proxy timeout and gives a progress count instead of a spinner that
      // might be dead. Nothing is written until "Add selected".

      const ingestSource = document.getElementById("ingest-source");
      const ingestText = document.getElementById("ingest-text");
      const ingestMessage = document.getElementById("ingest-message");
      const ingestReview = document.getElementById("ingest-review");
      const ingestGo = document.getElementById("ingest-go");
      const ingestCancel = document.getElementById("ingest-cancel");

      const CHUNK_CHARS = 24000;
      let candidates = [];
      let stopRequested = false;
      const draftOpen = new Set();

      function splitTranscript(text) {
        const paragraphs = text.split(/\n\s*\n/);
        const chunks = [];
        let current = "";
        const push = () => {
          if (current.trim().length >= 200) chunks.push(current.trim());
          current = "";
        };
        for (const paragraph of paragraphs) {
          if (paragraph.length > CHUNK_CHARS) {
            push();
            for (let i = 0; i < paragraph.length; i += CHUNK_CHARS) {
              chunks.push(paragraph.slice(i, i + CHUNK_CHARS));
            }
            continue;
          }
          if (current.length + paragraph.length + 2 > CHUNK_CHARS) push();
          current += (current ? "\n\n" : "") + paragraph;
        }
        push();
        return chunks;
      }

      function renderCandidates() {
        if (!candidates.length) {
          ingestReview.innerHTML = "";
          return;
        }
        const chosen = candidates.filter((c) => c.keep).length;
        const flaggedCount = candidates.filter((c) => (c.leaks || []).length).length;

        // Collapsed by default: 25 drafts should fit on a screen, not fill
        // several. The action bar goes above the list so it is reachable
        // without scrolling to the end of it.
        const rows = candidates
          .map((c, i) => {
            const open = draftOpen.has(i);
            const leaks = c.leaks || [];
            return (
              '<div class="rowline">' +
              '<input type="checkbox" data-keep="' + i + '"' + (c.keep ? " checked" : "") + " />" +
              '<span class="grow"><strong>' + esc(c.topic || "(no topic)") + "</strong>" +
              (leaks.length ? ' <span style="color:#f7768e">· name found</span>' : "") +
              "</span>" +
              '<button type="button" class="disclose" data-draft="' + i + '">' + (open ? "Hide" : "Show") + "</button>" +
              "</div>" +
              (leaks.length
                ? '<p class="flagged">Looks like it still contains: ' + esc(leaks.join(", ")) +
                  ". Edit it out or untick this one.</p>"
                : "") +
              (open
                ? '<div class="expanded">' +
                  '<input data-topic="' + i + '" maxlength="120" value="' + esc(c.topic) + '" />' +
                  '<textarea data-body="' + i + '" rows="4" maxlength="8000" style="margin-top:6px">' +
                  esc(c.body) + "</textarea></div>"
                : "")
            );
          })
          .join("");

        ingestReview.innerHTML =
          '<div class="stickybar">' +
          '<div class="row" style="align-items:center;gap:10px">' +
          '<button type="button" id="ingest-add">Add ' + chosen + " selected</button>" +
          '<button type="button" id="ingest-discard">Discard all</button>' +
          '<span class="note" style="margin:0">' + candidates.length + " drafts" +
          (flaggedCount ? " · " + flaggedCount + " flagged" : "") + "</span>" +
          "</div></div>" +
          '<div class="scroller">' + rows + "</div>";

        ingestReview.querySelectorAll("input[data-keep]").forEach((el) => {
          el.addEventListener("change", () => {
            candidates[Number(el.dataset.keep)].keep = el.checked;
            const n = candidates.filter((c) => c.keep).length;
            const button = document.getElementById("ingest-add");
            if (button) button.textContent = "Add " + n + " selected";
          });
        });
        ingestReview.querySelectorAll("button[data-draft]").forEach((el) => {
          el.addEventListener("click", () => {
            const i = Number(el.dataset.draft);
            if (draftOpen.has(i)) draftOpen.delete(i);
            else draftOpen.add(i);
            renderCandidates();
          });
        });
        ingestReview.querySelectorAll("input[data-topic]").forEach((el) => {
          el.addEventListener("input", () => { candidates[Number(el.dataset.topic)].topic = el.value; });
        });
        ingestReview.querySelectorAll("textarea[data-body]").forEach((el) => {
          el.addEventListener("input", () => { candidates[Number(el.dataset.body)].body = el.value; });
        });

        document.getElementById("ingest-discard").addEventListener("click", () => {
          candidates = [];
          draftOpen.clear();
          renderCandidates();
          ingestText.hidden = false;
          say(ingestMessage, "Drafts discarded. Nothing was saved.", false);
        });

        document.getElementById("ingest-add").addEventListener("click", async () => {
          const keep = candidates.filter((c) => c.keep && c.body.trim());
          if (!keep.length) { say(ingestMessage, "Nothing ticked.", true); return; }
          const { ok, data } = await knowledgeApi({
            action: "importBatch",
            source: ingestSource.value.trim(),
            entries: keep.map((c) => ({ topic: c.topic, body: c.body })),
          });
          if (!ok) { say(ingestMessage, (data && data.error) || "Could not add those.", true); return; }
          candidates = [];
          draftOpen.clear();
          renderCandidates();
          ingestText.value = "";
          ingestText.hidden = false;
          say(ingestMessage, "Added " + data.saved + ". Sprint Buddy uses them on the next message.", false);
          loadKnowledge();
      loadShared();
        });
      }

      ingestCancel.addEventListener("click", () => { stopRequested = true; });

      document.getElementById("ingest-form").addEventListener("submit", async (event) => {
        event.preventDefault();
        const source = ingestSource.value.trim();
        const text = ingestText.value.trim();
        if (!source) { say(ingestMessage, "Name whose session it is first — for your records, not for the cohort.", true); return; }
        if (text.length < 200) { say(ingestMessage, "That is too short to be a session.", true); return; }

        const chunks = splitTranscript(text);
        candidates = [];
        draftOpen.clear();
        stopRequested = false;
        ingestGo.disabled = true;
        ingestCancel.hidden = false;

        for (let i = 0; i < chunks.length; i++) {
          if (stopRequested) break;
          say(ingestMessage, "Reading piece " + (i + 1) + " of " + chunks.length + "…", false);
          const { ok, data } = await knowledgeApi({ action: "extract", source, transcript: chunks[i] });
          if (!ok) {
            // One bad piece should not throw away the pieces that worked.
            say(ingestMessage, (data && data.error) || "That piece could not be read. Carrying on.", true);
            continue;
          }
          for (const c of data.candidates || []) {
            candidates.push({ topic: c.topic, body: c.body, leaks: c.leaks || [], keep: !(c.leaks || []).length });
          }
          renderCandidates();
        }

        ingestGo.disabled = false;
        ingestCancel.hidden = true;
        // 14k words are not useful while reviewing; fold the box away.
        if (candidates.length) ingestText.hidden = true;

        if (stopRequested) {
          say(ingestMessage, "Stopped. " + candidates.length + " drafts so far, nothing saved yet.", false);
        } else if (!candidates.length) {
          say(ingestMessage, "Nothing in there was worth adding.", false);
        } else {
          const flagged = candidates.filter((c) => c.leaks.length).length;
          say(ingestMessage,
            "Done. " + candidates.length + " drafts to review." +
            (flagged ? " " + flagged + " still contain a name and are unticked." : ""),
            false);
        }
      });

      // ---- Shared conversations -------------------------------------------
      //
      // The read half of a feature that only ever had a write half. Founders
      // could hand a conversation over and no screen ever showed it.

      const sharedList = document.getElementById("shared-list");
      const sharedMessage = document.getElementById("shared-message");
      let sharedThreads = [];
      const sharedOpen = new Set();

      function relativeDay(iso) {
        if (!iso) return "";
        const then = Date.parse(iso.includes("T") ? iso : iso.replace(" ", "T") + "Z");
        if (Number.isNaN(then)) return "";
        const days = Math.floor((Date.now() - then) / 86400000);
        if (days <= 0) return "today";
        if (days === 1) return "yesterday";
        if (days < 7) return days + "d ago";
        return Math.floor(days / 7) + "w ago";
      }

      function renderShared() {
        if (!sharedThreads.length) {
          sharedList.innerHTML =
            '<p class="note">Nothing shared yet. A founder has to hand a conversation over from their own sidebar.</p>';
          return;
        }
        sharedList.innerHTML =
          '<p class="note" style="margin:0 0 10px">' + sharedThreads.length +
          " conversation" + (sharedThreads.length === 1 ? "" : "s") + " shared.</p>" +
          '<div class="scroller">' +
          sharedThreads
            .map((t) => {
              const open = sharedOpen.has(t.id);
              const transcript = (t.messages || [])
                .map((m) =>
                  '<p style="margin:0 0 10px"><strong style="color:var(--muted);font-size:0.75rem;text-transform:uppercase;letter-spacing:0.06em">' +
                  (m.role === "user" ? esc(t.founderName || "Founder") : "Sprint Buddy") +
                  "</strong><br />" + esc(m.content).replace(/\n/g, "<br />") + "</p>")
                .join("");
              return (
                '<div class="rowline">' +
                '<span class="grow"><strong>' + esc(t.founderName || t.founderEmail) + "</strong>" +
                ' <span class="note" style="margin:0">· ' + esc(t.title || "Untitled") + "</span>" +
                (t.seenAt ? "" : ' <span style="color:var(--accent);font-size:0.75rem">· new</span>') +
                "</span>" +
                '<span class="note" style="margin:0">' + esc(relativeDay(t.updatedAt)) + "</span>" +
                '<button type="button" class="disclose" data-shared="' + t.id + '">' +
                (open ? "Close" : "Read") + "</button>" +
                "</div>" +
                (open
                  ? '<div class="expanded" style="max-width:62ch">' + transcript + "</div>"
                  : "")
              );
            })
            .join("") +
          "</div>";

        sharedList.querySelectorAll("button[data-shared]").forEach((b) => {
          b.addEventListener("click", async () => {
            const id = b.dataset.shared;
            if (sharedOpen.has(id)) {
              sharedOpen.delete(id);
              renderShared();
              return;
            }
            sharedOpen.add(id);
            renderShared();
            // Stamped on first open only. The founder learns it landed, not
            // how often it is read.
            const entry = sharedThreads.find((t) => t.id === id);
            if (entry && !entry.seenAt) {
              try {
                await fetch("/api/admin/shared", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ action: "seen", id }),
                });
                entry.seenAt = new Date().toISOString();
              } catch { /* the read still happened; the stamp can wait */ }
            }
          });
        });
      }

      async function loadShared() {
        let res;
        try {
          res = await fetch("/api/admin/shared");
        } catch {
          say(sharedMessage, "Could not reach the server.", true);
          return;
        }
        if (!res.ok) return;
        const data = await res.json();
        sharedThreads = data.threads || [];
        renderShared();
      }

      // ---- Broadcast ----------------------------------------------------
      //
      // The send button stays disabled until three things are true: a test of
      // this exact wording has been delivered, somebody is selected, and the
      // typed number matches the count. The server checks all three again. This
      // copy stops the mistake; the server copy is what makes it impossible.

      const bcSubject = document.getElementById("bc-subject");
      const bcBody = document.getElementById("bc-body");
      const bcPeople = document.getElementById("bc-people");
      const bcRoleFounder = document.getElementById("bc-role-founder");
      const bcRoleOrganizer = document.getElementById("bc-role-organizer");
      const bcCount = document.getElementById("bc-count");
      const bcConfirm = document.getElementById("bc-confirm");
      const bcGo = document.getElementById("bc-go");
      const bcTest = document.getElementById("bc-test");
      const bcTestState = document.getElementById("bc-test-state");
      const bcMessage = document.getElementById("bc-message");
      const bcHistory = document.getElementById("bc-history");

      let bcRoster = [];
      let bcPicked = new Set();
      // The exact wording that was last test-sent. Editing anything clears it.
      let bcTestedWording = null;

      function bcWording() {
        return bcSubject.value.trim() + " " + bcBody.value.trim();
      }

      function bcSelected() {
        const roles = [];
        if (bcRoleFounder.checked) roles.push("founder");
        if (bcRoleOrganizer.checked) roles.push("organizer");
        // Mirrors the server's union-and-deduplicate, so the number shown here
        // is the number the server will demand as confirmation.
        const set = new Set();
        bcRoster.forEach(function (person) {
          if (roles.indexOf(person.role) !== -1 || bcPicked.has(person.email)) {
            set.add(person.email);
          }
        });
        return { roles: roles, emails: Array.from(bcPicked), count: set.size };
      }

      function bcRefresh() {
        const chosen = bcSelected();
        const count = chosen.count;
        bcCount.hidden = false;
        bcCount.className = "message " + (count ? "ok" : "error");
        bcCount.textContent = count
          ? count + (count === 1 ? " person will receive this." : " people will receive this.")
          : "Nobody is selected.";

        const tested = bcTestedWording !== null && bcTestedWording === bcWording();
        if (!tested) bcTestState.textContent = "Not tested yet.";
        bcConfirm.placeholder = String(count);
        bcGo.disabled = !(tested && count > 0 && Number(bcConfirm.value) === count);
      }

      function bcRenderPeople() {
        bcPeople.textContent = "";
        bcRoster.forEach(function (person) {
          const label = document.createElement("label");
          const box = document.createElement("input");
          box.type = "checkbox";
          box.checked = bcPicked.has(person.email);
          box.addEventListener("change", function () {
            if (box.checked) bcPicked.add(person.email);
            else bcPicked.delete(person.email);
            bcRefresh();
          });
          const who = document.createElement("span");
          who.textContent = person.name + " (" + person.email + ")";
          const role = document.createElement("span");
          role.className = "role";
          role.textContent = person.role;
          label.append(box, who, role);
          bcPeople.append(label);
        });
      }

      function bcRenderHistory(rows) {
        bcHistory.textContent = "";
        if (!rows.length) {
          const empty = document.createElement("p");
          empty.className = "note";
          empty.textContent = "Nothing sent yet.";
          bcHistory.append(empty);
          return;
        }
        rows.forEach(function (row) {
          const item = document.createElement("div");
          item.className = "bc-sent";
          const subject = document.createElement("div");
          subject.textContent = row.subject;
          const when = document.createElement("div");
          when.className = "when";
          const failed = row.failed ? ", " + row.failed + " failed" : "";
          when.textContent =
            row.created_at + " to " + row.audience + ": " + row.sent + " sent" + failed +
            " (by " + row.actor_email + ")";
          item.append(subject, when);
          bcHistory.append(item);
        });
      }

      document.querySelectorAll(".bc-tag").forEach(function (button) {
        button.addEventListener("click", function () {
          const tag = "{{" + button.dataset.tag + "}}";
          const start = bcBody.selectionStart == null ? bcBody.value.length : bcBody.selectionStart;
          const end = bcBody.selectionEnd == null ? bcBody.value.length : bcBody.selectionEnd;
          bcBody.value = bcBody.value.slice(0, start) + tag + bcBody.value.slice(end);
          bcBody.focus();
          bcBody.setSelectionRange(start + tag.length, start + tag.length);
          bcRefresh();
        });
      });

      [bcSubject, bcBody].forEach(function (field) {
        field.addEventListener("input", bcRefresh);
      });
      [bcRoleFounder, bcRoleOrganizer].forEach(function (box) {
        box.addEventListener("change", bcRefresh);
      });
      bcConfirm.addEventListener("input", bcRefresh);

      async function bcPost(payload) {
        let res;
        try {
          res = await fetch("/api/admin/broadcast", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
        } catch {
          return { error: "Could not reach the server." };
        }
        try {
          return await res.json();
        } catch {
          return { error: "The server returned an error (" + res.status + ") with no details." };
        }
      }

      bcTest.addEventListener("click", async function () {
        bcTest.disabled = true;
        bcMessage.hidden = true;
        const wording = bcWording();
        const data = await bcPost({
          action: "test",
          subject: bcSubject.value,
          body: bcBody.value,
        });
        bcTest.disabled = false;
        if (data.error) {
          bcTestedWording = null;
          say(bcMessage, data.error, true);
          bcRefresh();
          return;
        }
        bcTestedWording = wording;
        bcTestState.textContent = "Test sent to " + data.to + ". Read it before sending.";
        say(bcMessage, "Test sent. Nothing has gone to the cohort.", false);
        bcRefresh();
      });

      document.getElementById("bc-send").addEventListener("submit", async function (event) {
        event.preventDefault();
        const chosen = bcSelected();
        bcGo.disabled = true;
        bcGo.textContent = "Sending to " + chosen.count + "...";
        const data = await bcPost({
          action: "send",
          subject: bcSubject.value,
          body: bcBody.value,
          roles: chosen.roles,
          emails: chosen.emails,
          confirm: Number(bcConfirm.value),
        });
        bcGo.textContent = "Send to everyone selected";
        if (data.error) {
          say(bcMessage, data.error, true);
          bcRefresh();
          return;
        }
        const failures = (data.failures || []).map(function (f) { return f.email; }).join(", ");
        say(
          bcMessage,
          data.sent + " sent" +
            (data.failed ? ", " + data.failed + " failed: " + failures : "") + ".",
          data.failed > 0,
        );
        // A sent message must not be one stray click away from going out twice.
        bcConfirm.value = "";
        bcTestedWording = null;
        bcRefresh();
        loadBroadcast();
      });

      async function loadBroadcast() {
        let res;
        try {
          res = await fetch("/api/admin/broadcast");
        } catch {
          return;
        }
        if (!res.ok) return;
        const data = await res.json();
        bcRoster = data.people || [];
        bcRenderPeople();
        bcRenderHistory(data.history || []);
        if (!data.configured) {
          say(bcMessage, "Email is not configured, so nothing can be sent.", true);
        }
        bcRefresh();
      }

      load();
      loadDeadlines();
      loadProgramme();
      loadKnowledge();
      loadShared();
      loadBroadcast();
    </script>
  </body>
</html>
