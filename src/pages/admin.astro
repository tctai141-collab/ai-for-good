---
// Cohort administration for the operating team: add founders, issue setup
// links, reset a forgotten password, remove someone who has left.
//
// Access is enforced server-side by /api/admin/users; the checks here only
// decide what to render.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Cohort admin · Sprint Buddy</title>
    <!--
      Global rather than scoped: the people table is built in JavaScript, and
      Astro's scoped styles only reach elements present in the template.
    -->
    <style is:global>
      :root {
        --bg: #0b0c0f;
        --panel: rgba(20, 22, 27, 0.9);
        --text: #f4f4f5;
        --muted: #9ca3af;
        --accent: #7aa2f7;
        --ok: #6fcf97;
        --danger: #f4746a;
        --border: rgba(255, 255, 255, 0.12);
        --font: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        --serif: "Source Serif 4", ui-serif, Georgia, "Times New Roman", serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; background: var(--bg); }
      body {
        font-family: var(--font);
        color: var(--text);
        padding: 40px 24px 80px;
      }
      main { max-width: 900px; margin: 0 auto; }
      h1 { font-family: var(--serif); font-size: 2.25rem; margin: 0 0 6px; }
      h2 { font-family: var(--serif); font-size: 1.375rem; margin: 0 0 14px; }
      .lede { color: var(--muted); margin: 0 0 32px; font-size: 0.9375rem; }
      .panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 24px;
      }
      table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
      th {
        text-align: left;
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        font-weight: 600;
        padding: 0 10px 10px 0;
      }
      td { padding: 11px 10px 11px 0; border-top: 1px solid var(--border); vertical-align: middle; }
      .pill {
        display: inline-block;
        padding: 2px 9px;
        border-radius: 999px;
        font-size: 0.75rem;
        border: 1px solid var(--border);
        color: var(--muted);
      }
      .pill.active { color: var(--ok); border-color: rgba(111, 207, 151, 0.4); }
      .pill.pending { color: #e2b93b; border-color: rgba(226, 185, 59, 0.4); }
      .pill.organizer { color: var(--accent); border-color: rgba(122, 162, 247, 0.4); }
      .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }
      label { display: block; }
      .label-text {
        display: block;
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
      }
      input, select, textarea {
        padding: 10px 12px;
        border-radius: 9px;
        border: 1px solid var(--border);
        background: rgba(0, 0, 0, 0.35);
        color: var(--text);
        font-family: var(--font);
        font-size: 0.9375rem;
      }
      textarea { width: 100%; min-height: 120px; resize: vertical; line-height: 1.5; }
      input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); }
      button {
        padding: 10px 16px;
        border: 0;
        border-radius: 9px;
        background: var(--accent);
        color: #0b0c0f;
        font-family: var(--font);
        font-size: 0.9375rem;
        font-weight: 600;
        cursor: pointer;
      }
      button.ghost {
        background: transparent;
        color: var(--muted);
        border: 1px solid var(--border);
        padding: 6px 11px;
        font-size: 0.8125rem;
        font-weight: 500;
      }
      button.ghost:hover { color: var(--text); border-color: var(--accent); }
      button.ghost.danger:hover { color: var(--danger); border-color: rgba(244, 116, 106, 0.5); }
      button:disabled { opacity: 0.5; cursor: default; }
      .links { margin-top: 20px; }
      .deadline-row {
        border-top: 1px solid var(--line);
        padding: 12px 0;
      }
      .deadline-row.archived { opacity: 0.5; }
      .deadline-head {
        display: flex;
        align-items: baseline;
        gap: 12px;
        flex-wrap: wrap;
      }
      .deadline-head strong { flex: 1 1 220px; }
      .deadline-meta { color: var(--ink-faint); font-size: 13px; }
      .deadline-count {
        font-size: 12.5px;
        font-variant-numeric: tabular-nums;
        color: var(--ink-sub);
        white-space: nowrap;
      }
      .deadline-count.all-done { color: var(--brand-blue); font-weight: 700; }
      .deadline-row details { margin-top: 6px; }
      .deadline-row summary {
        cursor: pointer;
        font-size: 13px;
        color: var(--ink-faint);
        min-height: 32px;
        display: flex;
        align-items: center;
      }
      .deadline-actions { margin-top: 8px; }
      .link-item {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px 14px;
        margin-bottom: 10px;
        display: flex;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
      }
      .link-item code {
        font-size: 0.75rem;
        color: var(--muted);
        word-break: break-all;
        flex: 1 1 320px;
      }
      .note { color: var(--muted); font-size: 0.8125rem; line-height: 1.6; margin: 14px 0 0; }
      .message { font-size: 0.875rem; margin-top: 14px; }
      .message.error { color: var(--danger); }
      .message.ok { color: var(--ok); }
      [hidden] { display: none !important; }
      a { color: var(--accent); }
      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        /* 44px is the smallest reliable touch target, and this is the control
           somebody reaches for when they are stuck on the wrong page. */
        min-height: 44px;
        margin: 0 0 6px;
        color: var(--muted);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
      }
      .back-link:hover { color: var(--accent); text-decoration: underline; }
      .back-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
    </style>
  </head>
  <body>
    <main>
      <!-- The only way back used to be editing the URL. -->
      <a class="back-link" href="/">
        <span aria-hidden="true">&#8592;</span> Back to Sprint Buddy
      </a>
      <h1>Cohort admin</h1>
      <p class="lede" id="lede">Loading…</p>

      <div id="denied" hidden>
        <div class="panel">
          <h2>Organizers only</h2>
          <p class="note">
            This page is for the Sprint operating team. <a href="/">Go back to Sprint Buddy</a>.
          </p>
        </div>
      </div>

      <div id="app" hidden>
        <section class="panel">
          <h2>People</h2>
          <table>
            <thead>
              <tr>
                <th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th>
              </tr>
            </thead>
            <tbody id="users"></tbody>
          </table>
        </section>

        <section class="panel">
          <h2>Add one person</h2>
          <form id="add-one" class="row">
            <label>
              <span class="label-text">Full name</span>
              <input id="add-name" required placeholder="Aino Virtanen" />
            </label>
            <label>
              <span class="label-text">Email</span>
              <input id="add-email" type="email" required placeholder="aino@example.com" />
            </label>
            <label>
              <span class="label-text">Role</span>
              <select id="add-role">
                <option value="founder">Founder</option>
                <option value="organizer">Organizer</option>
              </select>
            </label>
            <button type="submit">Add and create link</button>
          </form>
          <p class="message" id="add-message" hidden></p>
        </section>

        <section class="panel">
          <h2>Add the whole cohort</h2>
          <p class="note" style="margin-top:0">
            One person per line, as <strong>Name, email</strong>. Everyone added here is a
            founder — add the operating team individually above.
          </p>
          <form id="add-bulk">
            <textarea
              id="bulk-text"
              placeholder="Aino Virtanen, aino@example.com&#10;Elias Koskinen, elias@example.com"
            ></textarea>
            <div style="margin-top:12px"><button type="submit">Add everyone</button></div>
          </form>
          <p class="message" id="bulk-message" hidden></p>
        </section>

        <section class="panel" id="links-panel" hidden>
          <h2>Setup links sent</h2>
          <p class="note" style="margin-top:0">
            Each link is emailed straight to that person's own address. You never see it,
            and neither does anyone else on the team — a setup link is as good as a
            password, so whoever holds it can claim the account. Each works once and
            expires after 14 days. If someone says it never arrived, use
            <strong>Resend link</strong> on their row.
          </p>
          <div class="links" id="links"></div>
        </section>

        <section class="panel">
          <h2>Deadlines</h2>
          <p class="note" style="margin-top:0">
            Cohort-wide milestones. Everyone sees the same list, and each founder ticks
            off their own. Archive rather than delete — archiving hides it from founders
            and keeps the completion history.
          </p>

          <form id="add-deadline" class="row">
            <label>
              <span class="label-text">Title</span>
              <input id="dl-title" required maxlength="200" placeholder="Lifeline pitch to the cohort" />
            </label>
            <label>
              <span class="label-text">Description (optional)</span>
              <input id="dl-description" maxlength="2000" placeholder="Five minutes, no slides" />
            </label>
            <label>
              <span class="label-text">Due date</span>
              <input id="dl-due" type="date" required />
            </label>
            <label>
              <span class="label-text">Sprint week (optional)</span>
              <input id="dl-week" type="number" min="1" max="15" placeholder="2" />
            </label>
            <button type="submit">Add deadline</button>
          </form>
          <p class="message" id="dl-message" hidden></p>

          <div id="deadline-list"></div>
        </section>

        <section class="panel">
          <h2>Programme</h2>
          <p class="note" style="margin-top:0">
            What the sprint is running each week. The advisor is given the current
            week only, and is told plainly that it describes the cohort's schedule
            and not any individual founder's company. Leave a week blank and it says
            nothing about it at all — which is better than saying something stale.
          </p>

          <form id="programme-form" class="row">
            <label>
              <span class="label-text">Week</span>
              <select id="pr-week"></select>
            </label>
            <label>
              <span class="label-text">Phase</span>
              <input id="pr-phase" maxlength="200" placeholder="Trend Research" />
            </label>
            <label>
              <span class="label-text">Title</span>
              <input id="pr-title" maxlength="200" placeholder="Orientation &amp; Kick-off" />
            </label>
            <label style="flex:1 1 100%">
              <span class="label-text">Milestones — one per line</span>
              <textarea id="pr-milestones" rows="4" maxlength="4000" placeholder="Define the research framework&#10;Clarify roles and tasks"></textarea>
            </label>
            <label style="flex:1 1 100%">
              <span class="label-text">Sessions — one per line</span>
              <textarea id="pr-sessions" rows="4" maxlength="4000" placeholder="Tue 9:30–11:30 — Team meeting, intro to the sprint&#10;Wed 13:00–15:00 — Workshop"></textarea>
            </label>
            <button type="submit">Save week</button>
          </form>
          <p class="message" id="pr-message" hidden></p>

          <div id="programme-list"></div>
        </section>

        <section class="panel">
          <h2>What Mårten knows</h2>
          <p class="note" style="margin-top:0">
            The advisor's knowledge, one entry per topic. All of it is sent with
            every message — there is no search step to miss the right passage.
            Order matters: it is the order he reads them in. Archive rather than
            delete so you can put something back.
          </p>
          <p class="note" id="kb-size" style="margin-top:0"></p>

          <form id="knowledge-form" class="row">
            <input type="hidden" id="kb-id" />
            <label>
              <span class="label-text">Topic</span>
              <input id="kb-topic" maxlength="120" placeholder="SELLING AND PRODUCT-MARKET FIT" />
            </label>
            <label>
              <span class="label-text">Order</span>
              <input id="kb-position" type="number" step="10" value="0" />
            </label>
            <label>
              <span class="label-text">Source (optional)</span>
              <input id="kb-source" maxlength="120" placeholder="Quora, 2015" />
            </label>
            <label style="flex:1 1 100%">
              <span class="label-text">What he thinks about it</span>
              <textarea id="kb-body" rows="6" maxlength="8000" placeholder="Sell before you build; you can start selling before you have a prototype. (Jyri Engeström's formulation — credit him.) Pre-PMF the metric is not revenue, it is learning."></textarea>
            </label>
            <button type="submit">Save entry</button>
            <button type="button" id="kb-new">New entry</button>
          </form>
          <p class="message" id="kb-message" hidden></p>

          <div id="knowledge-list"></div>
        </section>

        <section class="panel">
          <h2>Add knowledge from a transcript</h2>
          <p class="note" style="margin-top:0">
            Paste a mentor session. It is read in pieces and comes back as draft
            entries for you to approve — nothing reaches Mårten until you tick it
            and add it. The transcript itself is never stored, only the entries
            you keep. Anything about a founder or their company is left out.
          </p>

          <form id="ingest-form" class="row">
            <label>
              <span class="label-text">Who was speaking</span>
              <input id="ingest-source" maxlength="120" placeholder="Atte — Singa" required />
            </label>
            <label style="flex:1 1 100%">
              <span class="label-text">Transcript</span>
              <textarea id="ingest-text" rows="8" placeholder="Paste the whole session. Long ones are split automatically."></textarea>
            </label>
            <button type="submit" id="ingest-go">Read it</button>
            <button type="button" id="ingest-cancel" hidden>Stop</button>
          </form>
          <p class="message" id="ingest-message" hidden></p>

          <div id="ingest-review"></div>
        </section>
      </div>
    </main>

    <script is:inline>
      const lede = document.getElementById("lede");
      const app = document.getElementById("app");
      const denied = document.getElementById("denied");
      const usersBody = document.getElementById("users");
      const linksPanel = document.getElementById("links-panel");
      const linksBox = document.getElementById("links");
      let me = null;

      // Entry text now originates in a pasted transcript by way of the model,
      // so it reaches this page as untrusted content and must never be parsed
      // as markup on the way into the DOM.
      function esc(value) {
        return String(value == null ? "" : value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      function say(el, text, isError) {
        el.textContent = text;
        el.className = "message " + (isError ? "error" : "ok");
        el.hidden = false;
      }

      async function api(body) {
        // Never assume a body is JSON. A server error can return an empty
        // body, and `await res.json()` then throws before the caller can read
        // an error message — which is why a failed removal used to leave the
        // button disabled with nothing shown at all.
        let res;
        try {
          res = await fetch("/api/admin/users", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
        } catch {
          return { ok: false, data: { error: "Could not reach the server. Check your connection." } };
        }
        let data = {};
        try {
          data = await res.json();
        } catch {
          data = { error: `The server returned an error (${res.status}) with no details.` };
        }
        return { ok: res.ok, data };
      }

      /*
       * Records that a link was emailed. The link itself is deliberately not
       * shown here and is not in the response: it goes to the founder's own
       * address and nowhere else, so that nobody on the operating team can
       * redeem it and sign in as them.
       */
      function addLink(name, email) {
        linksPanel.hidden = false;
        const item = document.createElement("div");
        item.className = "link-item";

        const who = document.createElement("strong");
        who.textContent = name ? name + " · " + email : email;
        who.style.flex = "1 1 180px";

        const status = document.createElement("span");
        status.textContent = "Setup link emailed";
        status.style.color = "var(--ok, #16653c)";
        status.style.fontSize = "13px";

        item.append(who, status);
        linksBox.prepend(item);
      }

      function renderUsers(users) {
        usersBody.textContent = "";
        for (const user of users) {
          const tr = document.createElement("tr");

          const name = document.createElement("td");
          name.textContent = user.name;

          const email = document.createElement("td");
          email.textContent = user.email;

          const role = document.createElement("td");
          const rolePill = document.createElement("span");
          rolePill.className = "pill" + (user.role === "organizer" ? " organizer" : "");
          rolePill.textContent = user.role;
          role.append(rolePill);

          const status = document.createElement("td");
          const statusPill = document.createElement("span");
          statusPill.className = "pill " + (user.activated ? "active" : "pending");
          statusPill.textContent = user.activated ? "active" : "not set up";
          status.append(statusPill);

          const actions = document.createElement("td");
          actions.style.textAlign = "right";

          const reinvite = document.createElement("button");
          reinvite.className = "ghost";
          reinvite.textContent = user.activated ? "Reset password" : "New link";
          reinvite.addEventListener("click", async () => {
            reinvite.disabled = true;
            const { ok, data } = await api({ action: "reinvite", email: user.email });
            reinvite.disabled = false;
            if (!ok) return alert(data.error || "Could not send the link.");
            addLink(user.name, user.email);
            linksPanel.scrollIntoView({ behavior: "smooth", block: "nearest" });
          });
          actions.append(reinvite);

          if (user.email !== me) {
            const remove = document.createElement("button");
            remove.className = "ghost danger";
            remove.textContent = "Remove";
            remove.style.marginLeft = "8px";
            remove.addEventListener("click", async () => {
              const warning =
                "Remove " + user.name + " (" + user.email + ")?\n\n" +
                "This permanently deletes their account and everything in it — " +
                "conversations, check-ins and decisions. It cannot be undone.";
              if (!confirm(warning)) return;
              remove.disabled = true;
              const { ok, data } = await api({ action: "remove", email: user.email });
              if (!ok) {
                remove.disabled = false;
                return alert(data.error || "Could not remove this account.");
              }
              load();
            });
            actions.append(remove);
          }

          tr.append(name, email, role, status, actions);
          usersBody.append(tr);
        }
      }

      // ---- Deadlines ----------------------------------------------------

      const deadlineList = document.getElementById("deadline-list");

      async function deadlineApi(body) {
        let res;
        try {
          res = await fetch("/api/deadlines", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
        } catch {
          return { ok: false, data: { error: "Could not reach the server." } };
        }
        let data = {};
        try {
          data = await res.json();
        } catch {
          data = { error: "The server returned an error (" + res.status + ") with no details." };
        }
        return { ok: res.ok, data };
      }

      function dueLabel(iso) {
        const [y, m, d] = iso.split("-").map(Number);
        if (!y) return iso;
        const date = new Date(Date.UTC(y, m - 1, d));
        const day = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][date.getUTCDay()];
        const mon = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"][date.getUTCMonth()];
        return day + " " + d + " " + mon;
      }

      async function loadDeadlines() {
        let data;
        try {
          const res = await fetch("/api/deadlines?view=status");
          if (!res.ok) return;
          data = await res.json();
        } catch {
          return;
        }

        deadlineList.textContent = "";
        if (!data.deadlines.length) {
          const empty = document.createElement("p");
          empty.className = "note";
          empty.textContent = "No deadlines yet. Add the first one above.";
          deadlineList.append(empty);
          return;
        }

        const cohort = data.cohortSize;
        for (const d of data.deadlines) {
          const row = document.createElement("div");
          row.className = "deadline-row";
          if (d.status === "archived") row.classList.add("archived");

          const head = document.createElement("div");
          head.className = "deadline-head";

          const title = document.createElement("strong");
          title.textContent = d.title;

          const meta = document.createElement("span");
          meta.className = "deadline-meta";
          meta.textContent =
            dueLabel(d.dueDate) +
            (d.sprintWeek ? " · W" + d.sprintWeek : "") +
            (d.status === "archived" ? " · archived" : "");

          // Completion count. Task status only — this view never shows anything
          // a founder wrote.
          const count = document.createElement("span");
          count.className = "deadline-count";
          count.textContent = d.doneCount + "/" + cohort + " done";
          if (cohort > 0 && d.doneCount === cohort) count.classList.add("all-done");

          head.append(title, meta, count);
          row.append(head);

          if (d.behind.length > 0 && d.status === "active") {
            const details = document.createElement("details");
            const summary = document.createElement("summary");
            summary.textContent = d.behind.length + " not done yet";
            const names = document.createElement("p");
            names.className = "note";
            names.style.margin = "6px 0 0";
            names.textContent = d.behind.map((f) => f.name).join(", ");
            details.append(summary, names);
            row.append(details);
          }

          const actions = document.createElement("div");
          actions.className = "deadline-actions";

          const archive = document.createElement("button");
          archive.className = "ghost";
          archive.textContent = d.status === "archived" ? "Restore" : "Archive";
          archive.addEventListener("click", async () => {
            archive.disabled = true;
            const { ok, data: body } = await deadlineApi({
              action: "update",
              id: d.id,
              status: d.status === "archived" ? "active" : "archived",
            });
            archive.disabled = false;
            if (!ok) return alert(body.error || "Could not update this deadline.");
            loadDeadlines();
          });

          actions.append(archive);
          row.append(actions);
          deadlineList.append(row);
        }
      }

      document.getElementById("add-deadline").addEventListener("submit", async (event) => {
        event.preventDefault();
        const message = document.getElementById("dl-message");
        const title = document.getElementById("dl-title");
        const description = document.getElementById("dl-description");
        const due = document.getElementById("dl-due");
        const week = document.getElementById("dl-week");

        const { ok, data } = await deadlineApi({
          action: "create",
          title: title.value,
          description: description.value,
          dueDate: due.value,
          sprintWeek: week.value === "" ? null : Number(week.value),
        });

        if (!ok) return say(message, data.error || "Could not add this deadline.", true);

        say(message, "Added \u201c" + title.value.trim() + "\u201d.", false);
        title.value = "";
        description.value = "";
        week.value = "";
        loadDeadlines();
      });

      async function load() {
        try {
          const res = await fetch("/api/admin/users");
          if (res.status === 401) {
            lede.hidden = true;
            denied.hidden = false;
            location.href = "/";
            return;
          }
          if (res.status === 403) {
            lede.hidden = true;
            denied.hidden = false;
            return;
          }
          const data = await res.json();
          me = data.you;
          const pending = data.users.filter((u) => !u.activated).length;
          lede.textContent =
            data.users.length +
            (data.users.length === 1 ? " account" : " accounts") +
            (pending ? " · " + pending + " still to set up" : " · everyone is set up");
          app.hidden = false;
          renderUsers(data.users);
        } catch {
          lede.textContent = "Could not reach the server.";
        }
      }

      document.getElementById("add-one").addEventListener("submit", async (event) => {
        event.preventDefault();
        const message = document.getElementById("add-message");
        const name = document.getElementById("add-name");
        const email = document.getElementById("add-email");
        const role = document.getElementById("add-role");

        const { ok, data } = await api({
          action: "add",
          name: name.value,
          email: email.value,
          role: role.value,
        });
        if (!ok) return say(message, data.error || "Could not add this person.", true);

        addLink(name.value.trim(), data.email);
        say(message, "Added " + name.value.trim() + ". Their setup link has been emailed to them.", false);
        name.value = "";
        email.value = "";
        load();
      });

      document.getElementById("add-bulk").addEventListener("submit", async (event) => {
        event.preventDefault();
        const message = document.getElementById("bulk-message");
        const textarea = document.getElementById("bulk-text");

        const entries = textarea.value
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            // "Name, email" — split on the last comma so names may contain one.
            const cut = line.lastIndexOf(",");
            if (cut === -1) return { name: "", email: line };
            return { name: line.slice(0, cut).trim(), email: line.slice(cut + 1).trim() };
          });

        if (!entries.length) return say(message, "Nothing to add.", true);

        const { ok, data } = await api({ action: "add-bulk", entries });
        if (!ok) return say(message, data.error || "Could not add these people.", true);

        const added = data.results.filter((r) => r.emailed);
        const failed = data.results.filter((r) => r.error);
        for (const row of added) addLink(row.name, row.email);

        const summary =
          "Added " + added.length + " of " + data.results.length + "." +
          (failed.length
            ? " Skipped: " + failed.map((f) => (f.email || "(blank)") + " — " + f.error).join("; ")
            : "");
        say(message, summary, failed.length > 0);
        if (added.length) textarea.value = "";
        load();
      });

      // ---- Programme ----------------------------------------------------

      const prWeek = document.getElementById("pr-week");
      const prPhase = document.getElementById("pr-phase");
      const prTitle = document.getElementById("pr-title");
      const prMilestones = document.getElementById("pr-milestones");
      const prSessions = document.getElementById("pr-sessions");
      const prMessage = document.getElementById("pr-message");
      const programmeList = document.getElementById("programme-list");

      let programmeWeeks = [];
      let totalWeeks = 15;

      function fillWeek(week) {
        const row = programmeWeeks.find((w) => w.week === week);
        prPhase.value = row ? row.phase : "";
        prTitle.value = row ? row.title : "";
        prMilestones.value = row ? row.milestones : "";
        prSessions.value = row ? row.sessions : "";
      }

      function renderProgramme() {
        if (!programmeWeeks.length) {
          programmeList.innerHTML =
            '<p class="note">No weeks entered yet. The advisor says nothing about the programme until one is.</p>';
          return;
        }
        programmeList.innerHTML = programmeWeeks
          .map((w) => {
            const heading = [w.phase, w.title].filter(Boolean).join(" — ");
            const milestones = w.milestones.split("\n").filter((l) => l.trim()).length;
            const sessions = w.sessions.split("\n").filter((l) => l.trim()).length;
            return (
              '<div class="row" style="align-items:baseline;gap:12px;padding:8px 0;border-bottom:1px solid var(--border)">' +
              '<strong style="min-width:70px">Week ' + w.week + "</strong>" +
              '<span style="flex:1">' + (heading || "<em>untitled</em>") + "</span>" +
              '<span class="note" style="margin:0">' + milestones + " milestone" + (milestones === 1 ? "" : "s") +
              ", " + sessions + " session" + (sessions === 1 ? "" : "s") + "</span>" +
              '<button type="button" data-week="' + w.week + '">Edit</button>' +
              "</div>"
            );
          })
          .join("");
        programmeList.querySelectorAll("button[data-week]").forEach((b) => {
          b.addEventListener("click", () => {
            const week = Number(b.dataset.week);
            prWeek.value = String(week);
            fillWeek(week);
            prPhase.focus();
          });
        });
      }

      async function loadProgramme() {
        let res;
        try {
          res = await fetch("/api/programme");
        } catch {
          return say(prMessage, "Could not reach the server.", true);
        }
        if (!res.ok) return;
        const data = await res.json();
        totalWeeks = data.totalWeeks || 15;
        programmeWeeks = data.weeks || [];

        if (!prWeek.options.length) {
          for (let i = 1; i <= totalWeeks; i++) {
            const option = document.createElement("option");
            option.value = String(i);
            option.textContent = "Week " + i;
            prWeek.appendChild(option);
          }
          prWeek.addEventListener("change", () => fillWeek(Number(prWeek.value)));
        }
        renderProgramme();
        fillWeek(Number(prWeek.value || 1));
      }

      document.getElementById("programme-form").addEventListener("submit", async (event) => {
        event.preventDefault();
        let res;
        try {
          res = await fetch("/api/programme", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              week: Number(prWeek.value),
              phase: prPhase.value,
              title: prTitle.value,
              milestones: prMilestones.value,
              sessions: prSessions.value,
            }),
          });
        } catch {
          return say(prMessage, "Could not reach the server.", true);
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) return say(prMessage, data.error || "Could not save that week.", true);

        const blank = !prPhase.value.trim() && !prTitle.value.trim() &&
          !prMilestones.value.trim() && !prSessions.value.trim();
        say(prMessage, blank ? "Week " + prWeek.value + " cleared." : "Week " + prWeek.value + " saved.", false);
        loadProgramme();
      });

      // ---- Knowledge base ------------------------------------------------

      const kbId = document.getElementById("kb-id");
      const kbTopic = document.getElementById("kb-topic");
      const kbBody = document.getElementById("kb-body");
      const kbPosition = document.getElementById("kb-position");
      const kbSource = document.getElementById("kb-source");
      const kbMessage = document.getElementById("kb-message");
      const kbSize = document.getElementById("kb-size");
      const knowledgeList = document.getElementById("knowledge-list");

      let knowledgeEntries = [];

      function kbClear() {
        kbId.value = "";
        kbTopic.value = "";
        kbBody.value = "";
        kbSource.value = "";
        const highest = knowledgeEntries.reduce((m, e) => Math.max(m, e.position), 0);
        kbPosition.value = String(highest + 10);
      }

      // A transcript import lands dozens of entries under one source, so the
      // way out has to be as cheap as the way in.
      function sourceSummary() {
        const counts = new Map();
        for (const e of knowledgeEntries) {
          if (e.status === "archived" || !e.source) continue;
          counts.set(e.source, (counts.get(e.source) || 0) + 1);
        }
        if (counts.size === 0) return "";
        return (
          '<p class="note" style="margin:0 0 10px">Active by source. Archiving a source puts all of its entries back in the drawer; each one can still be restored on its own.</p>' +
          '<div class="row" style="gap:8px;margin-bottom:14px">' +
          [...counts.entries()]
            .map(
              ([source, n]) =>
                '<span style="display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);border-radius:999px;padding:3px 6px 3px 10px">' +
                esc(source) + ' <span class="note" style="margin:0">' + n + "</span>" +
                '<button type="button" data-archive-source="' + esc(source) + '">Archive all</button>' +
                "</span>",
            )
            .join("") +
          "</div>"
        );
      }

      function renderKnowledge() {
        if (!knowledgeEntries.length) {
          knowledgeList.innerHTML = '<p class="note">Nothing yet.</p>';
          return;
        }
        knowledgeList.innerHTML = sourceSummary() + knowledgeEntries
          .map((e) => {
            const archived = e.status === "archived";
            const preview = esc(e.body.length > 130 ? e.body.slice(0, 130) + "…" : e.body);
            return (
              '<div style="padding:10px 0;border-bottom:1px solid var(--border);opacity:' + (archived ? "0.5" : "1") + '">' +
              '<div class="row" style="align-items:baseline;gap:10px">' +
              '<strong style="min-width:44px">' + e.position + "</strong>" +
              '<span style="flex:1"><strong>' + esc(e.topic || "(no topic)") + "</strong>" +
              (e.source ? ' <span class="note" style="margin:0">· ' + esc(e.source) + "</span>" : "") +
              (archived ? ' <span class="note" style="margin:0">· archived</span>' : "") +
              "</span>" +
              '<button type="button" data-edit="' + e.id + '">Edit</button>' +
              '<button type="button" data-toggle="' + e.id + '">' + (archived ? "Restore" : "Archive") + "</button>" +
              "</div>" +
              '<p class="note" style="margin:4px 0 0">' + preview + "</p>" +
              "</div>"
            );
          })
          .join("");

        knowledgeList.querySelectorAll("button[data-edit]").forEach((b) => {
          b.addEventListener("click", () => {
            const entry = knowledgeEntries.find((e) => e.id === b.dataset.edit);
            if (!entry) return;
            kbId.value = entry.id;
            kbTopic.value = entry.topic;
            kbBody.value = entry.body;
            kbPosition.value = String(entry.position);
            kbSource.value = entry.source || "";
            kbTopic.focus();
          });
        });
        knowledgeList.querySelectorAll("button[data-archive-source]").forEach((b) => {
          b.addEventListener("click", async () => {
            const source = b.dataset.archiveSource;
            // Deliberately a two-step rather than a confirm() dialog: a modal
            // blocks the page, and this is reversible anyway.
            if (b.dataset.armed !== "yes") {
              b.dataset.armed = "yes";
              b.textContent = "Sure?";
              setTimeout(() => {
                if (!b.isConnected) return;
                b.dataset.armed = "";
                b.textContent = "Archive all";
              }, 4000);
              return;
            }
            const { ok, data } = await knowledgeApi({ action: "archiveSource", source });
            if (!ok) return;
            say(kbMessage, "Archived " + data.archived + " from " + source + ".", false);
            loadKnowledge();
          });
        });

        knowledgeList.querySelectorAll("button[data-toggle]").forEach((b) => {
          b.addEventListener("click", async () => {
            const entry = knowledgeEntries.find((e) => e.id === b.dataset.toggle);
            if (!entry) return;
            await knowledgeApi({ action: entry.status === "archived" ? "restore" : "archive", id: entry.id });
            loadKnowledge();
          });
        });
      }

      async function knowledgeApi(body) {
        let res;
        try {
          res = await fetch("/api/knowledge", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
        } catch {
          say(kbMessage, "Could not reach the server.", true);
          return { ok: false, data: {} };
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) say(kbMessage, data.error || "That did not work.", true);
        return { ok: res.ok, data };
      }

      async function loadKnowledge() {
        let res;
        try {
          res = await fetch("/api/knowledge");
        } catch {
          return;
        }
        if (!res.ok) return;
        const data = await res.json();
        knowledgeEntries = data.entries || [];
        const size = data.size || {};
        const pct = Math.round((size.chars / size.budgetChars) * 100);
        kbSize.textContent =
          "Active pack: ~" + (size.approxTokens || 0) + " tokens, " + pct + "% of the budget." +
          (size.truncated ? " Over budget — the lowest-ordered entries are being dropped." : "");
        renderKnowledge();
        if (!kbId.value) kbClear();
      }

      document.getElementById("kb-new").addEventListener("click", kbClear);

      document.getElementById("knowledge-form").addEventListener("submit", async (event) => {
        event.preventDefault();
        const { ok, data } = await knowledgeApi({
          action: "save",
          id: kbId.value || undefined,
          topic: kbTopic.value,
          body: kbBody.value,
          position: Number(kbPosition.value),
          source: kbSource.value,
        });
        if (!ok) return;
        say(kbMessage, "Saved. Mårten uses it on the next message.", false);
        kbId.value = data.id || "";
        loadKnowledge();
      });

      // ---- Transcript ingest ------------------------------------------------
      //
      // The transcript is split here rather than server-side so each request
      // stays short. One call per piece keeps every request well inside any
      // proxy timeout, and gives the operator a progress count instead of a
      // spinner that might be dead. Nothing is written until "Add selected".

      const ingestSource = document.getElementById("ingest-source");
      const ingestText = document.getElementById("ingest-text");
      const ingestMessage = document.getElementById("ingest-message");
      const ingestReview = document.getElementById("ingest-review");
      const ingestGo = document.getElementById("ingest-go");
      const ingestCancel = document.getElementById("ingest-cancel");

      const CHUNK_CHARS = 24000;
      let candidates = [];
      let stopRequested = false;

      function splitTranscript(text) {
        const paragraphs = text.split(/\n\s*\n/);
        const chunks = [];
        let current = "";
        const push = () => {
          if (current.trim().length >= 200) chunks.push(current.trim());
          current = "";
        };
        for (const paragraph of paragraphs) {
          if (paragraph.length > CHUNK_CHARS) {
            push();
            for (let i = 0; i < paragraph.length; i += CHUNK_CHARS) {
              chunks.push(paragraph.slice(i, i + CHUNK_CHARS));
            }
            continue;
          }
          if (current.length + paragraph.length + 2 > CHUNK_CHARS) push();
          current += (current ? "\n\n" : "") + paragraph;
        }
        push();
        return chunks;
      }

      function renderCandidates() {
        if (!candidates.length) {
          ingestReview.innerHTML = "";
          return;
        }
        const chosen = candidates.filter((c) => c.keep).length;
        ingestReview.innerHTML =
          '<p class="note" style="margin:14px 0 6px"><strong>' + candidates.length +
          " draft entries.</strong> Untick anything that is not his to say, edit the wording, then add them.</p>" +
          candidates
            .map((c, i) =>
              '<div style="padding:10px 0;border-bottom:1px solid var(--border)">' +
              '<div class="row" style="align-items:baseline;gap:10px">' +
              '<input type="checkbox" data-keep="' + i + '"' + (c.keep ? " checked" : "") + " />" +
              '<input data-topic="' + i + '" maxlength="120" value="' + esc(c.topic) + '" style="flex:1" />' +
              "</div>" +
              '<textarea data-body="' + i + '" rows="3" maxlength="8000" style="width:100%;margin-top:6px">' +
              esc(c.body) + "</textarea>" +
              "</div>",
            )
            .join("") +
          '<div class="row" style="margin-top:12px">' +
          '<button type="button" id="ingest-add">Add ' + chosen + " selected</button>" +
          '<button type="button" id="ingest-discard">Discard all</button>' +
          "</div>";

        ingestReview.querySelectorAll("input[data-keep]").forEach((el) => {
          el.addEventListener("change", () => {
            candidates[Number(el.dataset.keep)].keep = el.checked;
            const n = candidates.filter((c) => c.keep).length;
            const button = document.getElementById("ingest-add");
            if (button) button.textContent = "Add " + n + " selected";
          });
        });
        ingestReview.querySelectorAll("input[data-topic]").forEach((el) => {
          el.addEventListener("input", () => { candidates[Number(el.dataset.topic)].topic = el.value; });
        });
        ingestReview.querySelectorAll("textarea[data-body]").forEach((el) => {
          el.addEventListener("input", () => { candidates[Number(el.dataset.body)].body = el.value; });
        });

        document.getElementById("ingest-discard").addEventListener("click", () => {
          candidates = [];
          renderCandidates();
          say(ingestMessage, "Drafts discarded. Nothing was saved.", false);
        });

        document.getElementById("ingest-add").addEventListener("click", async () => {
          const keep = candidates.filter((c) => c.keep && c.body.trim());
          if (!keep.length) { say(ingestMessage, "Nothing ticked.", true); return; }
          const { ok, data } = await knowledgeApi({
            action: "importBatch",
            source: ingestSource.value.trim(),
            entries: keep.map((c) => ({ topic: c.topic, body: c.body })),
          });
          if (!ok) { say(ingestMessage, (data && data.error) || "Could not add those.", true); return; }
          candidates = [];
          renderCandidates();
          say(ingestMessage, "Added " + data.saved + ". Mårten uses them on the next message.", false);
          loadKnowledge();
        });
      }

      ingestCancel.addEventListener("click", () => { stopRequested = true; });

      document.getElementById("ingest-form").addEventListener("submit", async (event) => {
        event.preventDefault();
        const source = ingestSource.value.trim();
        const text = ingestText.value.trim();
        if (!source) { say(ingestMessage, "Name who was speaking first.", true); return; }
        if (text.length < 200) { say(ingestMessage, "That is too short to be a session.", true); return; }

        const chunks = splitTranscript(text);
        candidates = [];
        stopRequested = false;
        ingestGo.disabled = true;
        ingestCancel.hidden = false;

        for (let i = 0; i < chunks.length; i++) {
          if (stopRequested) break;
          say(ingestMessage, "Reading piece " + (i + 1) + " of " + chunks.length + "…", false);
          const { ok, data } = await knowledgeApi({ action: "extract", source, transcript: chunks[i] });
          if (!ok) {
            // One bad piece should not throw away the pieces that worked.
            say(ingestMessage, (data && data.error) || "That piece could not be read. Carrying on.", true);
            continue;
          }
          for (const c of data.candidates || []) candidates.push({ topic: c.topic, body: c.body, keep: true });
          renderCandidates();
        }

        ingestGo.disabled = false;
        ingestCancel.hidden = true;
        if (stopRequested) {
          say(ingestMessage, "Stopped. " + candidates.length + " drafts so far, nothing saved yet.", false);
        } else if (!candidates.length) {
          say(ingestMessage, "Nothing in there was worth adding.", false);
        } else {
          say(ingestMessage, "Done. " + candidates.length + " drafts to review below.", false);
        }
      });

      load();
      loadDeadlines();
      loadProgramme();
      loadKnowledge();
    </script>
  </body>
</html>
