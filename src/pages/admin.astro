---
// Cohort administration for the operating team: add founders, issue setup
// links, reset a forgotten password, remove someone who has left.
//
// Access is enforced server-side by /api/admin/users; the checks here only
// decide what to render.

import QuickActions from "../components/QuickActions";
import AaltoMark from "../components/AaltoMark.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Cohort admin · Sprint Buddy</title>
    <!--
      Global rather than scoped: the people table is built in JavaScript, and
      Astro's scoped styles only reach elements present in the template.
    -->
    <style is:global>
      /* Same design tokens as the founder side, under this page's own names.
         The palette is benchmarked on Linear: near-black canvas, rules at
         6-10% white, indigo accent, one type family. Red is now only ever a
         status colour, which is what it was always supposed to be. */
      :root {
        --bg: #08090a;
        --panel: #0f1011;
        --panel-2: #17181a;
        --text: #f7f8f8;
        --sub: #d0d6e0;
        --muted: #8a8f98;
        --accent: #5e6ad2;
        --accent-hover: #6e79d6;
        --ok: #4cb782;
        --danger: #eb5757;
        --warn: #f2c94c;
        --border: rgba(255, 255, 255, 0.08);
        --border-strong: rgba(255, 255, 255, 0.14);
        --font: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        /* One face. Kept as a token because the page reads it in a dozen
           places; it points at the same family now. */
        --serif: var(--font);
        --track-heading: -0.021em;
        --track-body: -0.011em;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; background: var(--bg); }
      body {
        font-family: var(--font);
        color: var(--text);
        padding: 40px 24px 80px;
      }
      /*
         The same width as the founder pages.
         *
         * It was 900px, which left roughly 400 pixels of empty screen down
         * each side and clipped the last tab, "Transcript", off the end of a
         * nav that was already 5px too narrow for its own contents. The
         * founder views were widened to min(1280px, 100%); this is the page
         * the operating team spends the most time on and it was the narrowest.
         *
         * Width goes to the things that use it: the tab bar, the people table,
         * the deadline and knowledge lists. Not to the forms, which are capped
         * below, because a text field the width of a desk is not easier to
         * fill in.
      */
      main { max-width: min(1280px, 100%); margin: 0 auto; }
      h1 { font-family: var(--serif); font-size: 2.25rem; margin: 0 0 6px; }
      h2 { font-family: var(--serif); font-size: 1.375rem; margin: 0 0 14px; }
      .lede { color: var(--muted); margin: 0 0 32px; font-size: 0.9375rem; max-width: 82ch; }
      .panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 24px;
      }
      table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
      th {
        text-align: left;
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        font-weight: 600;
        padding: 0 10px 10px 0;
      }
      td { padding: 11px 10px 11px 0; border-top: 1px solid var(--border); vertical-align: middle; }
      /* ── The member cell ──
         Name and address in one cell rather than two columns, with an avatar
         in front. Twenty rows scan faster down one edge than across four, and
         an address is an attribute of the person rather than a peer of their
         name.

         The avatars are initials, not photographs. There are no photographs of
         this cohort anywhere in the system, and the page's CSP blocks
         everything off-origin, so a remote portrait would render as a broken
         square. Initials also stay right when someone has no photo, which in
         practice is everyone. */
      .member { display: flex; align-items: center; gap: 11px; }
      .avatar {
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        width: 36px; height: 36px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.06);
        color: var(--text);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.02em;
      }
      /* Only the signed-in organizer is tinted. A deterministic colour per
         person would put twenty hues on a page whose whole palette is one red,
         and none of them would mean anything. */
      /* --accent-hover, not --accent. These initials are 12px, and dark ink
         on the base indigo measures 4.16:1 against the 4.5 that size asks for.
         The lighter step is already a token and takes it to 5.0:1. */
      .avatar.you { background: var(--accent-hover); border-color: transparent; color: #0b0c0f; }
      .member-lines { display: flex; flex-direction: column; min-width: 0; }
      .member-name { font-weight: 600; }
      .member-email {
        font-size: 0.8125rem;
        color: var(--muted);
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* Checkboxes, matching the founder side's deadline tick. The default
         control paints an unchecked box as a filled white square, which on a
         near-black panel is the loudest thing on it. The mark is the tick path
         from the supplied component, used as a mask so it takes currentColor.
         The page's CSP allows img-src 'self' data:, which is what governs it. */
      .check {
        appearance: none;
        -webkit-appearance: none;
        width: 16px;
        height: 16px;
        margin: 0;
        flex-shrink: 0;
        border: 1px solid var(--border);
        border-radius: 4px;
        background: transparent;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
        cursor: pointer;
        display: grid;
        place-items: center;
        transition: background 120ms ease, border-color 120ms ease;
      }
      .check:hover:not(:disabled) { border-color: var(--accent); }
      .check:checked { background: var(--accent); border-color: var(--accent); }
      .check::after {
        content: "";
        width: 9px;
        height: 9px;
        background: currentColor;
        color: transparent;
        -webkit-mask-image: url("data:image/svg+xml,<svg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%209%209'><path%20fill-rule='evenodd'%20clip-rule='evenodd'%20d='M8.53547%200.62293C8.88226%200.849446%208.97976%201.3142%208.75325%201.66099L4.5083%208.1599C4.38833%208.34356%204.19397%208.4655%203.9764%208.49358C3.75883%208.52167%203.53987%208.45309%203.3772%208.30591L0.616113%205.80777C0.308959%205.52987%200.285246%205.05559%200.563148%204.74844C0.84105%204.44128%201.31533%204.41757%201.62249%204.69547L3.73256%206.60459L7.49741%200.840706C7.72393%200.493916%208.18868%200.396414%208.53547%200.62293Z'/></svg>");
        mask-image: url("data:image/svg+xml,<svg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%209%209'><path%20fill-rule='evenodd'%20clip-rule='evenodd'%20d='M8.53547%200.62293C8.88226%200.849446%208.97976%201.3142%208.75325%201.66099L4.5083%208.1599C4.38833%208.34356%204.19397%208.4655%203.9764%208.49358C3.75883%208.52167%203.53987%208.45309%203.3772%208.30591L0.616113%205.80777C0.308959%205.52987%200.285246%205.05559%200.563148%204.74844C0.84105%204.44128%201.31533%204.41757%201.62249%204.69547L3.73256%206.60459L7.49741%200.840706C7.72393%200.493916%208.18868%200.396414%208.53547%200.62293Z'/></svg>");
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-size: contain;
        mask-size: contain;
        transition: color 120ms ease;
      }
      .check:checked::after { color: #0b0c0f; }
      .check:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      .pill {
        display: inline-block;
        padding: 2px 9px;
        border-radius: 999px;
        font-size: 0.75rem;
        border: 1px solid var(--border);
        color: var(--muted);
      }
      /* "not set up" broke over three lines the moment the column was narrow. */
      .pill { white-space: nowrap; }
      .pill.active { color: var(--ok); border-color: rgba(111, 207, 151, 0.4); }
      .pill.pending { color: #e2b93b; border-color: rgba(226, 185, 59, 0.4); }
      /* 4.05:1 on --accent, 4.87:1 on the lighter step, and 12px text wants
         4.5. The border stays the base indigo: a 1px edge is a boundary, which
         is held to 3:1, and it already clears that. */
      .pill.organizer { color: var(--accent-hover); border-color: rgba(94, 106, 210, 0.4); }
      /* Distinct from organizer, because the difference is the whole point:
         one of these can delete a founder and the other cannot. */
      .pill.mentor { color: #38bdf8; border-color: rgba(56, 189, 248, 0.4); }
      .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }
      /* A form row directly after the panel's explanatory copy had no gap at
         all: .note ends with margin-bottom 0 and the first field label starts
         immediately, so the uppercase label read as another line of the
         paragraph. */
      .note + .row,
      .note + .field,
      .note + label { margin-top: 16px; }
      label { display: block; }
      /* The date picker is not a <label>: it wraps a button, and a label
         wrapping a button swallows the click on some browsers. */
      .field { display: block; }
      .label-text {
        display: block;
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
      }
      input, select, textarea {
        padding: 10px 12px;
        border-radius: 9px;
        border: 1px solid var(--border);
        background: rgba(0, 0, 0, 0.35);
        color: var(--text);
        font-family: var(--font);
        font-size: 0.9375rem;
      }
      textarea { width: 100%; min-height: 120px; resize: vertical; line-height: 1.5; }
      /* A working measure for anything you type into. The panels are as wide
         as the page now; the fields inside them are not. */
      input, select, textarea { max-width: 760px; }
      input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); }
      /*
         Buttons are ink, not accent.
         
         This was a blanket accent fill, which was fine while the accent was
         blue. Once it became signal red, every button on the page, "Add
         deadline" and "Save" included, became a solid alarm-coloured control.
         Red is left to the two things that deserve it: the section nav's active
         pill, and destructive actions via button.ghost.danger.
      */
      /* ── Buttons ──
         Two tiers, and they are told apart by material rather than by colour.

         The primary is brushed metal: a fixed gradient of greys that drifts
         across the face on hover. The supplied component drives that surface
         with a WebGL shader from @paper-design/shaders and animates it
         permanently at speed 0.6. Neither is here. The dependency is a
         renderer plus a shader bundle for one button, and a metal face that
         never stops moving is the loudest thing on a page that also holds
         seven tabs and twenty rows. A background-position transition on a
         multi-stop gradient gives the same sweep, costs nothing, and only runs
         when the pointer is on it.

         The secondary is the glass one: no fill at all, just a rim built from
         layered inset shadows and the page's own background refracted through
         the filter below. Carried over from the supplied component almost
         unchanged, since that shadow stack is the whole component.

         No red in either. The accent still marks state — focus, danger, the
         current tab — where it means something. */
      /* Scoped to bare buttons. Every styled control on this page carries a
         class of its own — the tabs, the quick menu, the date picker, .ghost —
         and none of them set box-shadow, so an unscoped `button` rule would
         hang the metal rim on all of them. This way the rule maintains itself:
         give a button a class and it opts out. */
      button:not([class]) {
        position: relative;
        padding: 10px 20px;
        border: 0;
        border-radius: 999px;
        color: #14151a;
        font-family: var(--font);
        font-size: 0.9375rem;
        font-weight: 600;
        cursor: pointer;
        background: linear-gradient(
          104deg,
          #6e737d 0%, #b9bec7 12%, #f2f4f7 22%, #9aa0aa 34%,
          #d7dbe1 46%, #7c828c 58%, #eef0f4 70%, #a7adb7 82%, #6e737d 100%
        );
        /* Wider than the button, so there is somewhere for the sweep to go. */
        background-size: 220% 100%;
        background-position: 0% 50%;
        box-shadow:
          0 0 0 1px rgba(0, 0, 0, 0.5),
          inset 0 1px 0 rgba(255, 255, 255, 0.5),
          inset 0 -1px 0 rgba(0, 0, 0, 0.3),
          0 9px 9px rgba(0, 0, 0, 0.12),
          0 2px 5px rgba(0, 0, 0, 0.15);
        transition:
          background-position 700ms cubic-bezier(0.22, 1, 0.36, 1),
          transform 140ms ease,
          box-shadow 140ms ease;
      }
      button:not([class]):hover:not(:disabled) { background-position: 100% 50%; }
      button:not([class]):active:not(:disabled) {
        transform: translateY(1px) scale(0.985);
        box-shadow:
          0 0 0 1px rgba(0, 0, 0, 0.55),
          inset 0 2px 4px rgba(0, 0, 0, 0.35),
          0 1px 2px rgba(0, 0, 0, 0.3);
      }
      button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

      button.ghost {
        background: none;
        color: var(--text);
        border: 0;
        /* The rim in the shadow stack is a full pill; a smaller radius leaves
           the highlight tracing corners the button does not have. */
        border-radius: 999px;
        padding: 7px 15px;
        font-size: 0.8125rem;
        font-weight: 500;
        /* The page behind it, bent. Its own id: SVG filter ids are global to
           the document, and the founder side already defines two others. */
        backdrop-filter: url("#admin-glass");
        -webkit-backdrop-filter: url("#admin-glass");
        box-shadow:
          0 0 8px rgba(0, 0, 0, 0.03),
          0 2px 6px rgba(0, 0, 0, 0.08),
          inset 3px 3px 0.5px -3.5px rgba(255, 255, 255, 0.09),
          inset -3px -3px 0.5px -3.5px rgba(255, 255, 255, 0.85),
          inset 1px 1px 1px -0.5px rgba(255, 255, 255, 0.6),
          inset -1px -1px 1px -0.5px rgba(255, 255, 255, 0.6),
          inset 0 0 6px 6px rgba(255, 255, 255, 0.12),
          inset 0 0 2px 2px rgba(255, 255, 255, 0.06),
          0 0 12px rgba(0, 0, 0, 0.15);
        transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), color 160ms ease;
      }
      button.ghost:hover { transform: scale(1.05); }
      button.ghost:active { transform: scale(0.98); }
      /* Danger stays red on hover. That is the status palette doing its job,
         not decoration, and it is the only warning on a Remove button. */
      button.ghost.danger:hover { color: var(--danger); }
      button:disabled { opacity: 0.5; cursor: default; }

      @media (prefers-reduced-motion: reduce) {
        button:not([class]), button.ghost { transition: none; }
        button:not([class]):hover:not(:disabled) { background-position: 0% 50%; }
        button.ghost:hover, button.ghost:active { transform: none; }
      }
      .links { margin-top: 20px; }
      .deadline-row {
        border-top: 1px solid var(--border);
        padding: 12px 0;
      }
      .deadline-row.archived { opacity: 0.5; }
      .deadline-head {
        display: flex;
        align-items: baseline;
        gap: 12px;
        flex-wrap: wrap;
      }
      .deadline-head strong { flex: 1 1 220px; }
      .deadline-meta { color: var(--muted); font-size: 13px; }
      .deadline-count {
        font-size: 12.5px;
        font-variant-numeric: tabular-nums;
        color: var(--muted);
        white-space: nowrap;
      }
      .deadline-count.all-done { color: var(--accent); font-weight: 700; }
      .deadline-row details { margin-top: 6px; }
      .deadline-row summary {
        cursor: pointer;
        font-size: 13px;
        color: var(--muted);
        min-height: 32px;
        display: flex;
        align-items: center;
      }
      .deadline-actions { margin-top: 8px; }
      /* ── The library table ──
         This was a stack of divs: the borrower's name, the due date and five
         buttons all set as body text on one wrapping line, with the whole row
         hanging off a `border-top: 1px solid var(--line)` — a token this page
         has never defined, so the rule separating the books was invisible.

         It is the people table's shape now, because it is the same kind of
         list and the operating team reads the two back to back: an avatar
         cell, a status pill, one column per fact. */
      .pill.shelf { color: var(--ok); border-color: rgba(76, 183, 130, 0.4); }
      .pill.late { color: var(--danger); border-color: rgba(235, 87, 87, 0.45); }
      /* Unaccounted was red here, and the comment that set it said so on
         purpose: a book whose borrower's account is gone is not a mild
         problem. It is amber now for one reason only — overdue is red, and in
         a table the two sat in the same column looking identical, which is
         the one thing a status colour must not do. Different response, so
         different colour: red is somebody to chase, amber is a shelf to go
         and look at. Flip it back if the severity matters more than the
         distinction. */
      .pill.unaccounted { color: var(--warn); border-color: rgba(242, 201, 76, 0.4); }

      .bk-row.archived { opacity: 0.55; }
      /* Wraps rather than clips: this line carries the author and the shelf
         note, and an ellipsis on it hid the note entirely with nothing to
         click to get it back. */
      .bk-sub { font-size: 0.8125rem; color: var(--muted); overflow-wrap: anywhere; }
      .bk-due { font-size: 0.8125rem; font-variant-numeric: tabular-nums; color: var(--muted); white-space: nowrap; }
      .bk-due.late { color: var(--danger); font-weight: 600; }

      /* Loan history stays folded inside the book cell rather than taking a
         column of its own: it is the one thing here nobody reads until they
         are already asking about a specific book. */
      .bk-note { margin-top: 4px; }
      .bk-note summary {
        cursor: pointer; font-size: 0.75rem; color: var(--muted); list-style: none;
        /* Every disclosure on this page is a tap target, and 0.75rem of text
           on its own is about 15px tall. WCAG 2.2 asks 24. */
        display: inline-flex; align-items: center; min-height: 24px;
      }
      .bk-note summary::-webkit-details-marker { display: none; }
      .bk-note summary::before { content: "\25b8  "; }
      .bk-note[open] summary::before { content: "\25be  "; }
      .bk-note summary:hover { color: var(--sub); }
      .bk-note summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 3px; }
      .bk-note-body {
        margin-top: 4px; font-size: 0.75rem; line-height: 1.5;
        color: var(--muted); overflow-wrap: anywhere;
      }

      .bk-history { margin-top: 5px; }
      .bk-history summary { cursor: pointer; font-size: 0.75rem; color: var(--muted); list-style: none; display: inline-flex; align-items: center; min-height: 24px; }
      .bk-history summary::-webkit-details-marker { display: none; }
      .bk-history summary::before { content: "\25b8  "; }
      .bk-history[open] summary::before { content: "\25be  "; }
      .bk-history ul { margin: 6px 0 0; padding-left: 15px; font-size: 0.75rem; color: var(--muted); }
      .bk-history li { margin-bottom: 3px; }

      /* The shelf in four numbers, above the table. An organizer opens this tab
         to answer "is anything wrong", and that used to mean reading every row. */
      .bk-summary {
        display: flex; gap: 6px 22px; flex-wrap: wrap;
        margin: 18px 0 16px; font-size: 0.875rem; color: var(--muted);
      }
      .bk-summary strong { color: var(--text); font-variant-numeric: tabular-nums; }
      .bk-summary .is-late strong { color: var(--danger); }
      .bk-summary .is-lost strong { color: var(--warn); }

      /* Fixed proportions. Without them the browser gave the title column
         every spare pixel and left the due date stranded a third of a screen
         from the buttons that act on it. */
      /* Bounded to the wide layout on purpose. Below 700px the panel's rows
         become blocks, and an id-qualified width beats the `width: 100%` that
         does it — which left every title wrapping one word per line. */
      @media (min-width: 701px) {
        #library-list th:nth-child(1), #library-list td:nth-child(1) { width: 38%; }
        #library-list th:nth-child(2), #library-list td:nth-child(2) { width: 18%; }
        #library-list th:nth-child(3), #library-list td:nth-child(3) { width: 12%; }
      }
      .bk-actions { display: flex; gap: 4px; justify-content: flex-end; flex-wrap: wrap; }

      /* The page had no visually-hidden class; the library table is the first
         thing here to need one, for a column heading that would be noise on
         screen and a missing label off it. */
      .sr-only {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
      }
      .link-item {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px 14px;
        margin-bottom: 10px;
        display: flex;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
      }
      .link-item code {
        font-size: 0.75rem;
        color: var(--muted);
        word-break: break-all;
        flex: 1 1 320px;
      }
      .note { color: var(--muted); font-size: 0.8125rem; line-height: 1.6; margin: 14px 0 0; max-width: 82ch; }
      .message { font-size: 0.875rem; margin-top: 14px; }
      .message.error { color: var(--danger); }
      .message.ok { color: var(--ok); }
      /* ---- Broadcast ---------------------------------------------- */
      .inline { display: inline-flex; align-items: center; gap: 8px; min-height: 24px; }
      .bc-tag {
        font-family: inherit;
        font-size: 0.75rem;
        padding: 2px 8px;
        margin-right: 4px;
        /* 23px on padding alone, a pixel under the 24 minimum. */
        min-height: 24px;
      }
      /* Scrolls rather than growing without limit: the point of the individual
         picker is to glance at it, and a list that pushes the Send button off
         the page is how the wrong people get selected. */
      .bc-people {
        max-height: 260px;
        overflow-y: auto;
        margin-top: 10px;
        display: grid;
        gap: 6px;
      }
      .bc-people label { display: flex; align-items: center; gap: 8px; font-size: 0.875rem; min-height: 24px; }
      /* The recipient disclosure and the three role checkboxes: the label is
         the target, not the 16px box inside it, and the label was 22px. */
      #tab-broadcast summary { min-height: 24px; display: flex; align-items: center; }
      .bc-people .role { color: var(--muted); font-size: 0.75rem; }
      .bc-sent { font-size: 0.875rem; padding: 8px 0; border-bottom: 1px solid var(--border); }
      .bc-sent .when { color: var(--muted); font-size: 0.75rem; }
      [hidden] { display: none !important; }
      a { color: var(--accent); }
      /* The page's own title stands in for the wordmark here, so the lockup
         is built against it. */
      .title-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
      .title-row h1 { margin: 0; }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        /* 44px is the smallest reliable touch target, and this is the control
           somebody reaches for when they are stuck on the wrong page. */
        min-height: 44px;
        margin: 0 0 6px;
        color: var(--muted);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
      }
      .back-link:hover { color: var(--accent); text-decoration: underline; }
      .back-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }

      /* Tabs. One area visible at a time so the page height stays constant
         however much knowledge is loaded. */
      /* ---- Section nav ------------------------------------------------------
         A floating pill: every section is an icon, and only the open one shows
         its name, sliding out beside the icon.

         Built from the page's own tokens and CSS transitions rather than the
         supplied React component, which wanted Tailwind, shadcn's cn() and
         framer-motion. This page is Astro with a hand-written stylesheet and no
         React at all, and the whole animation is one width transition.

         Every tab keeps a title and an aria-label, because an icon is not a
         name. */
      /* ── Tabs ──
         A pill that follows the pointer and settles back on the open tab when
         it leaves.

         Deliberately not in the app's red. The whole trick is
         mix-blend-difference: one white pill under the labels, and every label
         it covers inverts to black by itself. There is no second colour to pick
         and no selected-versus-hovered state to keep in sync, which is what
         keeps it minimal. A coloured pill would need its own contrasting text
         colour and the effect would be gone. */
      .tabs {
        position: relative;
        display: inline-flex;
        align-items: center;
        margin: 0 0 26px;
        padding: 5px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 999px;
        background: #0b0c0f;
        /* Contains the blending. Without it the labels blend against whatever
           the page paints behind the bar rather than against the bar. */
        isolation: isolate;
        max-width: 100%;
        overflow-x: auto;
        scrollbar-width: none;
      }
      .tabs::-webkit-scrollbar { display: none; }

      /* Only when something is past the edge, so a bar that fits is untouched. */
      .tabs.is-scrollable {
        -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 34px), transparent 100%);
        mask-image: linear-gradient(to right, #000 calc(100% - 34px), transparent 100%);
      }

      .tab-cursor {
        position: absolute;
        top: 5px;
        left: 0;
        height: 34px;
        border-radius: 999px;
        background: #fff;
        /* Starts hidden and is shown once placed, or the first frame draws a
           zero-width white dot in the corner. */
        opacity: 0;
        pointer-events: none;
        transition:
          transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
          width 300ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 160ms ease;
      }

      .tab {
        position: relative;
        z-index: 1;
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 34px;
        padding: 0 15px;
        border: none;
        border-radius: 999px;
        background: transparent;
        /* White over the dark bar, inverted to black over the pill. That is
           the entire selected state. */
        color: #fff;
        mix-blend-mode: difference;
        font-family: inherit;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        white-space: nowrap;
        cursor: pointer;
      }
      /* The ring must not blend, or it inverts with the label and vanishes
         over the pill. */
      .tab:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
        mix-blend-mode: normal;
      }

      @media (prefers-reduced-motion: reduce) {
        .tab-cursor { transition: opacity 160ms ease; }
      }

      .row-actions { text-align: right; }

      /* ── Phone ──
         The people table is five columns wide and the last one holds the only
         buttons on the row. At 390px it ran off the side of the screen, so
         "New link" and "Remove" were simply unreachable — you could read the
         cohort on a phone and do nothing to it.

         Each row becomes a block instead. No JS change: the rows are built in
         script and this only re-lays what is already there. */
      @media (max-width: 700px) {
        .panel table, .panel tbody, .panel tr, .panel td { display: block; width: 100%; }
        .panel thead { display: none; }
        .panel tr { border-top: 1px solid var(--border); padding: 12px 0; }
        .panel td { border: 0; padding: 3px 0; }
        .row-actions { text-align: left; margin-top: 10px; }
        .bk-actions { justify-content: flex-start; margin-top: 10px; }
        /* Clear of the quick-actions trigger, which is fixed to this corner
           and otherwise sits on top of the last row. */
        main { padding-bottom: 96px; }
      }

      /* The mentor page's lists: a name, and why it is on the list. The
         second half is the whole value — a column of names is a grid with
         extra steps. */
      .mentor-list { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 10px; }
      .mentor-list li {
        display: flex;
        align-items: baseline;
        gap: 12px;
        flex-wrap: wrap;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border);
        font-size: 0.9375rem;
      }
      .mentor-list li:last-child { border-bottom: 0; padding-bottom: 0; }
      .mentor-list span { color: var(--muted); font-size: 0.875rem; }

      /* Long lists scroll inside their own box rather than growing the page. */
      .scroller {
        max-height: 52vh;
        overflow-y: auto;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 4px 12px;
      }
      .rowline {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px solid var(--border);
      }
      .rowline:last-child { border-bottom: none; }
      .rowline .grow {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .disclose {
        background: transparent;
        border: none;
        color: var(--muted);
        cursor: pointer;
        font-family: inherit;
        font-size: 0.8125rem;
        padding: 4px 8px;
      }
      .expanded { padding: 0 0 12px 26px; }
      .expanded textarea, .expanded input { width: 100%; }
      .flagged { color: #f7768e; font-size: 0.75rem; margin: 4px 0 0 26px; }

      /* The action bar sits above a long review list, not after it. */
      .stickybar {
        position: sticky;
        top: 0;
        z-index: 2;
        background: var(--panel);
        padding: 10px 0;
        border-bottom: 1px solid var(--border);
        margin-bottom: 8px;
      }

      /* ── Date picker ──
         Ported from a supplied shadcn dropdown range picker. Single date, not
         a range: the one calendar field in this app is a deadline's due date.
         Month and year are dropdowns rather than arrow-paging, which is the
         part of that component worth having: the sprint runs into December
         and paging one month at a time to reach it is four clicks. */
      .datepicker { position: relative; }
      .dp-trigger {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-width: 15rem;
        min-height: 40px;
        padding: 9px 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: rgba(10, 11, 14, 0.7);
        color: var(--text);
        font: inherit;
        font-size: 0.9375rem;
        text-align: left;
        cursor: pointer;
      }
      .dp-trigger:hover { border-color: rgba(255, 255, 255, 0.24); }
      .dp-trigger:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .dp-icon {
        flex: 0 0 auto;
        width: 16px;
        height: 16px;
        fill: none;
        stroke: var(--muted);
        stroke-width: 1.6;
        stroke-linecap: round;
      }
      /* Until a date is chosen the trigger is showing placeholder text, so it
         reads as muted rather than as a value. */
      .dp-trigger[data-empty="true"] .dp-value { color: var(--muted); }

      .dp-pop {
        position: absolute;
        z-index: 60;
        top: calc(100% + 6px);
        left: 0;
        width: max-content;
        padding: 14px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #14161b;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
      }
      .dp-pop[hidden] { display: none; }
      /* Near the right edge the popover would otherwise run off the page. */
      .dp-pop[data-align="right"] { left: auto; right: 0; }

      .dp-selects { display: flex; gap: 8px; margin-bottom: 12px; }
      .dp-selects select {
        min-height: 36px;
        padding: 6px 8px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: rgba(10, 11, 14, 0.7);
        color: var(--text);
        font: inherit;
        font-size: 0.875rem;
      }
      .dp-selects select:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }

      .dp-grid {
        display: grid;
        grid-template-columns: repeat(7, 2.25rem);
        gap: 2px;
      }
      .dp-weekday {
        display: grid;
        place-items: center;
        height: 1.75rem;
        color: var(--muted);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .dp-day {
        position: relative;
        height: 2.25rem;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: var(--text);
        font: inherit;
        font-size: 0.875rem;
        cursor: pointer;
      }
      .dp-day:hover { background: rgba(255, 255, 255, 0.08); }
      .dp-day:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }
      .dp-day[data-outside="true"] { color: rgba(244, 244, 245, 0.3); }
      .dp-day[data-selected="true"] {
        background: var(--accent);
        color: #fff;
        font-weight: 700;
      }
      /* Today gets a dot rather than a ring, so it never reads as selected. */
      .dp-day[data-today="true"]::after {
        content: "";
        position: absolute;
        bottom: 5px;
        left: 50%;
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: var(--accent);
        transform: translateX(-50%);
      }
      .dp-day[data-today="true"][data-selected="true"]::after { background: #fff; }

      .dp-foot {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid var(--border);
      }
      .dp-foot button {
        min-height: 34px;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.8125rem;
      }
      .dp-clear {
        border: 1px solid var(--border);
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 0.8125rem;
        cursor: pointer;
      }
      .dp-clear:hover:not(:disabled) { color: var(--text); }
      .dp-clear:disabled { opacity: 0.45; cursor: default; }
      .dp-today {
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text);
        font: inherit;
        font-size: 0.8125rem;
        cursor: pointer;
      }
      .dp-today:hover { border-color: rgba(255, 255, 255, 0.24); }

      /* ── Wishes ── */
  .tab-badge {
    display: inline-block; margin-left: 6px; padding: 0 6px;
    border-radius: 999px; background: var(--accent); color: #fff;
    font-size: 0.6875rem; font-weight: 700; line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  .wish {
    padding: 14px 0; border-top: 1px solid var(--border);
  }
  .wish.is-answered { opacity: 0.62; }
  .wish.is-answered:hover { opacity: 1; }
  .wish-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }
  .wish-from { font-weight: 700; font-size: 0.9375rem; }
  .wish-to, .wish-when { font-size: 0.8125rem; color: var(--muted); }
  .wish-status {
    margin-left: auto; padding: 1px 8px; border-radius: 999px;
    border: 1px solid var(--border-strong);
    font-size: 0.6875rem; font-weight: 600; color: var(--muted);
  }
  .wish.is-answered .wish-status { border-color: rgba(124,184,147,0.5); color: #7CB893; }
  .wish-body {
    margin: 0; max-width: 68ch;
    font-size: 0.9375rem; line-height: 1.55; white-space: pre-wrap;
  }
  /* Bug reports: the same list shape as a wish, with a status control where
     the reply box would be. */
  .bug-row { padding: 14px 0; border-bottom: 1px solid var(--border); }
  .bug-row.is-closed { opacity: 0.55; }
  .bug-row.is-closed:hover { opacity: 1; }
  .bug-rowhead { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .bug-when {
    flex: 1; color: var(--muted); font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .bug-status { min-height: 32px; padding: 4px 8px; font-size: 0.8125rem; }
  .bug-text {
    margin: 8px 0 0; font-size: 0.9375rem; line-height: 1.55;
    white-space: pre-wrap; overflow-wrap: anywhere;
  }
  .bug-context { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  /* Allowed to wrap and run long: a user-agent string truncated in the middle
     loses the part that says which browser it is. */
  .bug-meta {
    padding: 2px 8px; border-radius: 6px;
    border: 1px solid var(--border); background: rgba(255,255,255,0.02);
    color: var(--muted); font-size: 0.6875rem; line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .wish-reply {
    margin-top: 10px; padding-left: 14px;
    border-left: 2px solid var(--accent);
  }
  .wish-replyhead { margin: 0 0 2px; font-size: 0.75rem; font-weight: 700; }
  .wish-replybox { display: flex; gap: 8px; align-items: flex-start; margin-top: 10px; }
  .wish-replybox textarea { flex: 1 1 auto; min-height: 40px; }
  .wish-replybox button { flex: 0 0 auto; }
  @media (max-width: 620px) {
    .wish-replybox { flex-direction: column; }
    .wish-replybox button { width: 100%; }
  }

  /* ── Programme events ── */
  .ev-month {
    /* Sticky, with a ground of its own: the rows scroll under it, and without
       an opaque background they show through it. */
    position: sticky; top: 0; z-index: 1;
    margin: 22px 0 8px; padding: 6px 4px;
    background: var(--panel);
    font-size: 0.75rem; font-weight: 700;
    letter-spacing: 0.07em; text-transform: uppercase;
    color: var(--muted);
  }
  .ev-earlier { margin-bottom: 6px; font-size: 0.75rem; }

  /* The row being edited, and the form that drops in under it. */
  .ev-row.is-editing, .pr-row.is-editing, .deadline-row.is-editing { background: rgba(255, 255, 255, 0.04); }
  .ev-edit, .pr-edit, .dl-edit {
    padding: 14px 12px 4px;
    border-bottom: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    background: rgba(255, 255, 255, 0.02);
  }

  /* Week themes: the same shape as an event row, so the two lists read alike. */
  .pr-row {
    display: grid;
    grid-template-columns: 74px 1fr auto auto;
    align-items: baseline; gap: 12px;
    padding: 9px 4px;
    border-bottom: 1px solid var(--border);
    font-size: 0.875rem;
  }
  .pr-row.is-empty { opacity: 0.55; }
  .pr-row.is-empty:hover { opacity: 1; }
  .pr-heading { min-width: 0; overflow-wrap: anywhere; }
  .pr-unset { color: var(--muted); font-style: normal; }
  .pr-counts { color: var(--muted); font-size: 0.8125rem; white-space: nowrap; }
  .pr-actions { display: flex; gap: 6px; }
  .pr-actions button { padding: 3px 10px; font-size: 0.75rem; min-height: 28px; }
  @media (max-width: 760px) {
    .pr-row { grid-template-columns: 74px 1fr; gap: 4px 12px; }
    .pr-counts, .pr-actions { grid-column: 1 / -1; }
    .pr-actions { margin-top: 4px; }
  }
  .ev-row {
    display: grid;
    grid-template-columns: 52px 92px 1fr auto auto;
    align-items: baseline; gap: 12px;
    padding: 9px 4px;
    border-bottom: 1px solid var(--border);
    font-size: 0.875rem;
  }
  .ev-row.is-past { opacity: 0.5; }
  .ev-date { font-weight: 700; font-variant-numeric: tabular-nums; }
  .ev-time { color: var(--muted); font-variant-numeric: tabular-nums; }
  .ev-title { min-width: 0; }
  .ev-loc { color: var(--muted); }
  .ev-kind {
    padding: 1px 8px; border-radius: 999px;
    border: 1px solid var(--border-strong);
    font-size: 0.6875rem; font-weight: 600; color: var(--muted);
    white-space: nowrap;
  }
  .ev-actions { display: flex; gap: 6px; }
  /* min-height, because the padding alone left these at 21px in the week
     list and exactly 24px in this one — the floor WCAG 2.2 sets, with nothing
     spare. Both lists are dense and read side by side; they get the same. */
  .ev-actions button { padding: 3px 10px; font-size: 0.75rem; min-height: 28px; }
  @media (max-width: 760px) {
    /* The five-column grid gives the title about eight characters here. */
    .ev-row { grid-template-columns: 52px 1fr; gap: 4px 12px; }
    .ev-time { grid-column: 2; }
    .ev-title, .ev-kind, .ev-actions { grid-column: 1 / -1; }
    .ev-actions { margin-top: 4px; }
  }

</style>
  </head>
  <body>
    <main>
      <!-- The only way back used to be editing the URL. -->
      <!-- Straight into the founder view rather than back to the dashboard,
           so a change to a deadline or the week can be checked without
           signing out of one account and into another. -->
      <a class="back-link" href="/?view=cohort" style="margin-right:18px">
        <span aria-hidden="true">&#9673;</span>
        See the cohort view
      </a>
      <a class="back-link" href="/">
        <span aria-hidden="true">&#8592;</span> Back to Sprint Buddy
      </a>
      <div class="title-row">
        <h1>Cohort admin</h1>
        {/* The rule lives inside the mark, so it goes when the mark goes. */}
        <AaltoMark />
      </div>
      <p class="lede" id="lede">Loading…</p>

      <div id="denied" hidden>
        <div class="panel">
          <h2>Organizers only</h2>
          <p class="note">
            This page is for the Sprint operating team. <a href="/">Go back to Sprint Buddy</a>.
          </p>
        </div>
      </div>

      <div id="app" hidden>
        <!-- One area at a time. Eight stacked panels plus a review list plus a
             hundred knowledge entries made this page something you scrolled
             through to find anything. The sections all stay in the DOM and are
             only shown or hidden, so the inline script below keeps working
             unchanged — every getElementById still resolves. -->
        <nav class="tabs" id="tabs" aria-label="Admin sections">
          <!-- One pill, moved and resized by script, sitting under the
               labels. No tab carries a background of its own. -->
          <span class="tab-cursor" id="tab-cursor" aria-hidden="true"></span>
          <button type="button" class="tab" data-tab="programme">Programme</button>
          <button type="button" class="tab" data-tab="weeks">Week themes</button>
          <button type="button" class="tab" data-tab="mentor">This week</button>
          <button type="button" class="tab" data-tab="wishes">Wishes<span id="wish-badge" class="tab-badge" hidden></span></button>
          <button type="button" class="tab" data-tab="bugs">Bugs<span id="bug-badge" class="tab-badge" hidden></span></button>
          <button type="button" class="tab" data-tab="people">People</button>
          <button type="button" class="tab" data-tab="deadlines">Deadlines</button>
          <button type="button" class="tab" data-tab="shared">Shared</button>
          <button type="button" class="tab" data-tab="broadcast">Broadcast</button>
          <button type="button" class="tab" data-tab="knowledge">Knowledge</button>
          <button type="button" class="tab" data-tab="transcript">Transcript</button>
          <button type="button" class="tab" data-tab="library">Library</button>
        </nav>

        <!--
          The mentor's page.

          Everything else on this screen is for running the cohort: adding
          people, setting deadlines, sending mail. A mentor does none of that,
          and a mentor who opens an operating console finds nothing addressed
          to them and does not come back.

          So this is the first tab, and it answers one question — who should I
          talk to, and about what. It reads the same endpoints the rest of the
          page already uses and writes nothing at all.
        -->
        <div class="tabpanel" id="tab-mentor" hidden>
          <div id="mentor-view">
            <p class="note" style="margin-top:0">Reading the week…</p>
          </div>
        </div>

        <div class="tabpanel" id="tab-people" hidden>
        <section class="panel">
          <h2>People</h2>
          <table>
            <thead>
              <tr>
                <th>Member</th><th>Role</th><th>Status</th><th></th>
              </tr>
            </thead>
            <tbody id="users"></tbody>
          </table>
        </section>

        <section class="panel">
          <h2>Add one person</h2>
          <form id="add-one" class="row">
            <label>
              <span class="label-text">Full name</span>
              <input id="add-name" required placeholder="Aino Virtanen" />
            </label>
            <label>
              <span class="label-text">Email</span>
              <input id="add-email" type="email" required placeholder="aino@example.com" />
            </label>
            <label>
              <span class="label-text">Role</span>
              <select id="add-role">
                <option value="founder">Founder</option>
                <option value="organizer">Organizer</option>
                <!-- Reads the cohort and the shared conversations; runs
                     nothing. For a mentor who wants the dashboard without the
                     authority to delete a founder. -->
                <option value="mentor">Mentor (read only)</option>
              </select>
            </label>
            <button type="submit">Add and create link</button>
          </form>
          <p class="message" id="add-message" hidden></p>
        </section>

        <section class="panel">
          <h2>Add the whole cohort</h2>
          <p class="note" style="margin-top:0">
            One person per line, as <strong>Name, email</strong>. Everyone added here is a
            founder. Add the operating team individually above.
          </p>
          <form id="add-bulk">
            <textarea
              id="bulk-text"
              placeholder="Aino Virtanen, aino@example.com&#10;Elias Koskinen, elias@example.com"
            ></textarea>
            <div style="margin-top:12px"><button type="submit">Add everyone</button></div>
          </form>
          <p class="message" id="bulk-message" hidden></p>
        </section>

        <section class="panel" id="links-panel" hidden>
          <h2>Setup links sent</h2>
          <p class="note" style="margin-top:0">
            Each link is emailed straight to that person's own address. You never see it,
            and neither does anyone else on the team. A setup link is as good as a
            password, so whoever holds it can claim the account. Each works once and
            expires after 14 days. If someone says it never arrived, use
            <strong>Resend link</strong> on their row.
          </p>
          <div class="links" id="links"></div>
        </section>
        </div>

        <div class="tabpanel" id="tab-deadlines" hidden>
        <section class="panel">
          <h2>Deadlines</h2>
          <p class="note" style="margin-top:0">
