        <div class="tabpanel" id="tab-transcript" hidden>
          <section class="panel">
            <h2>Add knowledge from a transcript</h2>
            <p class="note" style="margin-top:0">
              Paste a mentor session. It is read in pieces and comes back as
              draft entries for you to approve — nothing reaches Sprint Buddy
              until you tick it and add it. The transcript itself is never
              stored, only the entries you keep.
            </p>
            <p class="note" style="margin-top:0">
              Entries come back with no names in them: not the speaker's, not
              their company's. What the session teaches becomes the programme's
              position. Anything about a founder or their company is left out
              entirely. If a name slips through, the draft is flagged.
            </p>

            <form id="ingest-form" class="row">
              <label>
                <span class="label-text">Whose session (for your records only)</span>
                <input id="ingest-source" maxlength="120" placeholder="Mentor session, 12 Sept" required />
              </label>
              <label style="flex:1 1 100%">
                <span class="label-text">Transcript</span>
                <textarea id="ingest-text" rows="8" placeholder="Paste the whole session. Long ones are split automatically."></textarea>
              </label>
              <button type="submit" id="ingest-go">Read it</button>
              <button type="button" id="ingest-cancel" hidden>Stop</button>
            </form>
            <p class="message" id="ingest-message" hidden></p>

            <div id="ingest-review"></div>
          </section>
        </div>
      </div>
    </main>

    <script is:inline>
      const lede = document.getElementById("lede");
      const app = document.getElementById("app");
      const denied = document.getElementById("denied");
      const usersBody = document.getElementById("users");
      const linksPanel = document.getElementById("links-panel");
      const linksBox = document.getElementById("links");
      let me = null;

      // Entry text originates in a pasted transcript by way of the model, so it
      // reaches this page as untrusted content and must never be parsed as
      // markup on the way into the DOM.
      function esc(value) {
        return String(value == null ? "" : value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      // ---- Tabs ---------------------------------------------------------
      //
      // Show/hide only. Every section stays in the DOM so the rest of this
      // script keeps working without knowing tabs exist.

      const TAB_KEY = "sprintbuddy.admin.tab";
      function showTab(slug) {
        const panels = document.querySelectorAll(".tabpanel");
        let matched = false;
        panels.forEach((panel) => {
          const on = panel.id === "tab-" + slug;
          panel.hidden = !on;
          if (on) matched = true;
        });
        if (!matched && panels.length) {
          // A stored tab that no longer exists must not leave a blank page.
          panels[0].hidden = false;
          slug = panels[0].id.replace(/^tab-/, "");
        }
        document.querySelectorAll(".tab").forEach((button) => {
          button.setAttribute("aria-selected", String(button.dataset.tab === slug));
        });
        try { localStorage.setItem(TAB_KEY, slug); } catch { /* private mode */ }
      }

      document.querySelectorAll(".tab").forEach((button) => {
        button.addEventListener("click", () => showTab(button.dataset.tab));
      });

      let storedTab = "people";
      try { storedTab = localStorage.getItem(TAB_KEY) || "people"; } catch { /* private mode */ }
      showTab(storedTab);

      function say(el, text, isError) {
        el.textContent = text;
        el.className = "message " + (isError ? "error" : "ok");
        el.hidden = false;
      }

      async function api(body) {
        // Never assume a body is JSON. A server error can return an empty
        // body, and `await res.json()` then throws before the caller can read
        // an error message — which is why a failed removal used to leave the
        // button disabled with nothing shown at all.
        let res;
        try {
          res = await fetch("/api/admin/users", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
        } catch {
          return { ok: false, data: { error: "Could not reach the server. Check your connection." } };
        }
        let data = {};
        try {
          data = await res.json();
        } catch {
          data = { error: `The server returned an error (${res.status}) with no details.` };
        }
        return { ok: res.ok, data };
      }

      /*
       * Records that a link was emailed. The link itself is deliberately not
       * shown here and is not in the response: it goes to the founder's own
       * address and nowhere else, so that nobody on the operating team can
       * redeem it and sign in as them.
       */
      function addLink(name, email) {
        linksPanel.hidden = false;
        const item = document.createElement("div");
        item.className = "link-item";

        const who = document.createElement("strong");
        who.textContent = name ? name + " · " + email : email;
        who.style.flex = "1 1 180px";

        const status = document.createElement("span");
        status.textContent = "Setup link emailed";
        status.style.color = "var(--ok, #16653c)";
        status.style.fontSize = "13px";

        item.append(who, status);
        linksBox.prepend(item);
      }

      function renderUsers(users) {
        usersBody.textContent = "";
        for (const user of users) {
          const tr = document.createElement("tr");

          const name = document.createElement("td");
          name.textContent = user.name;

          const email = document.createElement("td");
          email.textContent = user.email;

          const role = document.createElement("td");
          const rolePill = document.createElement("span");
          rolePill.className = "pill" + (user.role === "organizer" ? " organizer" : "");
          rolePill.textContent = user.role;
          role.append(rolePill);

          const status = document.createElement("td");
          const statusPill = document.createElement("span");
          statusPill.className = "pill " + (user.activated ? "active" : "pending");
          statusPill.textContent = user.activated ? "active" : "not set up";
          status.append(statusPill);

          const actions = document.createElement("td");
          actions.style.textAlign = "right";

          const reinvite = document.createElement("button");
          reinvite.className = "ghost";
          reinvite.textContent = user.activated ? "Reset password" : "New link";
          reinvite.addEventListener("click", async () => {
            reinvite.disabled = true;
            const { ok, data } = await api({ action: "reinvite", email: user.email });
            reinvite.disabled = false;
            if (!ok) return alert(data.error || "Could not send the link.");
            addLink(user.name, user.email);
            linksPanel.scrollIntoView({ behavior: "smooth", block: "nearest" });
          });
          actions.append(reinvite);

          if (user.email !== me) {
            const remove = document.createElement("button");
            remove.className = "ghost danger";
            remove.textContent = "Remove";
            remove.style.marginLeft = "8px";
            remove.addEventListener("click", async () => {
              const warning =
                "Remove " + user.name + " (" + user.email + ")?\n\n" +
                "This permanently deletes their account and everything in it — " +
                "conversations, check-ins and decisions. It cannot be undone.";
              if (!confirm(warning)) return;
              remove.disabled = true;
              const { ok, data } = await api({ action: "remove", email: user.email });
              if (!ok) {
                remove.disabled = false;
                return alert(data.error || "Could not remove this account.");
              }
              load();
            });
            actions.append(remove);
          }

          tr.append(name, email, role, status, actions);
          usersBody.append(tr);
        }
      }

      // ---- Deadlines ----------------------------------------------------

      const deadlineList = document.getElementById("deadline-list");
      /* The submit handler looks this up again locally; the row buttons are
         rendered outside it and need their own reference. */
      const dlMessage = document.getElementById("dl-message");

      async function deadlineApi(body) {
        let res;
        try {
          res = await fetch("/api/deadlines", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
        } catch {
          return { ok: false, data: { error: "Could not reach the server." } };
        }
        let data = {};
        try {
          data = await res.json();
        } catch {
          data = { error: "The server returned an error (" + res.status + ") with no details." };
        }
        return { ok: res.ok, data };
      }

      function dueLabel(iso) {
        const [y, m, d] = iso.split("-").map(Number);
        if (!y) return iso;
        const date = new Date(Date.UTC(y, m - 1, d));
        const day = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][date.getUTCDay()];
        const mon = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"][date.getUTCMonth()];
        return day + " " + d + " " + mon;
      }

      async function loadDeadlines() {
        let data;
        try {
          const res = await fetch("/api/deadlines?view=status");
          if (!res.ok) return;
          data = await res.json();
        } catch {
          return;
        }

        deadlineList.textContent = "";
        if (!data.deadlines.length) {
          const empty = document.createElement("p");
          empty.className = "note";
          empty.textContent = "No deadlines yet. Add the first one above.";
          deadlineList.append(empty);
          return;
        }

        const cohort = data.cohortSize;
        for (const d of data.deadlines) {
          const row = document.createElement("div");
          row.className = "deadline-row";
          if (d.status === "archived") row.classList.add("archived");

          const head = document.createElement("div");
          head.className = "deadline-head";

          const title = document.createElement("strong");
          title.textContent = d.title;

          const meta = document.createElement("span");
          meta.className = "deadline-meta";
          meta.textContent =
            dueLabel(d.dueDate) +
            (d.sprintWeek ? " · W" + d.sprintWeek : "") +
            (d.status === "archived" ? " · archived" : "");

          // Completion count. Task status only — this view never shows anything
          // a founder wrote.
          const count = document.createElement("span");
          count.className = "deadline-count";
          count.textContent = d.doneCount + "/" + cohort + " done";
          if (cohort > 0 && d.doneCount === cohort) count.classList.add("all-done");

          head.append(title, meta, count);
          row.append(head);

          if (d.behind.length > 0 && d.status === "active") {
            const details = document.createElement("details");
            const summary = document.createElement("summary");
            summary.textContent = d.behind.length + " not done yet";
            const names = document.createElement("p");
            names.className = "note";
            names.style.margin = "6px 0 0";
            names.textContent = d.behind.map((f) => f.name).join(", ");
            details.append(summary, names);
            row.append(details);
          }

          const actions = document.createElement("div");
          actions.className = "deadline-actions";

          const archive = document.createElement("button");
          archive.className = "ghost";
          archive.textContent = d.status === "archived" ? "Restore" : "Archive";
          archive.addEventListener("click", async () => {
            archive.disabled = true;
            const { ok, data: body } = await deadlineApi({
              action: "update",
              id: d.id,
              status: d.status === "archived" ? "active" : "archived",
            });
            archive.disabled = false;
            if (!ok) return alert(body.error || "Could not update this deadline.");
            loadDeadlines();
          });

          /*
           * Delete, for a deadline that should never have existed.
           *
           * Two-step rather than confirm(): a modal blocks the page, and this
           * is how Archive all and the knowledge rows already ask. The armed
           * label says what archiving does not, that there is no way back.
           */
          const remove = document.createElement("button");
          remove.className = "ghost danger";
          remove.textContent = "Delete";
          remove.addEventListener("click", async () => {
            if (remove.dataset.armed !== "yes") {
              remove.dataset.armed = "yes";
              remove.textContent = "Delete for good?";
              setTimeout(() => {
                if (!remove.isConnected) return;
                remove.dataset.armed = "";
                remove.textContent = "Delete";
              }, 4000);
              return;
            }
            remove.disabled = true;
            const { ok, data: body } = await deadlineApi({ action: "delete", id: d.id });
            remove.disabled = false;
            if (!ok) return alert(body.error || "Could not delete this deadline.");
            say(dlMessage, "Deleted \u201c" + d.title + "\u201d. It is gone from the founders' list too.", false);
            loadDeadlines();
          });

          actions.append(archive, remove);
          row.append(actions);
          deadlineList.append(row);
        }
      }

      /* ── Date picker ──────────────────────────────────────────────────────
         Ported from a supplied shadcn dropdown range picker. Two departures
         from it, both forced by what this app actually is:

           Single date, not a range. The one calendar field here is a
           deadline's due date, and a range picker cannot express that.

           Vanilla, not React. This page has no React island at all, and its
           whole 590-line script is inline. Mounting a framework for one
           control would add a hydration boundary and a bundle to a page that
           currently ships neither.

         What is kept is the reason to bother: month and year as dropdowns.
         The cohort runs to December, and arrow-paging there is four clicks.

         Dates are built from local year/month/day components throughout.
         Never toISOString(): west of UTC that returns the previous day, which
         is precisely the bug that would make a deadline land a day early. */
      const DP_MONTHS = ["January","February","March","April","May","June",
                         "July","August","September","October","November","December"];
      /* Monday first. Finland, and the sprint week starts Tuesday. */
      const DP_WEEKDAYS = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];

      function dpIso(y, m, d) {
        return String(y) + "-" + String(m + 1).padStart(2, "0") + "-" + String(d).padStart(2, "0");
      }

      function dpLabel(iso) {
        const [y, m, d] = iso.split("-").map(Number);
        if (!y) return iso;
        const at = new Date(Date.UTC(y, m - 1, d));
        const day = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"][at.getUTCDay()];
        return day + " " + d + " " + DP_MONTHS[m - 1].slice(0, 3) + " " + y;
      }

      function initDatePicker(root) {
        const target = document.getElementById(root.dataset.for);
        const trigger = root.querySelector("[data-dp-trigger]");
        const valueEl = root.querySelector("[data-dp-value]");
        const placeholder = valueEl.textContent;

        const today = new Date();
        let viewYear = today.getFullYear();
        let viewMonth = today.getMonth();
        let pop = null;

        function paintTrigger() {
          const has = !!target.value;
          valueEl.textContent = has ? dpLabel(target.value) : placeholder;
          trigger.dataset.empty = has ? "false" : "true";
        }

        function close(refocus) {
          if (!pop) return;
          pop.remove();
          pop = null;
          trigger.setAttribute("aria-expanded", "false");
          document.removeEventListener("mousedown", onOutside, true);
          document.removeEventListener("keydown", onKeydown, true);
          if (refocus) trigger.focus();
        }

        function onOutside(event) {
          if (!root.contains(event.target)) close(false);
        }

        function onKeydown(event) {
          if (event.key === "Escape") {
            event.preventDefault();
            close(true);
          }
        }

        /* Arrow keys move a day at a time and roll over month boundaries, so
           the grid is navigable without reaching for the dropdowns. */
        function onGridKeydown(event) {
          const step = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 }[event.key];
          if (step === undefined) return;
          event.preventDefault();
          const day = Number(event.target.dataset.day);
          const moved = new Date(viewYear, viewMonth, day + step);
          viewYear = moved.getFullYear();
          viewMonth = moved.getMonth();
          paintPop(moved.getDate());
        }

        function pick(y, m, d) {
          target.value = dpIso(y, m, d);
          target.dispatchEvent(new Event("change", { bubbles: true }));
          paintTrigger();
          close(true);
        }

        function paintPop(focusDay) {
          pop.innerHTML = "";

          const selects = document.createElement("div");
          selects.className = "dp-selects";

          const monthSel = document.createElement("select");
          monthSel.setAttribute("aria-label", "Month");
          DP_MONTHS.forEach((name, i) => {
            const opt = document.createElement("option");
            opt.value = String(i);
            opt.textContent = name;
            if (i === viewMonth) opt.selected = true;
            monthSel.append(opt);
          });
          monthSel.addEventListener("change", () => {
            viewMonth = Number(monthSel.value);
            paintPop(null);
          });

          const yearSel = document.createElement("select");
          yearSel.setAttribute("aria-label", "Year");
          /* Two back and five forward. A deadline is set for the sprint ahead,
             not for 2006, and the supplied component's 40-year span is a
             scroll for no reason. Back at all because a typo is easier to
             correct than to work around. */
          for (let y = today.getFullYear() - 2; y <= today.getFullYear() + 5; y++) {
            const opt = document.createElement("option");
            opt.value = String(y);
            opt.textContent = String(y);
            if (y === viewYear) opt.selected = true;
            yearSel.append(opt);
          }
          yearSel.addEventListener("change", () => {
            viewYear = Number(yearSel.value);
            paintPop(null);
          });

          selects.append(monthSel, yearSel);
          pop.append(selects);

          const grid = document.createElement("div");
          grid.className = "dp-grid";
          grid.setAttribute("role", "grid");
          grid.setAttribute("aria-label", DP_MONTHS[viewMonth] + " " + viewYear);

          for (const name of DP_WEEKDAYS) {
            const cell = document.createElement("div");
            cell.className = "dp-weekday";
            cell.setAttribute("aria-hidden", "true");
            cell.textContent = name.slice(0, 2);
            grid.append(cell);
          }

          /* getDay() is Sunday-based; shift so Monday is column one. */
          const lead = (new Date(viewYear, viewMonth, 1).getDay() + 6) % 7;
          const days = new Date(viewYear, viewMonth + 1, 0).getDate();
          const prevDays = new Date(viewYear, viewMonth, 0).getDate();
          const todayIso = dpIso(today.getFullYear(), today.getMonth(), today.getDate());

          const cells = [];
          for (let i = 0; i < lead; i++) {
            cells.push({ day: prevDays - lead + 1 + i, outside: true, delta: -1 });
          }
          for (let d = 1; d <= days; d++) cells.push({ day: d, outside: false, delta: 0 });
          while (cells.length % 7 !== 0) {
            cells.push({ day: cells.length - lead - days + 1, outside: true, delta: 1 });
          }

          let toFocus = null;
          for (const cell of cells) {
            const at = new Date(viewYear, viewMonth + cell.delta, cell.day);
            const iso = dpIso(at.getFullYear(), at.getMonth(), at.getDate());
            const button = document.createElement("button");
            button.type = "button";
            button.className = "dp-day";
            button.textContent = String(cell.day);
            button.dataset.day = String(cell.day);
            button.dataset.outside = cell.outside ? "true" : "false";
            button.dataset.today = iso === todayIso ? "true" : "false";
            button.dataset.selected = iso === target.value ? "true" : "false";
            button.setAttribute("aria-label", dpLabel(iso));
            if (iso === target.value) button.setAttribute("aria-current", "date");
            button.addEventListener("click", () => pick(at.getFullYear(), at.getMonth(), at.getDate()));
            if (!cell.outside) button.addEventListener("keydown", onGridKeydown);
            if (!cell.outside && focusDay === cell.day) toFocus = button;
            grid.append(button);
          }
          pop.append(grid);

          const foot = document.createElement("div");
          foot.className = "dp-foot";

          const clear = document.createElement("button");
          clear.type = "button";
          clear.className = "dp-clear";
          clear.textContent = "Clear";
          clear.disabled = !target.value;
          clear.addEventListener("click", () => {
            target.value = "";
            target.dispatchEvent(new Event("change", { bubbles: true }));
            paintTrigger();
            close(true);
          });

          /* The supplied component's second footer button was "Apply", which
             had nothing to apply: clicking a day already commits it. Jumping
             back to the current month is the thing actually wanted after
             scrolling to next April by accident. */
          const jump = document.createElement("button");
          jump.type = "button";
          jump.className = "dp-today";
          jump.textContent = "Today";
          jump.addEventListener("click", () => {
            viewYear = today.getFullYear();
            viewMonth = today.getMonth();
            paintPop(today.getDate());
          });

          foot.append(clear, jump);
          pop.append(foot);

          if (toFocus) toFocus.focus();
        }

        function open() {
          if (pop) return close(true);
          if (target.value) {
            const [y, m] = target.value.split("-").map(Number);
            viewYear = y;
            viewMonth = m - 1;
          }
          pop = document.createElement("div");
          pop.className = "dp-pop";
          pop.setAttribute("role", "dialog");
          pop.setAttribute("aria-modal", "false");
          pop.setAttribute("aria-label", "Choose a date");
          root.append(pop);
          trigger.setAttribute("aria-expanded", "true");

          const selectedDay = target.value ? Number(target.value.split("-")[2]) : null;
          paintPop(selectedDay || 1);

          /* Flip to the right edge if the popover would leave the viewport. */
          const box = pop.getBoundingClientRect();
          if (box.right > window.innerWidth - 8) pop.dataset.align = "right";

          document.addEventListener("mousedown", onOutside, true);
          document.addEventListener("keydown", onKeydown, true);
        }

        trigger.addEventListener("click", open);
        paintTrigger();
      }

      for (const root of document.querySelectorAll("[data-datepicker]")) initDatePicker(root);

      document.getElementById("add-deadline").addEventListener("submit", async (event) => {
