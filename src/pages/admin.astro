        <!-- The five things an organizer does over and over, one tap from
             anywhere on the page. Shared with the founder-side app, where the
             same menu links here rather than switching tab in place. -->
        <QuickActions client:load mode="inline" />
      </div>
      <!-- What .ghost refracts the page through. Its own id, because SVG
           filter ids are global to the document: two elements both defining
           one id is not an error anyone reports, the browser just resolves
           every reference to whichever it found first. -->
      <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
        <defs>
          <filter id="admin-glass" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="0.05 0.05" numOctaves="1" seed="1" result="noise"/>
            <feGaussianBlur in="noise" stdDeviation="2" result="softNoise"/>
            <feDisplacementMap in="SourceGraphic" in2="softNoise" scale="18" xChannelSelector="R" yChannelSelector="B" result="displaced"/>
            <feGaussianBlur in="displaced" stdDeviation="1.5"/>
          </filter>
        </defs>
      </svg>

    </main>

    <script is:inline>
      const lede = document.getElementById("lede");
      const app = document.getElementById("app");
      const denied = document.getElementById("denied");
      const usersBody = document.getElementById("users");
      const linksPanel = document.getElementById("links-panel");
      const linksBox = document.getElementById("links");
      let me = null;

      // Entry text originates in a pasted transcript by way of the model, so it
      // reaches this page as untrusted content and must never be parsed as
      // markup on the way into the DOM.
      function esc(value) {
        return String(value == null ? "" : value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      // ---- Tabs ---------------------------------------------------------
      //
      // Show/hide only. Every section stays in the DOM so the rest of this
      // script keeps working without knowing tabs exist.

      const TAB_KEY = "sprintbuddy.admin.tab";
      function showTab(slug) {
        const panels = document.querySelectorAll(".tabpanel");
        let matched = false;
        panels.forEach((panel) => {
          const on = panel.id === "tab-" + slug;
          panel.hidden = !on;
          if (on) matched = true;
        });
        if (!matched && panels.length) {
          // A stored tab that no longer exists must not leave a blank page.
          panels[0].hidden = false;
          slug = panels[0].id.replace(/^tab-/, "");
        }
        document.querySelectorAll(".tab").forEach((button) => {
          button.setAttribute("aria-selected", String(button.dataset.tab === slug));
        });
        try { localStorage.setItem(TAB_KEY, slug); } catch { /* private mode */ }
        moveCursor(selectedTab());
        revealTabs(selectedTab());
      }

      /*
       * Ten tabs no longer fit on one row.
       *
       * The bar scrolls, which is the right behaviour and an invisible one: the
       * last tab simply was not there, and nothing said it could be reached.
       * The fade is the affordance, and it only appears when there is something
       * past the edge. Wrapping to two rows would have been simpler, but the
       * sliding cursor is positioned along one axis and this keeps it.
       */
      function revealTabs(active) {
        const bar = document.querySelector(".tabs");
        if (!bar) return;
        bar.classList.toggle("is-scrollable", bar.scrollWidth > bar.clientWidth + 1);
        if (active && active.scrollIntoView) {
          active.scrollIntoView({ inline: "nearest", block: "nearest" });
        }
      }

      window.addEventListener("resize", function () { revealTabs(selectedTab()); });
      /* Measured again after layout and again after fonts.
         The first call runs while showTab sets up, when the bar has not been
         laid out yet and every tab measures the same as its container — so it
         concluded nothing was overflowing and the fade never appeared. Web
         fonts then change the widths a second time. */
      requestAnimationFrame(function () { revealTabs(selectedTab()); });
      window.addEventListener("load", function () { revealTabs(selectedTab()); });
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(function () { revealTabs(selectedTab()); });
      }

      function selectedTab() {
        return document.querySelector('.tab[aria-selected="true"]');
      }

      // Moves the sliding pill onto one tab.
      //
      // offsetLeft/offsetWidth rather than getBoundingClientRect: the bar is
      // position:relative and scrolls horizontally, and offset values are
      // layout coordinates inside it, so they stay right whether the bar has
      // been scrolled or not.
      function moveCursor(tab) {
        const cursor = document.getElementById("tab-cursor");
        if (!cursor) return;
        if (!tab) { cursor.style.opacity = "0"; return; }
        cursor.style.width = tab.offsetWidth + "px";
        cursor.style.transform = "translateX(" + tab.offsetLeft + "px)";
        cursor.style.opacity = "1";
      }

      document.querySelectorAll(".tab").forEach((button) => {
        button.addEventListener("click", () => showTab(button.dataset.tab));
        // Hover moves the pill; leaving the bar sends it back to the open tab.
        // Pointer rather than mouse events, so a tap on a touch screen does not
        // park the pill under a tab that is not open.
        button.addEventListener("pointerenter", (event) => {
          if (event.pointerType === "touch") return;
          moveCursor(button);
        });
      });

      const tabBar = document.getElementById("tabs");
      if (tabBar) {
        tabBar.addEventListener("pointerleave", () => moveCursor(selectedTab()));
        // Keyboard users get the same feedback as the pointer.
        tabBar.addEventListener("focusin", (event) => {
          const tab = event.target.closest && event.target.closest(".tab");
          if (tab) moveCursor(tab);
        });
        tabBar.addEventListener("focusout", () => moveCursor(selectedTab()));
        // Label widths change when the webfont lands, and a width measured
        // before that leaves the pill short of its tab.
        if (document.fonts) document.fonts.ready.then(() => moveCursor(selectedTab()));
        // A resize changes where each tab sits inside the bar.
        new ResizeObserver(() => moveCursor(selectedTab())).observe(tabBar);
      }

      /* First visit lands on the mentor page rather than the account list.
         Somebody who has used this page before comes back where they left. */
      let storedTab = "mentor";
      try { storedTab = localStorage.getItem(TAB_KEY) || "mentor"; } catch { /* private mode */ }
      showTab(storedTab);

      // ---- Quick actions ------------------------------------------------
      //
      // The menu itself is a React island (QuickActions), shared with the
      // founder-side app. It does not know anything about this page; it just
      // says which tab and which field, two ways.
      //
      // In place, from the island sitting in the corner of this page:
      window.addEventListener("sprintbuddy:quick-action", (event) => {
        const { tab, focus } = event.detail || {};
        goToAction(tab, focus);
      });

      // On arrival, from the same menu used over on the founder-side app,
      // which cannot switch a tab on a page it is not on and links here
      // instead. Picking "Add deadline" there should land in the deadline
      // form, not on this page's front door with the form four tabs away.
      (function quickActionOnArrival() {
        const params = new URLSearchParams(location.search);
        const tab = params.get("go");
        if (!tab) return;
        goToAction(tab, params.get("focus"));
        /* Out of the address bar once acted on, or a reload re-runs it and
           steals the focus from wherever the organizer had moved to. */
        history.replaceState(null, "", location.pathname);
      })();

      function goToAction(tab, focus) {
        /* Anything at all can arrive in a query string. showTab already falls
           back to the first panel for a slug it does not have, and an id that
           matches nothing simply does not get focused. */
        if (tab) showTab(tab);
        const target = focus ? document.getElementById(focus) : null;
        if (!target) return;
        target.scrollIntoView({ block: "center", behavior: "smooth" });
        /* After the scroll starts, or the caret goes in and the field is then
           scrolled back out from under it. */
        setTimeout(() => target.focus({ preventScroll: true }), 240);
      }

      function say(el, text, isError) {
        el.textContent = text;
        el.className = "message " + (isError ? "error" : "ok");
        el.hidden = false;
      }

      async function api(body) {
        // Never assume a body is JSON. A server error can return an empty
        // body, and `await res.json()` then throws before the caller can read
        // an error message — which is why a failed removal used to leave the
        // button disabled with nothing shown at all.
        let res;
        try {
          res = await fetch("/api/admin/users", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
        } catch {
          return { ok: false, data: { error: "Could not reach the server. Check your connection." } };
        }
        let data = {};
        try {
          data = await res.json();
        } catch {
          data = { error: `The server returned an error (${res.status}) with no details.` };
        }
        return { ok: res.ok, data };
      }

      /*
       * Records that a link was emailed. The link itself is deliberately not
       * shown here and is not in the response: it goes to the founder's own
       * address and nowhere else, so that nobody on the operating team can
       * redeem it and sign in as them.
       */
      function addLink(name, email) {
        linksPanel.hidden = false;
        const item = document.createElement("div");
        item.className = "link-item";

        const who = document.createElement("strong");
        who.textContent = name ? name + " · " + email : email;
        who.style.flex = "1 1 180px";

        const status = document.createElement("span");
        status.textContent = "Setup link emailed";
        status.style.color = "var(--ok, #16653c)";
        status.style.fontSize = "13px";

        item.append(who, status);
        linksBox.prepend(item);
      }

      /*
       * Shows a reset link on screen, for your own account only.
       *
       * The server refuses this for anybody else, and that is the point: a
       * link here for another person is a way to set their password and sign
       * in as them. For your own it is the difference between a slow mail
       * queue being an inconvenience and being a lock-out.
       */
      function addSelfLink(link) {
        linksPanel.hidden = false;
        const item = document.createElement("div");
        item.className = "link-item";

        const who = document.createElement("strong");
        who.textContent = "Your reset link";
        who.style.flex = "0 0 auto";

        const field = document.createElement("input");
        field.readOnly = true;
        field.value = link;
        field.style.flex = "1 1 260px";
        field.style.minWidth = "0";
        field.addEventListener("focus", () => field.select());

        const copy = document.createElement("button");
        copy.className = "ghost";
        copy.textContent = "Copy";
        copy.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(link);
            copy.textContent = "Copied";
          } catch {
            // Clipboard blocked; the field is selectable either way.
            field.focus();
            copy.textContent = "Select it";
          }
          setTimeout(() => { if (copy.isConnected) copy.textContent = "Copy"; }, 2500);
        });

        const note = document.createElement("span");
        note.textContent = "Single use. Setting the password signs you out everywhere.";
        note.style.cssText = "flex:1 1 100%;color:var(--muted);font-size:12.5px";

        item.append(who, field, copy, note);
        linksBox.prepend(item);
      }

      /* First and last initial. Code points rather than charAt, so a name
         starting outside the basic plane is one glyph and not half of one. */
      function initials(name) {
        const parts = String(name || "").trim().split(/\s+/).filter(Boolean);
        if (parts.length === 0) return "?";
        const first = [...parts[0]][0];
        const last = parts.length > 1 ? [...parts[parts.length - 1]][0] : "";
        return (first + last).toUpperCase();
      }

      function renderUsers(users) {
        usersBody.textContent = "";
        for (const user of users) {
          const tr = document.createElement("tr");

          const member = document.createElement("td");
          const wrap = document.createElement("div");
          wrap.className = "member";

          const avatar = document.createElement("div");
          avatar.className = "avatar" + (user.email === me ? " you" : "");
          avatar.textContent = initials(user.name);
          // The initials repeat the name in the cell beside them.
          avatar.setAttribute("aria-hidden", "true");

          const lines = document.createElement("div");
          lines.className = "member-lines";
          const nameLine = document.createElement("span");
          nameLine.className = "member-name";
          nameLine.textContent = user.name;
          const emailLine = document.createElement("span");
          emailLine.className = "member-email";
          emailLine.textContent = user.email;
          lines.append(nameLine, emailLine);

          wrap.append(avatar, lines);
          member.append(wrap);

          const role = document.createElement("td");
          const rolePill = document.createElement("span");
          rolePill.className = "pill" + (user.role === "organizer" ? " organizer" : user.role === "mentor" ? " mentor" : "");
          rolePill.textContent = user.role;
          role.append(rolePill);

          const status = document.createElement("td");
          const statusPill = document.createElement("span");
          statusPill.className = "pill " + (user.activated ? "active" : "pending");
          statusPill.textContent = user.activated ? "active" : "not set up";
          status.append(statusPill);

          const actions = document.createElement("td");
          actions.className = "row-actions";

          const reinvite = document.createElement("button");
          reinvite.className = "ghost";
          reinvite.textContent = user.activated ? "Reset password" : "New link";
          reinvite.addEventListener("click", async () => {
            reinvite.disabled = true;
            const { ok, data } = await api({ action: "reinvite", email: user.email });
            reinvite.disabled = false;
            if (!ok) return alert(data.error || "Could not send the link.");
            addLink(user.name, user.email);
            linksPanel.scrollIntoView({ behavior: "smooth", block: "nearest" });
          });
          actions.append(reinvite);

          /*
           * Your own account only, and the server enforces that rather than
           * this button. A link on this screen for somebody else is a way to
           * set their password and sign in as them, which is what the email
           * detour exists to prevent.
           */
          if (user.email === me) {
            const showLink = document.createElement("button");
            showLink.className = "ghost";
            showLink.textContent = "Show link";
            showLink.style.marginLeft = "8px";
            showLink.title = "Issue a reset link and show it here, instead of waiting for the email";
            showLink.addEventListener("click", async () => {
              showLink.disabled = true;
              const { ok, data } = await api({ action: "reset-link", email: user.email });
              showLink.disabled = false;
              if (!ok) return alert(data.error || "Could not make a link.");
              addSelfLink(data.link);
              linksPanel.scrollIntoView({ behavior: "smooth", block: "nearest" });
            });
            actions.append(showLink);
          }

          /* No email, no waiting. Revoking access should never depend on mail
             delivery, which is the gap this fills. */
          const signOut = document.createElement("button");
          signOut.className = "ghost";
          signOut.textContent = "Sign out everywhere";
          signOut.style.marginLeft = "8px";
          signOut.addEventListener("click", async () => {
            if (signOut.dataset.armed !== "yes") {
              signOut.dataset.armed = "yes";
              signOut.textContent = user.email === me
                ? "This signs you out here too. Sure?"
                : "Sure?";
              setTimeout(() => {
                if (!signOut.isConnected) return;
                signOut.dataset.armed = "";
                signOut.textContent = "Sign out everywhere";
              }, 6000);
              return;
            }
            signOut.dataset.armed = "";
            signOut.disabled = true;
            const { ok, data } = await api({ action: "signout-all", email: user.email });
            signOut.disabled = false;
            signOut.textContent = "Sign out everywhere";
            if (!ok) return alert(data.error || "Could not sign them out.");
            if (data.self) {
              // Their own session is one of the ones just ended, so staying on
              // this page would be pretending otherwise.
              location.href = "/";
              return;
            }
            say(document.getElementById("add-message"), user.name + " is signed out on every device. Their password still works.", false);
          });
          actions.append(signOut);

          if (user.email !== me) {
            const remove = document.createElement("button");
            remove.className = "ghost danger";
            remove.textContent = "Remove";
            remove.style.marginLeft = "8px";
            remove.addEventListener("click", async () => {
              const warning =
                "Remove " + user.name + " (" + user.email + ")?\n\n" +
                "This permanently deletes their account and everything in it: " +
                "conversations, check-ins and decisions. It cannot be undone.";
              if (!confirm(warning)) return;
              remove.disabled = true;
              const { ok, data } = await api({ action: "remove", email: user.email });
              if (!ok) {
                remove.disabled = false;
                return alert(data.error || "Could not remove this account.");
              }
              /*
               * Everything that names a founder, not just the list they were
               * removed from.
               *
               * load() redraws the People table and nothing else, and every
               * other tab on this page holds whatever it fetched when the page
               * opened. loadMentor in particular is the cohort heatmap and the
               * team map, and it was called exactly once, at startup — so a
               * deleted account went on being named there until somebody
               * reloaded, which is how it was reported. The library matters
               * too: deleting a borrower marks their loans unaccounted, and
               * that shelf would still show the book as out.
               */
              load();
              loadMentor();
              loadShared();
              loadWishes();
              /* Their name comes off any report they filed; the report stays. */
              loadBugs();
              loadDeadlines();
              loadLibrary();
            });
            actions.append(remove);
          }

          tr.append(member, role, status, actions);
          usersBody.append(tr);
        }
      }

      // ---- Deadlines ----------------------------------------------------

      const deadlineList = document.getElementById("deadline-list");
      /* The submit handler looks this up again locally; the row buttons are
         rendered outside it and need their own reference. */
      const dlMessage = document.getElementById("dl-message");
      const deadlineForm = document.getElementById("add-deadline");
      const dlFormHome = document.getElementById("dl-form-home");
      const dlId = document.getElementById("dl-id");
      const dlSubmit = document.getElementById("dl-submit");
      const dlCancel = document.getElementById("dl-cancel");

      /* Which deadline the form is sitting in, or null when it is at home
         adding a new one. */
      let editingDeadlineId = null;

      /*
       * Home the form before loadDeadlines empties the list.
       *
       * `deadlineList.textContent = ""` drops the whole subtree, and while a
       * row is being edited the live form is inside it — so a reload mid-edit
       * would take the form and everything typed into it. Same hazard as the
       * dates and week-theme lists, same one-line answer.
       */
      function homeDeadlineForm() {
        if (deadlineForm.parentElement !== dlFormHome) dlFormHome.appendChild(deadlineForm);
      }

      /** Back to "add a new one", wherever the form happens to be. */
      function resetDeadlineForm() {
        editingDeadlineId = null;
        dlId.value = "";
        document.getElementById("dl-title").value = "";
        document.getElementById("dl-description").value = "";
        document.getElementById("dl-time").value = "";
        document.getElementById("dl-week").value = "";
        setDeadlineDue("");
        dlSubmit.textContent = "Add deadline";
        dlCancel.hidden = true;
        homeDeadlineForm();
      }

      /*
       * The due date is a hidden input with a custom control painting it, so
       * writing the value is only half of it — the trigger keeps whatever text
       * it last drew. paintTrigger lives inside initDatePicker's closure and
       * cannot be called from here, so this does the same two things it does.
       */
      function setDeadlineDue(iso) {
        const due = document.getElementById("dl-due");
        const label = document.getElementById("dl-due-value");
        const trigger = document.querySelector('[data-for="dl-due"] [data-dp-trigger]');
        due.value = iso || "";
        if (label) label.textContent = iso ? dpLabel(iso) : "Pick a date";
        if (trigger) trigger.dataset.empty = iso ? "false" : "true";
      }


      async function libraryApi(body) {
        let res;
        try {
          res = await fetch("/api/library", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
        } catch {
          return { ok: false, data: { error: "Could not reach the server." } };
        }
        let data = {};
        try {
          data = await res.json();
        } catch {
          data = { error: "The server returned an error (" + res.status + ") with no details." };
        }
        return { ok: res.ok, data };
      }

      /*
       * Every row here is built with createElement and textContent, never by
       * concatenating into innerHTML.
       *
       * Book titles, authors and notes are typed by people, and the stored XSS
       * this page already had was exactly that: a record field interpolated raw.
       * esc() exists three screens up, and building nodes means never needing to
       * remember it.
       */
      /* Where a book is, as one pill. Archived is checked before availability:
         a book off the shelf for good is not "on the shelf" just because no
         loan is open against it. */
      function bookStatus(book) {
        if (book.status === "unaccounted") return { tone: "unaccounted", label: "Unaccounted for" };
        if (book.status === "archived") return { tone: "", label: "Archived" };
        if (book.available) return { tone: "shelf", label: "On the shelf" };
        if (book.borrower) {
          const who = book.borrower.name || book.borrower.email;
          return book.loanState === "overdue"
            ? { tone: "late", label: who + " · late" }
            : { tone: "", label: who };
        }
        return { tone: "", label: "Not on the shelf" };
      }

      async function loadLibrary() {
        let data;
        try {
          const res = await fetch("/api/library?view=status");
          if (!res.ok) return;
          data = await res.json();
        } catch {
          return;
        }
        const list = document.getElementById("library-list");
        if (!list) return;
        list.textContent = "";

        if (!data.books || !data.books.length) {
          const empty = document.createElement("p");
          empty.className = "note";
          empty.textContent = "No books yet. Add the first one above.";
          list.append(empty);
          return;
        }

        const all = data.books;
        const counts = {
          shelf: all.filter((b) => b.available && b.status === "active").length,
          out: all.filter((b) => b.loanId).length,
          late: all.filter((b) => b.loanId && b.loanState === "overdue").length,
          lost: all.filter((b) => b.status === "unaccounted").length,
        };

        /* The question this tab is opened to answer, before the table that
           answers it slowly. Only the two that mean somebody has to do
           something are shown when there is nothing to do. */
        const summary = document.createElement("p");
        summary.className = "bk-summary";
        const stat = (label, value, cls) => {
          const span = document.createElement("span");
          if (cls) span.className = cls;
          const strong = document.createElement("strong");
          strong.textContent = String(value);
          span.append(strong, " " + label);
          return span;
        };
        summary.append(stat("on the shelf", counts.shelf));
        summary.append(stat("out on loan", counts.out));
        if (counts.late) summary.append(stat("overdue", counts.late, "is-late"));
        if (counts.lost) summary.append(stat("unaccounted for", counts.lost, "is-lost"));
        list.append(summary);

        /* Anything needing a human sorts to the top: a book nobody can account
           for, then one that is late, then the rest as the server ordered them. */
        const weight = (b) => (b.status === "unaccounted" ? 0 : b.loanState === "overdue" ? 1 : 2);
        const books = all.slice().sort((a, b) => weight(a) - weight(b));

        const table = document.createElement("table");
        const thead = document.createElement("thead");
        const headRow = document.createElement("tr");
        for (const label of ["Book", "Status", "Due back", ""]) {
          const th = document.createElement("th");
          if (label) {
            th.textContent = label;
          } else {
            /* The actions column is obvious from its buttons and unnamed on
               the people table too; the heading exists for a screen reader. */
            const sr = document.createElement("span");
            sr.className = "sr-only";
            sr.textContent = "Actions";
            th.append(sr);
          }
          headRow.append(th);
        }
        thead.append(headRow);
        table.append(thead);

        const tbody = document.createElement("tbody");

        for (const book of books) {
          const row = document.createElement("tr");
          row.className = "bk-row" + (book.status === "archived" ? " archived" : "");

          const { tone, label } = bookStatus(book);

          /* ── Book ── */
          const bookCell = document.createElement("td");
          const linesBox = document.createElement("div");
          linesBox.className = "member-lines";
          const title = document.createElement("span");
          title.className = "member-name";
          title.textContent = book.title;
          linesBox.append(title);

          if (book.author) {
            const sub = document.createElement("span");
            sub.className = "bk-sub";
            sub.textContent = book.author;
            linesBox.append(sub);
          }

          /* The note folds away, the way loan history below it already does.
             It is free text an organizer typed — "shelf by the window, ask Tai
             first" — and printed in full on every row it was taller than the
             book it described. */
          if (book.notes) {
            const noteBox = document.createElement("details");
            noteBox.className = "bk-note";
            const noteSummary = document.createElement("summary");
            noteSummary.textContent = "Note";
            noteBox.append(noteSummary);
            const noteBody = document.createElement("div");
            noteBody.className = "bk-note-body";
            noteBody.textContent = book.notes;
            noteBox.append(noteBody);
            linesBox.append(noteBox);
          }

          if (book.history && book.history.length) {
            const details = document.createElement("details");
            details.className = "bk-history";
            const summaryEl = document.createElement("summary");
            summaryEl.textContent = book.history.length === 1
              ? "1 loan" : book.history.length + " loans";
            details.append(summaryEl);
            const history = document.createElement("ul");
            for (const loan of book.history) {
              const item = document.createElement("li");
              item.textContent = (loan.name || "someone")
                + ", " + loan.borrowedAt.slice(0, 10)
                + (loan.returnedAt ? " to " + loan.returnedAt.slice(0, 10) : ", still out");
              history.append(item);
            }
            details.append(history);
            linesBox.append(details);
          }

          bookCell.append(linesBox);
          row.append(bookCell);

          /* ── Status ── */
          const statusCell = document.createElement("td");
          const pill = document.createElement("span");
          pill.className = "pill" + (tone ? " " + tone : "");
          pill.textContent = label;
          statusCell.append(pill);
          row.append(statusCell);

          /* ── Due back ── */
          const dueCell = document.createElement("td");
          const due = document.createElement("span");
          due.className = "bk-due" + (book.loanState === "overdue" ? " late" : "");
          due.textContent = book.dueDate ? dueLabel(book.dueDate) : "—";
          dueCell.append(due);
          row.append(dueCell);

          /* ── Actions ── */
          const actionsCell = document.createElement("td");
          const actions = document.createElement("div");
          actions.className = "bk-actions";

          if (book.loanId) {
            const back = document.createElement("button");
            back.type = "button";
            back.className = "ghost";
            back.textContent = "Return";
            back.addEventListener("click", async () => {
              back.disabled = true;
              const { ok, data: result } = await libraryApi({ action: "return", id: book.id });
              if (!ok) {
                back.disabled = false;
                return say(document.getElementById("bk-message"), result.error || "Could not mark that returned.", true);
              }
              loadLibrary();
            });
            actions.append(back);

            /* Moving the date is how a renewal is expressed: there is no second
               concept, just a loan that is due later than it was. */
            const extend = document.createElement("button");
            extend.type = "button";
            extend.className = "ghost";
            extend.textContent = "+4 weeks";
            extend.addEventListener("click", async () => {
              extend.disabled = true;
              const dueDate = new Date(Date.now() + 28 * 86400000).toISOString().slice(0, 10);
              const { ok, data: result } = await libraryApi({ action: "set-due", loanId: book.loanId, dueDate });
              if (!ok) {
                extend.disabled = false;
                return say(document.getElementById("bk-message"), result.error || "Could not move that date.", true);
              }
              loadLibrary();
            });
            actions.append(extend);
          }

          const edit = document.createElement("button");
          edit.type = "button";
          edit.className = "ghost";
          edit.textContent = "Edit";
          edit.addEventListener("click", () => {
            document.getElementById("bk-id").value = book.id;
            document.getElementById("bk-title").value = book.title;
            document.getElementById("bk-author").value = book.author || "";
            document.getElementById("bk-notes").value = book.notes || "";
            document.getElementById("bk-submit").textContent = "Save changes";
            document.getElementById("bk-cancel").hidden = false;
            document.getElementById("bk-title").focus();
          });
          actions.append(edit);

          const archive = document.createElement("button");
          archive.type = "button";
          archive.className = "ghost";
          archive.textContent = book.status === "archived" ? "Restore" : "Archive";
          archive.addEventListener("click", async () => {
            archive.disabled = true;
            const status = book.status === "archived" ? "active" : "archived";
            const { ok, data: result } = await libraryApi({ action: "update", id: book.id, status });
            if (!ok) {
              archive.disabled = false;
              return say(document.getElementById("bk-message"), result.error || "Could not change that.", true);
            }
            loadLibrary();
          });
          actions.append(archive);

          /* Two-step rather than confirm(): a browser modal blocks everything
             else on the page, and nothing here uses one. */
          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "ghost danger";
          remove.textContent = "Delete";
          remove.addEventListener("click", async () => {
            if (remove.dataset.armed !== "yes") {
              remove.dataset.armed = "yes";
              remove.textContent = "Delete for good?";
              setTimeout(() => {
                if (!remove.isConnected) return;
                remove.dataset.armed = "";
                remove.textContent = "Delete";
              }, 4000);
              return;
            }
            remove.disabled = true;
            const { ok, data: result } = await libraryApi({ action: "delete", id: book.id });
            if (!ok) {
              remove.disabled = false;
              return say(document.getElementById("bk-message"), result.error || "Could not delete that.", true);
            }
            loadLibrary();
          });
          actions.append(remove);

          actionsCell.append(actions);
          row.append(actionsCell);
          tbody.append(row);
        }

        table.append(tbody);
        list.append(table);
      }

      function resetBookForm() {
        document.getElementById("bk-id").value = "";
        document.getElementById("bk-title").value = "";
        document.getElementById("bk-author").value = "";
        document.getElementById("bk-notes").value = "";
        document.getElementById("bk-submit").textContent = "Add book";
        document.getElementById("bk-cancel").hidden = true;
      }

      document.getElementById("bk-cancel").addEventListener("click", () => {
        resetBookForm();
        const message = document.getElementById("bk-message");
        if (message) message.hidden = true;
      });

      document.getElementById("add-book").addEventListener("submit", async (event) => {
        event.preventDefault();
        const message = document.getElementById("bk-message");
        const id = document.getElementById("bk-id");
        const title = document.getElementById("bk-title");
        const author = document.getElementById("bk-author");
        const notes = document.getElementById("bk-notes");

        if (!title.value.trim()) return say(message, "A title is required.", true);

        const editing = Boolean(id.value);
        const { ok, data } = await libraryApi({
          action: editing ? "update" : "create",
          id: editing ? id.value : undefined,
          title: title.value,
          author: author.value,
          notes: notes.value,
        });
        if (!ok) {
          return say(message, data.error || "Could not save this book.", true);
        }
        say(message, (editing ? "Saved \u201c" : "Added \u201c") + title.value.trim() + "\u201d.", false);
        resetBookForm();
        loadLibrary();
      });

      async function deadlineApi(body) {
        let res;
        try {
          res = await fetch("/api/deadlines", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
        } catch {
          return { ok: false, data: { error: "Could not reach the server." } };
        }
        let data = {};
        try {
          data = await res.json();
        } catch {
          data = { error: "The server returned an error (" + res.status + ") with no details." };
        }
        return { ok: res.ok, data };
      }

      function dueLabel(iso) {
        const [y, m, d] = iso.split("-").map(Number);
        if (!y) return iso;
        const date = new Date(Date.UTC(y, m - 1, d));
        const day = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][date.getUTCDay()];
        const mon = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"][date.getUTCMonth()];
        return day + " " + d + " " + mon;
      }

      /* The last payload, kept so the list can be redrawn without asking the
         server again — opening the editor on a row is a redraw, not new data,
         and renderKeepingStill has to measure the DOM synchronously either
         side of it. */
      let deadlineData = null;

      async function loadDeadlines() {
        try {
          const res = await fetch("/api/deadlines?view=status");
          if (!res.ok) return;
          deadlineData = await res.json();
        } catch {
          return;
        }
        renderDeadlines();
      }

      function renderDeadlines() {
        const data = deadlineData;
        if (!data) return;

        homeDeadlineForm();
        deadlineList.textContent = "";
        if (!data.deadlines.length) {
          const empty = document.createElement("p");
          empty.className = "note";
          empty.textContent = "No deadlines yet. Add the first one above.";
          deadlineList.append(empty);
          return;
        }

        const cohort = data.cohortSize;
        for (const d of data.deadlines) {
          const row = document.createElement("div");
          row.className = "deadline-row";
          if (d.status === "archived") row.classList.add("archived");

          const head = document.createElement("div");
          head.className = "deadline-head";

          const title = document.createElement("strong");
          title.textContent = d.title;

          const meta = document.createElement("span");
          meta.className = "deadline-meta";
          meta.textContent =
            dueLabel(d.dueDate) +
            (d.sprintWeek ? " · W" + d.sprintWeek : "") +
            (d.status === "archived" ? " · archived" : "");

          // Completion count. Task status only — this view never shows anything
          // a founder wrote.
          const count = document.createElement("span");
          count.className = "deadline-count";
          count.textContent = d.doneCount + "/" + cohort + " done";
          if (cohort > 0 && d.doneCount === cohort) count.classList.add("all-done");

          head.append(title, meta, count);
          row.append(head);

          if (d.behind.length > 0 && d.status === "active") {
            const details = document.createElement("details");
            const summary = document.createElement("summary");
            summary.textContent = d.behind.length + " not done yet";
            const names = document.createElement("p");
            names.className = "note";
            names.style.margin = "6px 0 0";
            names.textContent = d.behind.map((f) => f.name).join(", ");
            details.append(summary, names);
            row.append(details);
          }

          const actions = document.createElement("div");
          actions.className = "deadline-actions";

          /*
           * Editing, which the API has always supported and the page never
           * offered: Archive and Delete were the only two things you could do
           * to a deadline once it existed, so a typo in a title or a date set
           * a day out meant deleting it and typing the whole thing again —
           * and deleting takes every founder's completion with it.
           */
          const edit = document.createElement("button");
          edit.className = "ghost";
          edit.dataset.editDeadline = d.id;
          edit.textContent = editingDeadlineId === d.id ? "Editing" : "Edit";
          edit.addEventListener("click", () => {
            dlId.value = d.id;
            document.getElementById("dl-title").value = d.title;
            document.getElementById("dl-description").value = d.description || "";
            document.getElementById("dl-time").value = d.dueTime || "";
            document.getElementById("dl-week").value = d.sprintWeek == null ? "" : String(d.sprintWeek);
            setDeadlineDue(d.dueDate);
            dlSubmit.textContent = "Save changes";
            dlCancel.hidden = false;
            say(dlMessage, "", false);
            dlMessage.hidden = true;
            editingDeadlineId = d.id;
            /* The form comes to the row rather than the row sending you up to
               the form, and the row keeps its place across the redraw. */
            renderKeepingStill('[data-edit-deadline="' + CSS.escape(d.id) + '"]', renderDeadlines);
            document.getElementById("dl-title").focus({ preventScroll: true });
          });
          actions.append(edit);

          const archive = document.createElement("button");
          archive.className = "ghost";
          archive.textContent = d.status === "archived" ? "Restore" : "Archive";
          archive.addEventListener("click", async () => {
            archive.disabled = true;
            const { ok, data: body } = await deadlineApi({
              action: "update",
              id: d.id,
              status: d.status === "archived" ? "active" : "archived",
            });
            archive.disabled = false;
            if (!ok) return alert(body.error || "Could not update this deadline.");
            loadDeadlines();
          });

          /*
           * Delete, for a deadline that should never have existed.
           *
           * Two-step rather than confirm(): a modal blocks the page, and this
           * is how Archive all and the knowledge rows already ask. The armed
           * label says what archiving does not, that there is no way back.
           */
          const remove = document.createElement("button");
          remove.className = "ghost danger";
          remove.textContent = "Delete";
          remove.addEventListener("click", async () => {
            if (remove.dataset.armed !== "yes") {
              remove.dataset.armed = "yes";
              remove.textContent = "Delete for good?";
              setTimeout(() => {
                if (!remove.isConnected) return;
                remove.dataset.armed = "";
                remove.textContent = "Delete";
              }, 4000);
              return;
            }
            remove.disabled = true;
            const { ok, data: body } = await deadlineApi({ action: "delete", id: d.id });
            remove.disabled = false;
            if (!ok) return alert(body.error || "Could not delete this deadline.");
            say(dlMessage, "Deleted \u201c" + d.title + "\u201d. It is gone from the founders' list too.", false);
            /* If this is the row the editor is open on, the form has to come
               home before the redraw takes the slot it is sitting in. */
            if (editingDeadlineId === d.id) resetDeadlineForm();
            loadDeadlines();
          });

          actions.append(archive, remove);
          row.append(actions);
          deadlineList.append(row);

          /* The form is moved in here, under the row it belongs to. Only ever
             one of these, because only one row can be open at a time. */
          if (editingDeadlineId === d.id) {
            row.classList.add("is-editing");
            const slot = document.createElement("div");
            slot.className = "dl-edit";
            deadlineList.append(slot);
            slot.appendChild(deadlineForm);
          }
        }
      }

      /* ── Date picker ──────────────────────────────────────────────────────
         Ported from a supplied shadcn dropdown range picker. Two departures
         from it, both forced by what this app actually is:

           Single date, not a range. The one calendar field here is a
           deadline's due date, and a range picker cannot express that.

           Vanilla, not React. This page has no React island at all, and its
           whole 590-line script is inline. Mounting a framework for one
           control would add a hydration boundary and a bundle to a page that
           currently ships neither.

         What is kept is the reason to bother: month and year as dropdowns.
         The cohort runs to December, and arrow-paging there is four clicks.

         Dates are built from local year/month/day components throughout.
         Never toISOString(): west of UTC that returns the previous day, which
         is precisely the bug that would make a deadline land a day early. */
      const DP_MONTHS = ["January","February","March","April","May","June",
                         "July","August","September","October","November","December"];
      /* Monday first. Finland, and the sprint week starts Tuesday. */
      const DP_WEEKDAYS = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];

      function dpIso(y, m, d) {
        return String(y) + "-" + String(m + 1).padStart(2, "0") + "-" + String(d).padStart(2, "0");
      }

      function dpLabel(iso) {
        const [y, m, d] = iso.split("-").map(Number);
        if (!y) return iso;
        const at = new Date(Date.UTC(y, m - 1, d));
        const day = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"][at.getUTCDay()];
        return day + " " + d + " " + DP_MONTHS[m - 1].slice(0, 3) + " " + y;
      }

      function initDatePicker(root) {
        const target = document.getElementById(root.dataset.for);
        const trigger = root.querySelector("[data-dp-trigger]");
        const valueEl = root.querySelector("[data-dp-value]");
        const placeholder = valueEl.textContent;

        const today = new Date();
        let viewYear = today.getFullYear();
        let viewMonth = today.getMonth();
        let pop = null;

        function paintTrigger() {
          const has = !!target.value;
          valueEl.textContent = has ? dpLabel(target.value) : placeholder;
          trigger.dataset.empty = has ? "false" : "true";
        }

        function close(refocus) {
          if (!pop) return;
          pop.remove();
          pop = null;
          trigger.setAttribute("aria-expanded", "false");
          document.removeEventListener("mousedown", onOutside, true);
          document.removeEventListener("keydown", onKeydown, true);
          if (refocus) trigger.focus();
        }

        function onOutside(event) {
          if (!root.contains(event.target)) close(false);
        }

        function onKeydown(event) {
          if (event.key === "Escape") {
            event.preventDefault();
            close(true);
          }
        }

        /* Arrow keys move a day at a time and roll over month boundaries, so
           the grid is navigable without reaching for the dropdowns. */
        function onGridKeydown(event) {
          const step = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 }[event.key];
          if (step === undefined) return;
          event.preventDefault();
          const day = Number(event.target.dataset.day);
          const moved = new Date(viewYear, viewMonth, day + step);
          viewYear = moved.getFullYear();
          viewMonth = moved.getMonth();
          paintPop(moved.getDate());
        }

        function pick(y, m, d) {
          target.value = dpIso(y, m, d);
          target.dispatchEvent(new Event("change", { bubbles: true }));
          paintTrigger();
          close(true);
        }

        function paintPop(focusDay) {
          pop.innerHTML = "";

          const selects = document.createElement("div");
          selects.className = "dp-selects";

          const monthSel = document.createElement("select");
          monthSel.setAttribute("aria-label", "Month");
          DP_MONTHS.forEach((name, i) => {
            const opt = document.createElement("option");
            opt.value = String(i);
            opt.textContent = name;
            if (i === viewMonth) opt.selected = true;
            monthSel.append(opt);
          });
          monthSel.addEventListener("change", () => {
            viewMonth = Number(monthSel.value);
            paintPop(null);
          });

          const yearSel = document.createElement("select");
          yearSel.setAttribute("aria-label", "Year");
          /* Two back and five forward. A deadline is set for the sprint ahead,
             not for 2006, and the supplied component's 40-year span is a
             scroll for no reason. Back at all because a typo is easier to
             correct than to work around. */
          for (let y = today.getFullYear() - 2; y <= today.getFullYear() + 5; y++) {
            const opt = document.createElement("option");
            opt.value = String(y);
            opt.textContent = String(y);
            if (y === viewYear) opt.selected = true;
            yearSel.append(opt);
          }
          yearSel.addEventListener("change", () => {
            viewYear = Number(yearSel.value);
            paintPop(null);
          });

          selects.append(monthSel, yearSel);
          pop.append(selects);

          const grid = document.createElement("div");
          grid.className = "dp-grid";
          grid.setAttribute("role", "grid");
          grid.setAttribute("aria-label", DP_MONTHS[viewMonth] + " " + viewYear);

          for (const name of DP_WEEKDAYS) {
            const cell = document.createElement("div");
            cell.className = "dp-weekday";
            cell.setAttribute("aria-hidden", "true");
            cell.textContent = name.slice(0, 2);
            grid.append(cell);
          }

          /* getDay() is Sunday-based; shift so Monday is column one. */
          const lead = (new Date(viewYear, viewMonth, 1).getDay() + 6) % 7;
          const days = new Date(viewYear, viewMonth + 1, 0).getDate();
          const prevDays = new Date(viewYear, viewMonth, 0).getDate();
          const todayIso = dpIso(today.getFullYear(), today.getMonth(), today.getDate());

          const cells = [];
          for (let i = 0; i < lead; i++) {
            cells.push({ day: prevDays - lead + 1 + i, outside: true, delta: -1 });
          }
          for (let d = 1; d <= days; d++) cells.push({ day: d, outside: false, delta: 0 });
          while (cells.length % 7 !== 0) {
            cells.push({ day: cells.length - lead - days + 1, outside: true, delta: 1 });
          }

          let toFocus = null;
          for (const cell of cells) {
            const at = new Date(viewYear, viewMonth + cell.delta, cell.day);
            const iso = dpIso(at.getFullYear(), at.getMonth(), at.getDate());
            const button = document.createElement("button");
            button.type = "button";
            button.className = "dp-day";
            button.textContent = String(cell.day);
            button.dataset.day = String(cell.day);
            button.dataset.outside = cell.outside ? "true" : "false";
            button.dataset.today = iso === todayIso ? "true" : "false";
            button.dataset.selected = iso === target.value ? "true" : "false";
            button.setAttribute("aria-label", dpLabel(iso));
            if (iso === target.value) button.setAttribute("aria-current", "date");
            button.addEventListener("click", () => pick(at.getFullYear(), at.getMonth(), at.getDate()));
            if (!cell.outside) button.addEventListener("keydown", onGridKeydown);
            if (!cell.outside && focusDay === cell.day) toFocus = button;
            grid.append(button);
          }
          pop.append(grid);

          const foot = document.createElement("div");
          foot.className = "dp-foot";

          const clear = document.createElement("button");
          clear.type = "button";
          clear.className = "dp-clear";
          clear.textContent = "Clear";
          clear.disabled = !target.value;
          clear.addEventListener("click", () => {
            target.value = "";
            target.dispatchEvent(new Event("change", { bubbles: true }));
            paintTrigger();
            close(true);
          });

          /* The supplied component's second footer button was "Apply", which
             had nothing to apply: clicking a day already commits it. Jumping
             back to the current month is the thing actually wanted after
             scrolling to next April by accident. */
          const jump = document.createElement("button");
          jump.type = "button";
          jump.className = "dp-today";
          jump.textContent = "Today";
          jump.addEventListener("click", () => {
            viewYear = today.getFullYear();
            viewMonth = today.getMonth();
            paintPop(today.getDate());
          });

          foot.append(clear, jump);
          pop.append(foot);

          if (toFocus) toFocus.focus();
        }

        function open() {
          if (pop) return close(true);
          if (target.value) {
            const [y, m] = target.value.split("-").map(Number);
            viewYear = y;
            viewMonth = m - 1;
          }
          pop = document.createElement("div");
          pop.className = "dp-pop";
          pop.setAttribute("role", "dialog");
          pop.setAttribute("aria-modal", "false");
          pop.setAttribute("aria-label", "Choose a date");
          root.append(pop);
          trigger.setAttribute("aria-expanded", "true");

          const selectedDay = target.value ? Number(target.value.split("-")[2]) : null;
          paintPop(selectedDay || 1);

          /* Flip to the right edge if the popover would leave the viewport. */
          const box = pop.getBoundingClientRect();
          if (box.right > window.innerWidth - 8) pop.dataset.align = "right";

          document.addEventListener("mousedown", onOutside, true);
          document.addEventListener("keydown", onKeydown, true);
        }

        trigger.addEventListener("click", open);
        paintTrigger();
      }

      for (const root of document.querySelectorAll("[data-datepicker]")) initDatePicker(root);

      document.getElementById("add-deadline").addEventListener("submit", async (event) => {
        event.preventDefault();
        const message = document.getElementById("dl-message");
        const title = document.getElementById("dl-title");
        const description = document.getElementById("dl-description");
        const due = document.getElementById("dl-due");
        const time = document.getElementById("dl-time");
        const week = document.getElementById("dl-week");

        /* `required` on a hidden input does nothing: hidden inputs are barred
           from constraint validation, so the browser will not stop an empty
           submit the way it did when this was <input type="date" required>.
           The server still rejects it, but saying so here is faster and says
           which field. */
        if (!due.value) return say(message, "Pick a due date.", true);

        /* One form, two jobs, told apart by whether a row opened it. Editing
           sends every field rather than a diff: the API treats an absent key
           as "leave it alone", so clearing a description would otherwise be
           impossible \u2014 it would read as no change rather than as empty. */
        const editing = !!dlId.value;
        const { ok, data } = await deadlineApi({
          action: editing ? "update" : "create",
          ...(editing ? { id: dlId.value } : {}),
          title: title.value,
          description: description.value,
          dueDate: due.value,
          // Empty means end of day, which the server stores as null.
          dueTime: time.value === "" ? null : time.value,
          sprintWeek: week.value === "" ? null : Number(week.value),
        });

        if (!ok) {
          return say(message, data.error || (editing ? "Could not save this deadline." : "Could not add this deadline."), true);
        }

        say(message, (editing ? "Saved \u201c" : "Added \u201c") + title.value.trim() + "\u201d.", false);
        resetDeadlineForm();
        loadDeadlines();
      });

      dlCancel.addEventListener("click", () => {
        resetDeadlineForm();
        dlMessage.hidden = true;
        renderDeadlines();
      });

      /*
       * A mentor gets this page too, with almost none of it.
       *
       * The gate used to be "can you read /api/admin/users", which is an
       * organizer-only endpoint — so a mentor was shown "Organizers only" on
       * the page built for them. Identity comes from the session now, and the
       * account list is only fetched by whoever is allowed to see it.
       */
      let myRole = null;

      function applyRole(role) {
        myRole = role;
        if (role !== "mentor") return;
        /* Hide what a mentor cannot do rather than let them press it and read
           a 403. The server refuses either way; this is so the page is not
           mostly things that do not work. */
        const allowed = new Set(["mentor", "shared", "wishes", "bugs"]);
        for (const tab of document.querySelectorAll(".tab")) {
          if (!allowed.has(tab.dataset.tab)) tab.hidden = true;
        }
        const quick = document.getElementById("qa");
        if (quick) quick.remove();
        if (!allowed.has(localStorage.getItem(TAB_KEY) || "")) showTab("mentor");
      }

      async function load() {
        try {
          const who = await fetch("/api/session").then((r) => r.json()).catch(() => null);
          const user = who && who.user;
          if (!user) {
            lede.hidden = true;
            denied.hidden = false;
            location.href = "/";
            return;
          }
          if (user.role === "mentor") {
            me = user.email;
            lede.textContent = "Reading only. Nothing here can be changed from this page.";
            app.hidden = false;
            applyRole("mentor");
            return;
          }
          if (user.role !== "organizer") {
            lede.hidden = true;
            denied.hidden = false;
            return;
          }

          const res = await fetch("/api/admin/users");
          if (res.status === 401) {
            lede.hidden = true;
            denied.hidden = false;
            location.href = "/";
            return;
          }
          if (res.status === 403) {
            lede.hidden = true;
            denied.hidden = false;
            return;
          }
          const data = await res.json();
          /* Set for organizers too. It was only ever assigned on the mentor
             branch, so `myRole` stayed null here and the loads below worked by
             accident — the next thing to read it would not have. */
          applyRole("organizer");
          me = data.you;
          const pending = data.users.filter((u) => !u.activated).length;
          lede.textContent =
            data.users.length +
            (data.users.length === 1 ? " account" : " accounts") +
            (pending ? " · " + pending + " still to set up" : " · everyone is set up");
          app.hidden = false;
          renderUsers(data.users);
        } catch {
          lede.textContent = "Could not reach the server.";
        }
      }

      document.getElementById("add-one").addEventListener("submit", async (event) => {
        event.preventDefault();
        const message = document.getElementById("add-message");
        const name = document.getElementById("add-name");
        const email = document.getElementById("add-email");
        const role = document.getElementById("add-role");

        const { ok, data } = await api({
          action: "add",
          name: name.value,
          email: email.value,
          role: role.value,
        });
        if (!ok) return say(message, data.error || "Could not add this person.", true);

        addLink(name.value.trim(), data.email);
        say(message, "Added " + name.value.trim() + ". Their setup link has been emailed to them.", false);
        name.value = "";
        email.value = "";
        load();
      });

      document.getElementById("add-bulk").addEventListener("submit", async (event) => {
        event.preventDefault();
        const message = document.getElementById("bulk-message");
        const textarea = document.getElementById("bulk-text");

        const entries = textarea.value
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            // "Name, email" — split on the last comma so names may contain one.
            const cut = line.lastIndexOf(",");
            if (cut === -1) return { name: "", email: line };
            return { name: line.slice(0, cut).trim(), email: line.slice(cut + 1).trim() };
          });

        if (!entries.length) return say(message, "Nothing to add.", true);

        const { ok, data } = await api({ action: "add-bulk", entries });
        if (!ok) return say(message, data.error || "Could not add these people.", true);

        const added = data.results.filter((r) => r.emailed);
        const failed = data.results.filter((r) => r.error);
        for (const row of added) addLink(row.name, row.email);

        const summary =
          "Added " + added.length + " of " + data.results.length + "." +
          (failed.length
            ? " Skipped: " + failed.map((f) => (f.email || "(blank)") + ": " + f.error).join("; ")
            : "");
        say(message, summary, failed.length > 0);
        if (added.length) textarea.value = "";
        load();
      });

      // ---- Programme ----------------------------------------------------

      const prWeek = document.getElementById("pr-week");
      const prPhase = document.getElementById("pr-phase");
      const prTitle = document.getElementById("pr-title");
      const prMilestones = document.getElementById("pr-milestones");
      const prSessions = document.getElementById("pr-sessions");
      const prMessage = document.getElementById("pr-message");
      const programmeList = document.getElementById("programme-list");
      const programmeForm = document.getElementById("programme-form");
      const prFormHome = document.getElementById("pr-form-home");
      const prCancel = document.getElementById("pr-cancel");

      let programmeWeeks = [];
      let totalWeeks = 15;
      /* Which week the form is sitting in, or null when it is at home. */
      let editingWeek = null;

      function fillWeek(week) {
        const row = programmeWeeks.find((w) => w.week === week);
        prPhase.value = row ? row.phase : "";
        prTitle.value = row ? row.title : "";
        prMilestones.value = row ? row.milestones : "";
        prSessions.value = row ? row.sessions : "";
      }

      /*
       * Put the week form back before writing to programmeList.innerHTML —
       * same hazard as the events list, same one-line answer.
       */
      function homeWeekForm() {
        if (programmeForm.parentElement !== prFormHome) prFormHome.appendChild(programmeForm);
      }

      function renderProgramme() {
        homeWeekForm();

        /*
         * Every week, not only the stored ones.
         *
         * The list showed the weeks that had something in them, so the way to
         * fill in week nine was to notice it was missing, scroll back up and
         * pick it out of a dropdown. A thirteen-week programme has thirteen rows
         * whether or not anybody has written them yet; the empty ones say so
         * and open the same editor.
         */
        const rows = [];
        for (let week = 1; week <= totalWeeks; week++) {
          const w = programmeWeeks.find((row) => row.week === week);
          const editing = week === editingWeek;
          /* Escaped. These two are the only values on this page that were
             interpolated into innerHTML raw, and they are organizer-written
             free text — so one organizer could store script that ran in
             another organizer's session, on the page that holds every
             destructive control there is. esc() has existed three screens
             up this file the whole time. */
          const heading = esc(w ? [w.phase, w.title].filter(Boolean).join(", ") : "");
          const milestones = w ? w.milestones.split("\n").filter((l) => l.trim()).length : 0;
          const sessions = w ? w.sessions.split("\n").filter((l) => l.trim()).length : 0;

          rows.push(
            '<div class="pr-row' + (w ? "" : " is-empty") + (editing ? " is-editing" : "") + '">' +
            '<strong class="pr-week">Week ' + week + "</strong>" +
            '<span class="pr-heading">' + (w ? (heading || "<em>untitled</em>") : '<em class="pr-unset">Not set</em>') + "</span>" +
            '<span class="pr-counts">' +
              (w ? milestones + " milestone" + (milestones === 1 ? "" : "s") +
                   ", " + sessions + " session" + (sessions === 1 ? "" : "s") : "") +
            "</span>" +
            '<span class="pr-actions">' +
              '<button type="button" data-week="' + week + '">' +
                (editing ? "Editing" : w ? "Edit" : "Add") + "</button>" +
              /* Only a week with something in it can be cleared. */
              (w ? '<button type="button" class="ghost danger" data-delete-week="' + week + '">Remove</button>' : "") +
            "</span>" +
            "</div>" +
            (editing ? '<div class="pr-edit" id="pr-edit-slot"></div>' : ""),
          );
        }
        programmeList.innerHTML = rows.join("");

        if (editingWeek) {
          const slot = document.getElementById("pr-edit-slot");
          if (slot) slot.appendChild(programmeForm);
        }
      }

      async function loadProgramme() {
        let res;
        try {
          res = await fetch("/api/programme");
        } catch {
          return say(prMessage, "Could not reach the server.", true);
        }
        if (!res.ok) return;
        const data = await res.json();
        totalWeeks = data.totalWeeks || 15;
        /* The deadline form's week ceiling is the programme's length. Left at a
           hard 15 it accepted weeks the sprint does not have, and the server
           then refused them with a message naming a different number. */
        const weekInput = document.getElementById("dl-week");
        if (weekInput) weekInput.max = String(totalWeeks);
        programmeWeeks = data.weeks || [];

        if (!prWeek.options.length) {
          for (let i = 1; i <= totalWeeks; i++) {
            const option = document.createElement("option");
            option.value = String(i);
            option.textContent = "Week " + i;
            prWeek.appendChild(option);
          }
          prWeek.addEventListener("change", () => fillWeek(Number(prWeek.value)));
        }
        renderProgramme();
        fillWeek(Number(prWeek.value || 1));
      }

      document.getElementById("programme-form").addEventListener("submit", async (event) => {
        event.preventDefault();
        let res;
        try {
          res = await fetch("/api/programme", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              week: Number(prWeek.value),
              phase: prPhase.value,
              title: prTitle.value,
              milestones: prMilestones.value,
              sessions: prSessions.value,
            }),
          });
        } catch {
          return say(prMessage, "Could not reach the server.", true);
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) return say(prMessage, data.error || "Could not save that week.", true);

        const blank = !prPhase.value.trim() && !prTitle.value.trim() &&
          !prMilestones.value.trim() && !prSessions.value.trim();
        say(prMessage, blank ? "Week " + prWeek.value + " cleared." : "Week " + prWeek.value + " saved.", false);
        editingWeek = null;
        prCancel.hidden = true;
        homeWeekForm();
        loadProgramme();
      });

      prCancel.addEventListener("click", () => {
        editingWeek = null;
        prCancel.hidden = true;
        prMessage.hidden = true;
        homeWeekForm();
        renderProgramme();
      });

      programmeList.addEventListener("click", async (event) => {
        const button = event.target;
        if (!button || !button.getAttribute) return;

        const week = button.getAttribute("data-week");
        if (week) {
          const n = Number(week);
          prWeek.value = String(n);
          fillWeek(n);
          prCancel.hidden = false;
          /* The form comes to the row rather than the row sending you to the
             form — week fifteen used to be a 1,200px trip each way. */
          editingWeek = n;
          renderKeepingStill('[data-week="' + n + '"]', renderProgramme);
          prPhase.focus({ preventScroll: true });
          return;
        }

        const doomed = button.getAttribute("data-delete-week");
        if (!doomed) return;

        /*
         * Two-step rather than confirm(), which is how the rest of this page
         * asks: a browser modal blocks everything to ask about one row, and
         * nothing here uses one. A week theme is prose somebody wrote and it
         * is not recoverable from the page, so it does get asked.
         */
        if (button.dataset.armed !== "yes") {
          button.dataset.armed = "yes";
          button.textContent = "Sure?";
          setTimeout(() => {
            if (!button.isConnected) return;
            button.dataset.armed = "";
            button.textContent = "Remove";
          }, 4000);
          return;
        }

        let res;
        try {
          res = await fetch("/api/programme", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "delete", week: Number(doomed) }),
          });
        } catch {
          return say(prMessage, "Could not reach the server.", true);
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) return say(prMessage, data.error || "Could not remove that week.", true);

        say(prMessage, "Week " + doomed + " removed.", false);
        /* If the row being edited is the one just removed, the form has to come
           home before the re-render drops the slot out from under it. */
        if (editingWeek === Number(doomed)) {
          editingWeek = null;
          prCancel.hidden = true;
          homeWeekForm();
        }
        loadProgramme();
      });

      // ---- Wishes ---------------------------------------------------------

      const wishList = document.getElementById("wish-list");
      const wishMessage = document.getElementById("wish-message");
      const wishBadge = document.getElementById("wish-badge");

      const WISH_AUDIENCE = { organizers: "The organisers", mentors: "The mentors" };

      let wishes = [];

      function wishWhen(value) {
        const date = new Date(String(value).replace(" ", "T") + "Z");
        if (isNaN(date.getTime())) return "";
        return date.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
      }

      function renderWishes() {
        // The count is of unanswered ones only — a badge showing everything ever
        // asked is a number that only goes up and stops meaning anything.
        const open = wishes.filter(function (w) { return w.status !== "answered"; }).length;
        if (wishBadge) {
          wishBadge.hidden = open === 0;
          wishBadge.textContent = String(open);
        }

        if (!wishes.length) {
          wishList.innerHTML = '<p class="note">Nothing asked yet.</p>';
          return;
        }

        wishList.innerHTML = wishes.map(function (wish) {
          const answered = wish.status === "answered";
          const replies = (wish.replies || []).map(function (reply) {
            return '<div class="wish-reply">' +
              '<p class="wish-replyhead">' + esc(reply.authorName) + ' &middot; ' + esc(wishWhen(reply.createdAt)) + '</p>' +
              '<p class="wish-body">' + esc(reply.body) + '</p>' +
            '</div>';
          }).join("");

          return '<article class="wish' + (answered ? " is-answered" : "") + '">' +
            '<div class="wish-head">' +
              '<span class="wish-from">' + esc(wish.fromName) + '</span>' +
              '<span class="wish-to">to ' + esc(WISH_AUDIENCE[wish.audience] || wish.audience) + '</span>' +
              '<span class="wish-when">' + esc(wishWhen(wish.createdAt)) + '</span>' +
              '<span class="wish-status">' + (answered ? "Answered" : "Waiting") + '</span>' +
            '</div>' +
            '<p class="wish-body">' + esc(wish.body) + '</p>' +
            replies +
            '<div class="wish-replybox">' +
              '<textarea rows="2" maxlength="2000" data-reply-for="' + esc(wish.id) + '" placeholder="Reply to ' + esc(wish.fromName) + '"></textarea>' +
              '<button type="button" data-send-reply="' + esc(wish.id) + '">Reply</button>' +
            '</div>' +
          '</article>';
        }).join("");
      }

      async function loadWishes() {
        let res;
        try {
          res = await fetch("/api/wishes");
        } catch {
          return say(wishMessage, "Could not reach the server.", true);
        }
        if (!res.ok) return;
        const data = await res.json().catch(() => ({}));
        wishes = data.wishes || [];
        renderWishes();
      }

      wishList.addEventListener("click", async function (event) {
        const id = event.target.getAttribute && event.target.getAttribute("data-send-reply");
        if (!id) return;
        const box = wishList.querySelector('textarea[data-reply-for="' + id + '"]');
        const body = box ? box.value.trim() : "";
        if (!body) return say(wishMessage, "An empty reply says nothing.", true);

        event.target.disabled = true;
        let res;
        try {
          res = await fetch("/api/wishes", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "reply", id: id, body: body }),
          });
        } catch {
          event.target.disabled = false;
          return say(wishMessage, "Could not reach the server.", true);
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          event.target.disabled = false;
          return say(wishMessage, data.error || "Could not send that.", true);
        }
        say(wishMessage, "Replied. They get an email.", false);
        loadWishes();
      });

      // ---- Bug reports ----------------------------------------------------

      const bugList = document.getElementById("bug-list");
      const bugMessage = document.getElementById("bug-message");
      const bugBadge = document.getElementById("bug-badge");
      const bugBody = document.getElementById("bug-body");

      let bugReports = [];

      /* The five states, in the order a report travels through them. The
         labels are what an organizer reads; the values are what the column
         checks against, and the two must not drift. */
      const BUG_STATUS = [
        ["new", "New"],
        ["need_info", "Need more info"],
        ["fixing", "Fixing"],
        ["done", "Done"],
        ["wont_fix", "Won't fix"],
      ];
      const BUG_STATUS_LABEL = Object.fromEntries(BUG_STATUS);

      function renderBugs() {
        /* Untriaged only. A badge counting every report ever filed is a number
           that only goes up and stops meaning anything — the same reasoning as
           the wishes badge counting unanswered ones. */
        const fresh = bugReports.filter(function (b) { return b.status === "new"; }).length;
        if (bugBadge) {
          bugBadge.hidden = fresh === 0;
          bugBadge.textContent = String(fresh);
        }

        if (!bugReports.length) {
          bugList.innerHTML = '<p class="note">Nothing reported yet.</p>';
          return;
        }

        bugList.innerHTML = bugReports.map(function (bug) {
          const closed = bug.status === "done" || bug.status === "wont_fix";
          /* Cleared by deleteUser when the account goes, which is the whole
             reason the report can outlive the reporter. */
          const who = bug.fromName ? esc(bug.fromName) : "<em>account removed</em>";

          /* The two lines that make a report actionable. Shown as received and
             escaped: both came from the reporter's browser. */
          const context = [
            bug.page ? '<span class="bug-meta">' + esc(bug.page) + "</span>" : "",
            bug.userAgent ? '<span class="bug-meta">' + esc(bug.userAgent) + "</span>" : "",
          ].filter(Boolean).join("");

          const control = myRole === "organizer"
            ? '<select class="bug-status" data-bug="' + esc(bug.id) + '">' +
                BUG_STATUS.map(function (pair) {
                  return '<option value="' + esc(pair[0]) + '"' +
                    (bug.status === pair[0] ? " selected" : "") + ">" + esc(pair[1]) + "</option>";
                }).join("") +
              "</select>"
            : '<span class="pill">' + esc(BUG_STATUS_LABEL[bug.status] || bug.status) + "</span>";

          return '<article class="bug-row' + (closed ? " is-closed" : "") + '">' +
            '<div class="bug-rowhead">' +
              "<strong>" + who + "</strong>" +
              '<span class="bug-when">' + esc(wishWhen(bug.createdAt)) + "</span>" +
              control +
            "</div>" +
            '<p class="bug-text">' + esc(bug.body) + "</p>" +
            (context ? '<div class="bug-context">' + context + "</div>" : "") +
          "</article>";
        }).join("");
      }

      async function loadBugs() {
        let res;
        try {
          res = await fetch("/api/bugs");
        } catch {
          return say(bugMessage, "Could not reach the server.", true);
        }
        if (!res.ok) return;
        const data = await res.json().catch(() => ({}));
        bugReports = data.reports || [];
        renderBugs();
      }

      /* Delegated, because the rows are rebuilt on every render. */
      bugList.addEventListener("change", async function (event) {
        const id = event.target.getAttribute && event.target.getAttribute("data-bug");
        if (!id) return;
        const status = event.target.value;
        event.target.disabled = true;
        let res;
        try {
          res = await fetch("/api/bugs", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "update", id: id, status: status }),
          });
        } catch {
          event.target.disabled = false;
          return say(bugMessage, "Could not reach the server.", true);
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          event.target.disabled = false;
          return say(bugMessage, data.error || "Could not change that.", true);
        }
        say(bugMessage, "Moved to " + (BUG_STATUS_LABEL[status] || status) + ".", false);
        loadBugs();
      });

      document.getElementById("bug-form").addEventListener("submit", async function (event) {
        event.preventDefault();
        const text = bugBody.value.trim();
        if (!text) return say(bugMessage, "Say what went wrong.", true);

        let res;
        try {
          res = await fetch("/api/bugs", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            /* The same two fields the founder form sends. An organizer filing
               from /admin is on a screen too, and on some browser. */
            body: JSON.stringify({
              body: text,
              page: location.pathname + location.hash,
              userAgent: navigator.userAgent,
            }),
          });
        } catch {
          return say(bugMessage, "Could not reach the server.", true);
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) return say(bugMessage, data.error || "Could not send that.", true);
        bugBody.value = "";
        say(bugMessage, "Reported.", false);
        loadBugs();
      });

      // ---- Programme events ----------------------------------------------

      const evId = document.getElementById("ev-id");
      const evTitle = document.getElementById("ev-title");
      const evKind = document.getElementById("ev-kind");
      const evDate = document.getElementById("ev-date");
      const evStart = document.getElementById("ev-start");
      const evEnd = document.getElementById("ev-end");
      const evLocation = document.getElementById("ev-location");
      const evDescription = document.getElementById("ev-description");
      const evSubmit = document.getElementById("ev-submit");
      const evCancel = document.getElementById("ev-cancel");
      const evMessage = document.getElementById("ev-message");
      const eventList = document.getElementById("event-list");
      const eventForm = document.getElementById("event-form");

      const EVENT_KINDS = {
        session: "Session", milestone: "Milestone", checkpoint: "Checkpoint",
        social: "Social", trip: "Trip",
      };

      let programmeEvents = [];
      /* Which row the form is currently sitting in, or null when it is at home
         adding something new. */
      let editingEventId = null;
      /* Months folded away. Everything before the current one starts closed:
         by week eight most of the list is behind us, and the row somebody came
         to change is almost always the next one, not the fortieth one back. */
      let openPastMonths = false;

      const evFormHome = document.getElementById("ev-form-home");

      /*
       * Put the form back before anything writes to eventList.innerHTML.
       *
       * This is the whole trick and the whole hazard. innerHTML on the list
       * destroys its subtree, and while a row is being edited the live form is
       * inside that subtree \u2014 so a re-render triggered mid-edit would delete
       * the node, taking the half-typed values and every listener with it.
       * Homing it first costs one line and makes the render safe to call from
       * anywhere.
       */
      function homeEventForm() {
        if (eventForm.parentElement !== evFormHome) evFormHome.appendChild(eventForm);
      }

      /*
       * Re-render without the page sliding under the pointer.
       *
       * Moving the form out of its home slot removes its height from above the
       * viewport, so everything below rides up — measured at 264px, which is
       * small enough to look like a glitch and large enough to lose your place
       * in a 45-row list. Holding one element's distance from the top of the
       * window across the re-render pins the whole thing: the row you clicked
       * stays exactly where you clicked it.
       */
      function renderKeepingStill(anchorSelector, render) {
        const before = document.querySelector(anchorSelector);
        const top = before ? before.getBoundingClientRect().top : null;
        render();
        if (top === null) return;
        const after = document.querySelector(anchorSelector);
        if (!after) return;
        const drift = after.getBoundingClientRect().top - top;
        if (drift) window.scrollBy(0, drift);
      }

      function eventWhen(entry) {
        if (!entry.startTime) return "All day";
        return entry.endTime ? entry.startTime + "\u2013" + entry.endTime : entry.startTime;
      }

      function renderEvents() {
        homeEventForm();
        if (!programmeEvents.length) {
          eventList.innerHTML = '<p class="note">Nothing scheduled yet.</p>';
          return;
        }

        // Grouped by month so a thirteen-week programme is scannable rather than
        // ninety undifferentiated rows.
        const months = [];
        for (const entry of programmeEvents) {
          const key = entry.startsOn.slice(0, 7);
          let group = months.find((m) => m.key === key);
          if (!group) { group = { key: key, rows: [] }; months.push(group); }
          group.rows.push(entry);
        }

        const today = new Date().toISOString().slice(0, 10);
        const thisMonth = today.slice(0, 7);

        /* A month is "past" only when all of it is behind us, so the month you
           are living in never folds away underneath you. */
        const pastMonths = months.filter(function (m) { return m.key < thisMonth; });
        const hiddenCount = openPastMonths
          ? 0
          : pastMonths.reduce(function (sum, m) { return sum + m.rows.length; }, 0);

        eventList.innerHTML = months.map(function (group) {
          if (!openPastMonths && group.key < thisMonth) return "";
          const label = new Date(group.key + "-01T00:00:00Z").toLocaleDateString("en-GB", {
            month: "long", year: "numeric", timeZone: "UTC",
          });
          const rows = group.rows.map(function (entry) {
            const past = entry.startsOn < today;
            const editing = entry.id === editingEventId;
            return '<div class="ev-row' + (past ? " is-past" : "") + (editing ? " is-editing" : "") + '">' +
              '<span class="ev-date">' + esc(entry.startsOn.slice(8) + "/" + entry.startsOn.slice(5, 7)) + '</span>' +
              '<span class="ev-time">' + esc(eventWhen(entry)) + '</span>' +
              '<span class="ev-title">' + esc(entry.title) +
                (entry.location ? ' <span class="ev-loc">' + esc(entry.location) + '</span>' : "") +
              '</span>' +
              '<span class="ev-kind">' + esc(EVENT_KINDS[entry.kind] || entry.kind) + '</span>' +
              '<span class="ev-actions">' +
                '<button type="button" data-edit-event="' + esc(entry.id) + '">' + (editing ? "Editing" : "Edit") + '</button>' +
                '<button type="button" class="danger" data-delete-event="' + esc(entry.id) + '">Remove</button>' +
              '</span>' +
            '</div>' +
            /* The form is moved in here after this string is written. Empty
               until then, and only ever one of them on the page. */
            (editing ? '<div class="ev-edit" id="ev-edit-slot"></div>' : "");
          }).join("");
          return '<h3 class="ev-month">' + esc(label) + '</h3>' + rows;
        }).join("");

        if (hiddenCount) {
          eventList.insertAdjacentHTML("afterbegin",
            '<button type="button" class="ghost ev-earlier" data-show-earlier="yes">' +
            "Show " + hiddenCount + " earlier item" + (hiddenCount === 1 ? "" : "s") +
            "</button>");
        } else if (openPastMonths && pastMonths.length) {
          eventList.insertAdjacentHTML("afterbegin",
            '<button type="button" class="ghost ev-earlier" data-show-earlier="no">Hide earlier items</button>');
        }

        /* Last, because it has to happen after innerHTML and because the slot
           only exists when something is being edited. */
        if (editingEventId) {
          const slot = document.getElementById("ev-edit-slot");
          if (slot) slot.appendChild(eventForm);
        }
      }

      async function loadEvents() {
        let res;
        try {
          res = await fetch("/api/programme-events");
        } catch {
          return say(evMessage, "Could not reach the server.", true);
        }
        if (!res.ok) return;
        const data = await res.json().catch(() => ({}));
        programmeEvents = data.events || [];
        renderEvents();
      }

      function resetEventForm() {
        editingEventId = null;
        evId.value = "";
        evTitle.value = "";
        evKind.value = "session";
        evDate.value = "";
        evStart.value = "";
        evEnd.value = "";
        evLocation.value = "";
        evDescription.value = "";
        evSubmit.textContent = "Add to the programme";
        evCancel.hidden = true;
        homeEventForm();
      }

      evCancel.addEventListener("click", function () {
        resetEventForm();
        say(evMessage, "", false);
        evMessage.hidden = true;
        renderEvents();
      });

      eventList.addEventListener("click", async function (event) {
        const earlier = event.target.getAttribute && event.target.getAttribute("data-show-earlier");
        if (earlier) {
          openPastMonths = earlier === "yes";
          renderEvents();
          return;
        }

        const editId = event.target.getAttribute && event.target.getAttribute("data-edit-event");
        if (editId) {
          const entry = programmeEvents.find(function (e) { return e.id === editId; });
          if (!entry) return;
          evId.value = entry.id;
          evTitle.value = entry.title;
          evKind.value = entry.kind;
          evDate.value = entry.startsOn;
          evStart.value = entry.startTime;
          evEnd.value = entry.endTime;
          evLocation.value = entry.location;
          evDescription.value = entry.description;
          evSubmit.textContent = "Save changes";
          evCancel.hidden = false;
          /* Re-render moves the form into this row. No scrollIntoView and no
             focus jump: the form arrives where the click was, which is the
             whole point — editing the last of forty-five events used to throw
             the page 2,200px upwards and leave you to find your way back.
             The anchor is this row's own Edit button, which exists on both
             sides of the render. */
          editingEventId = entry.id;
          renderKeepingStill('[data-edit-event="' + CSS.escape(entry.id) + '"]', renderEvents);
          evTitle.focus({ preventScroll: true });
          return;
        }

        const button = event.target;
        const deleteId = button.getAttribute && button.getAttribute("data-delete-event");
        if (!deleteId) return;

        /* Two-step rather than confirm(), which is how the rest of this page
           asks: a modal blocks the whole page to ask about one row. A
           programme date is something twenty people may already have in their
           own calendars, so it does get asked. */
        if (button.dataset.armed !== "yes") {
          button.dataset.armed = "yes";
          button.textContent = "Sure?";
          setTimeout(function () {
            if (!button.isConnected) return;
            button.dataset.armed = "";
            button.textContent = "Remove";
          }, 4000);
          return;
        }

        let res;
        try {
          res = await fetch("/api/programme-events", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "delete", id: deleteId }),
          });
        } catch {
          return say(evMessage, "Could not reach the server.", true);
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) return say(evMessage, data.error || "Could not remove that.", true);
        say(evMessage, "Removed.", false);
        loadEvents();
      });

      document.getElementById("event-form").addEventListener("submit", async function (event) {
        event.preventDefault();
        let res;
        try {
          res = await fetch("/api/programme-events", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              id: evId.value || undefined,
              title: evTitle.value,
              kind: evKind.value,
              startsOn: evDate.value,
              startTime: evStart.value,
              endTime: evEnd.value,
              location: evLocation.value,
              description: evDescription.value,
            }),
          });
        } catch {
          return say(evMessage, "Could not reach the server.", true);
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) return say(evMessage, data.error || "Could not save that.", true);
        say(evMessage, evId.value ? "Saved." : "Added to the programme.", false);
        resetEventForm();
        loadEvents();
      });

      // ---- Knowledge base ------------------------------------------------

      const kbId = document.getElementById("kb-id");
      const kbTopic = document.getElementById("kb-topic");
      const kbBody = document.getElementById("kb-body");
      const kbPosition = document.getElementById("kb-position");
      const kbSource = document.getElementById("kb-source");
      const kbMessage = document.getElementById("kb-message");
      const kbSize = document.getElementById("kb-size");
      const knowledgeList = document.getElementById("knowledge-list");

      let knowledgeEntries = [];

      function kbClear() {
        kbId.value = "";
        kbTopic.value = "";
        kbBody.value = "";
        kbSource.value = "";
        const highest = knowledgeEntries.reduce((m, e) => Math.max(m, e.position), 0);
        kbPosition.value = String(highest + 10);
      }

      // A transcript import lands dozens of entries under one source, so the
      // way out has to be as cheap as the way in.
      function sourceChips() {
        const counts = new Map();
        for (const e of knowledgeEntries) {
          if (e.status === "archived" || !e.source) continue;
          counts.set(e.source, (counts.get(e.source) || 0) + 1);
        }
        if (counts.size === 0) return "";
        return (
          '<div class="row" style="gap:8px;margin-bottom:12px">' +
          [...counts.entries()]
            .map(([source, n]) =>
              '<span style="display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);border-radius:999px;padding:3px 6px 3px 10px;font-size:0.8125rem">' +
              esc(source) + ' <span class="note" style="margin:0">' + n + "</span>" +
              '<button type="button" class="disclose" data-archive-source="' + esc(source) + '">Archive all</button>' +
              "</span>")
            .join("") +
          "</div>"
        );
      }

      let kbFilter = "";
      const kbOpen = new Set();

      function renderKnowledge() {
        if (!knowledgeEntries.length) {
          knowledgeList.innerHTML = '<p class="note">Nothing yet. Add one below, or paste a session under <strong>Add transcript</strong>.</p>';
          return;
        }

        const needle = kbFilter.trim().toLowerCase();
        const shown = needle
          ? knowledgeEntries.filter((e) =>
              (e.topic + " " + e.body + " " + (e.source || "")).toLowerCase().includes(needle))
          : knowledgeEntries;

        const rows = shown
          .map((e) => {
            const archived = e.status === "archived";
            const open = kbOpen.has(e.id);
            return (
              '<div class="rowline" style="opacity:' + (archived ? "0.5" : "1") + '">' +
              '<strong style="min-width:38px;font-size:0.8125rem">' + e.position + "</strong>" +
              '<span class="grow"><strong>' + esc(e.topic || "(no topic)") + "</strong>" +
              (e.source ? ' <span class="note" style="margin:0">· ' + esc(e.source) + "</span>" : "") +
              (archived ? ' <span class="note" style="margin:0">· archived</span>' : "") +
              "</span>" +
              '<button type="button" class="disclose" data-open="' + e.id + '">' + (open ? "Hide" : "Show") + "</button>" +
              '<button type="button" data-edit="' + e.id + '">Edit</button>' +
              '<button type="button" data-toggle="' + e.id + '">' + (archived ? "Restore" : "Archive") + "</button>" +
              '<button type="button" data-delete="' + e.id + '" title="Remove permanently">Delete</button>' +
              "</div>" +
              (open ? '<p class="note expanded" style="margin:0">' + esc(e.body) + "</p>" : "")
            );
          })
          .join("");

        const count = needle
          ? shown.length + " of " + knowledgeEntries.length + " entries"
          : knowledgeEntries.length + " entries";

        knowledgeList.innerHTML =
          sourceChips() +
          '<div class="row" style="gap:10px;align-items:center;margin-bottom:10px">' +
          '<input id="kb-filter" placeholder="Filter by topic, text or source" style="flex:1" value="' + esc(kbFilter) + '" />' +
          '<span class="note" style="margin:0">' + count + "</span>" +
          "</div>" +
          (shown.length ? '<div class="scroller">' + rows + "</div>" : '<p class="note">Nothing matches that.</p>');

        const filterBox = document.getElementById("kb-filter");
        filterBox.addEventListener("input", () => {
          kbFilter = filterBox.value;
          const at = filterBox.selectionStart;
          renderKnowledge();
          // Re-rendering replaces the input, so put the caret back.
          const again = document.getElementById("kb-filter");
          again.focus();
          again.setSelectionRange(at, at);
        });

        knowledgeList.querySelectorAll("button[data-open]").forEach((b) => {
          b.addEventListener("click", () => {
            const id = b.dataset.open;
            if (kbOpen.has(id)) kbOpen.delete(id);
            else kbOpen.add(id);
            renderKnowledge();
          });
        });

        knowledgeList.querySelectorAll("button[data-archive-source]").forEach((b) => {
          b.addEventListener("click", async () => {
            const source = b.dataset.archiveSource;
            // A two-step rather than a confirm() dialog: a modal blocks the
            // page, and this is reversible anyway.
            if (b.dataset.armed !== "yes") {
              b.dataset.armed = "yes";
              b.textContent = "Sure?";
              setTimeout(() => {
                if (!b.isConnected) return;
                b.dataset.armed = "";
                b.textContent = "Archive all";
              }, 4000);
              return;
            }
            const { ok, data } = await knowledgeApi({ action: "archiveSource", source });
            if (!ok) return;
            say(kbMessage, "Archived " + data.archived + " from " + source + ".", false);
            loadKnowledge();
      loadShared();
          });
        });

        knowledgeList.querySelectorAll("button[data-delete]").forEach((b) => {
          b.addEventListener("click", async () => {
            const entry = knowledgeEntries.find((e) => e.id === b.dataset.delete);
            if (!entry) return;
            // Two-step rather than confirm(): a modal blocks the page, and this
            // matches how Archive all already asks. Unlike archiving, there is
            // no way back from this one, so the armed label says so.
            if (b.dataset.armed !== "yes") {
              b.dataset.armed = "yes";
              b.textContent = "Delete for good?";
              setTimeout(() => {
                if (!b.isConnected) return;
                b.dataset.armed = "";
                b.textContent = "Delete";
              }, 4000);
              return;
            }
            const { ok } = await knowledgeApi({ action: "delete", id: entry.id });
            if (!ok) return;
            kbOpen.delete(entry.id);
            // Clear the edit form if it was holding the row that just went.
            if (kbId.value === entry.id) kbClear();
            say(kbMessage, "Deleted " + (entry.topic || "that entry") + ". That one is gone for good.", false);
            loadKnowledge();
      loadShared();
          });
        });

        knowledgeList.querySelectorAll("button[data-edit]").forEach((b) => {
          b.addEventListener("click", () => {
            const entry = knowledgeEntries.find((e) => e.id === b.dataset.edit);
            if (!entry) return;
            kbId.value = entry.id;
            kbTopic.value = entry.topic;
            kbBody.value = entry.body;
            kbPosition.value = String(entry.position);
            kbSource.value = entry.source || "";
            kbTopic.focus();
          });
        });

        knowledgeList.querySelectorAll("button[data-toggle]").forEach((b) => {
          b.addEventListener("click", async () => {
            const entry = knowledgeEntries.find((e) => e.id === b.dataset.toggle);
            if (!entry) return;
            await knowledgeApi({ action: entry.status === "archived" ? "restore" : "archive", id: entry.id });
            loadKnowledge();
      loadShared();
          });
        });
      }

      async function knowledgeApi(body) {
        let res;
        try {
          res = await fetch("/api/knowledge", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
        } catch {
          say(kbMessage, "Could not reach the server.", true);
          return { ok: false, data: {} };
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) say(kbMessage, data.error || "That did not work.", true);
        return { ok: res.ok, data };
      }

      async function loadKnowledge() {
        let res;
        try {
          res = await fetch("/api/knowledge");
        } catch {
          return;
        }
        if (!res.ok) return;
        const data = await res.json();
        knowledgeEntries = data.entries || [];
        const size = data.size || {};
        /* approxTokens was already guarded and this was not, so a response
           without the size block rendered "NaN% of the budget" to the
           operator. */
        const pct = size.budgetChars
          ? Math.round(((size.chars || 0) / size.budgetChars) * 100)
          : 0;
        kbSize.textContent =
          "Active pack: ~" + (size.approxTokens || 0) + " tokens, " + pct + "% of the budget." +
          (size.truncated ? " Over budget. The lowest-ordered entries are being dropped." : "");
        renderKnowledge();
        if (!kbId.value) kbClear();
      }

      document.getElementById("kb-new").addEventListener("click", kbClear);

      document.getElementById("knowledge-form").addEventListener("submit", async (event) => {
        event.preventDefault();
        const { ok, data } = await knowledgeApi({
          action: "save",
          id: kbId.value || undefined,
          topic: kbTopic.value,
          body: kbBody.value,
          position: Number(kbPosition.value),
          source: kbSource.value,
        });
        if (!ok) return;
        if (data.warning && data.warning.length) {
          say(kbMessage,
            "Saved, but the text still contains: " + data.warning.join(", ") +
            ". Sprint Buddy will say that to the cohort. Edit it out unless you meant it.",
            true);
        } else {
          say(kbMessage, "Saved. Sprint Buddy uses it on the next message.", false);
        }
        kbId.value = data.id || "";
        loadKnowledge();
      loadShared();
      });

      // ---- Transcript ingest ------------------------------------------------
      //
      // The transcript is split here rather than server-side so each request
      // stays short. One call per piece keeps every request well inside any
      // proxy timeout and gives a progress count instead of a spinner that
      // might be dead. Nothing is written until "Add selected".

      const ingestSource = document.getElementById("ingest-source");
      const ingestText = document.getElementById("ingest-text");
      const ingestMessage = document.getElementById("ingest-message");
      const ingestReview = document.getElementById("ingest-review");
      const ingestGo = document.getElementById("ingest-go");
      const ingestCancel = document.getElementById("ingest-cancel");

      const CHUNK_CHARS = 24000;
      let candidates = [];
      let stopRequested = false;
      const draftOpen = new Set();

      function splitTranscript(text) {
        const paragraphs = text.split(/\n\s*\n/);
        const chunks = [];
        let current = "";
        const push = () => {
          if (current.trim().length >= 200) chunks.push(current.trim());
          current = "";
        };
        for (const paragraph of paragraphs) {
          if (paragraph.length > CHUNK_CHARS) {
            push();
            for (let i = 0; i < paragraph.length; i += CHUNK_CHARS) {
              chunks.push(paragraph.slice(i, i + CHUNK_CHARS));
            }
            continue;
          }
          if (current.length + paragraph.length + 2 > CHUNK_CHARS) push();
          current += (current ? "\n\n" : "") + paragraph;
        }
        push();
        return chunks;
      }

      function renderCandidates() {
        if (!candidates.length) {
          ingestReview.innerHTML = "";
          return;
        }
        const chosen = candidates.filter((c) => c.keep).length;
        const flaggedCount = candidates.filter((c) => (c.leaks || []).length).length;

        // Collapsed by default: 25 drafts should fit on a screen, not fill
        // several. The action bar goes above the list so it is reachable
        // without scrolling to the end of it.
        const rows = candidates
          .map((c, i) => {
            const open = draftOpen.has(i);
            const leaks = c.leaks || [];
            return (
              '<div class="rowline">' +
              '<input type="checkbox" class="check" data-keep="' + i + '"' + (c.keep ? " checked" : "") + " />" +
              '<span class="grow"><strong>' + esc(c.topic || "(no topic)") + "</strong>" +
              (leaks.length ? ' <span style="color:#f7768e">· name found</span>' : "") +
              "</span>" +
              '<button type="button" class="disclose" data-draft="' + i + '">' + (open ? "Hide" : "Show") + "</button>" +
              "</div>" +
              (leaks.length
                ? '<p class="flagged">Looks like it still contains: ' + esc(leaks.join(", ")) +
                  ". Edit it out or untick this one.</p>"
                : "") +
              (open
                ? '<div class="expanded">' +
                  '<input data-topic="' + i + '" maxlength="120" value="' + esc(c.topic) + '" />' +
                  '<textarea data-body="' + i + '" rows="4" maxlength="8000" style="margin-top:6px">' +
                  esc(c.body) + "</textarea></div>"
                : "")
            );
          })
          .join("");

        ingestReview.innerHTML =
          '<div class="stickybar">' +
          '<div class="row" style="align-items:center;gap:10px">' +
          '<button type="button" id="ingest-add">Add ' + chosen + " selected</button>" +
          '<button type="button" id="ingest-discard">Discard all</button>' +
          '<span class="note" style="margin:0">' + candidates.length + " drafts" +
          (flaggedCount ? " · " + flaggedCount + " flagged" : "") + "</span>" +
          "</div></div>" +
          '<div class="scroller">' + rows + "</div>";

        ingestReview.querySelectorAll("input[data-keep]").forEach((el) => {
          el.addEventListener("change", () => {
            candidates[Number(el.dataset.keep)].keep = el.checked;
            const n = candidates.filter((c) => c.keep).length;
            const button = document.getElementById("ingest-add");
            if (button) button.textContent = "Add " + n + " selected";
          });
        });
        ingestReview.querySelectorAll("button[data-draft]").forEach((el) => {
          el.addEventListener("click", () => {
            const i = Number(el.dataset.draft);
            if (draftOpen.has(i)) draftOpen.delete(i);
            else draftOpen.add(i);
            renderCandidates();
          });
        });
        ingestReview.querySelectorAll("input[data-topic]").forEach((el) => {
          el.addEventListener("input", () => { candidates[Number(el.dataset.topic)].topic = el.value; });
        });
        ingestReview.querySelectorAll("textarea[data-body]").forEach((el) => {
          el.addEventListener("input", () => { candidates[Number(el.dataset.body)].body = el.value; });
        });

        document.getElementById("ingest-discard").addEventListener("click", () => {
          candidates = [];
          draftOpen.clear();
          renderCandidates();
          ingestText.hidden = false;
          say(ingestMessage, "Drafts discarded. Nothing was saved.", false);
        });

        document.getElementById("ingest-add").addEventListener("click", async () => {
          const keep = candidates.filter((c) => c.keep && c.body.trim());
          if (!keep.length) { say(ingestMessage, "Nothing ticked.", true); return; }
          const { ok, data } = await knowledgeApi({
            action: "importBatch",
            source: ingestSource.value.trim(),
            entries: keep.map((c) => ({ topic: c.topic, body: c.body })),
          });
          if (!ok) { say(ingestMessage, (data && data.error) || "Could not add those.", true); return; }
          candidates = [];
          draftOpen.clear();
          renderCandidates();
          ingestText.value = "";
          ingestText.hidden = false;
          say(ingestMessage, "Added " + data.saved + ". Sprint Buddy uses them on the next message.", false);
          loadKnowledge();
      loadShared();
        });
      }

      ingestCancel.addEventListener("click", () => { stopRequested = true; });

      document.getElementById("ingest-form").addEventListener("submit", async (event) => {
        event.preventDefault();
        const source = ingestSource.value.trim();
        const text = ingestText.value.trim();
        if (!source) { say(ingestMessage, "Name whose session it is first. For your records, not for the cohort.", true); return; }
        if (text.length < 200) { say(ingestMessage, "That is too short to be a session.", true); return; }

        const chunks = splitTranscript(text);
        candidates = [];
        draftOpen.clear();
        stopRequested = false;
        ingestGo.disabled = true;
        ingestCancel.hidden = false;

        for (let i = 0; i < chunks.length; i++) {
          if (stopRequested) break;
          say(ingestMessage, "Reading piece " + (i + 1) + " of " + chunks.length + "…", false);
          const { ok, data } = await knowledgeApi({ action: "extract", source, transcript: chunks[i] });
          if (!ok) {
            // One bad piece should not throw away the pieces that worked.
            say(ingestMessage, (data && data.error) || "That piece could not be read. Carrying on.", true);
            continue;
          }
          for (const c of data.candidates || []) {
            candidates.push({ topic: c.topic, body: c.body, leaks: c.leaks || [], keep: !(c.leaks || []).length });
          }
          renderCandidates();
        }

        ingestGo.disabled = false;
        ingestCancel.hidden = true;
        // 14k words are not useful while reviewing; fold the box away.
        if (candidates.length) ingestText.hidden = true;

        if (stopRequested) {
          say(ingestMessage, "Stopped. " + candidates.length + " drafts so far, nothing saved yet.", false);
        } else if (!candidates.length) {
          say(ingestMessage, "Nothing in there was worth adding.", false);
        } else {
          const flagged = candidates.filter((c) => c.leaks.length).length;
          say(ingestMessage,
            "Done. " + candidates.length + " drafts to review." +
            (flagged ? " " + flagged + " still contain a name and are unticked." : ""),
            false);
        }
      });

      // ---- Shared conversations -------------------------------------------
      //
      // The read half of a feature that only ever had a write half. Founders
      // could hand a conversation over and no screen ever showed it.

      const sharedList = document.getElementById("shared-list");
      const sharedMessage = document.getElementById("shared-message");
      let sharedThreads = [];
      const sharedOpen = new Set();

      function relativeDay(iso) {
        if (!iso) return "";
        const then = Date.parse(iso.includes("T") ? iso : iso.replace(" ", "T") + "Z");
        if (Number.isNaN(then)) return "";
        const days = Math.floor((Date.now() - then) / 86400000);
        if (days <= 0) return "today";
        if (days === 1) return "yesterday";
        if (days < 7) return days + "d ago";
        return Math.floor(days / 7) + "w ago";
      }

      function renderShared() {
        if (!sharedThreads.length) {
          sharedList.innerHTML =
            '<p class="note">Nothing shared yet. A founder has to hand a conversation over from their own sidebar.</p>';
          return;
        }

        /* Archived ones drop to the bottom rather than out of sight. The point
           of archiving is a shorter list, not a hidden one. */
        const active = sharedThreads.filter((t) => t.filing !== "archived");
        const archived = sharedThreads.filter((t) => t.filing === "archived");

        const row = (t) => {
          const open = sharedOpen.has(t.id);
          const isArchived = t.filing === "archived";
          const transcript = (t.messages || [])
            .map((m) =>
              '<p style="margin:0 0 10px"><strong style="color:var(--muted);font-size:0.75rem;text-transform:uppercase;letter-spacing:0.06em">' +
              (m.role === "user" ? esc(t.founderName || "Founder") : "Sprint Buddy") +
              "</strong><br />" + esc(m.content).replace(/\n/g, "<br />") + "</p>")
            .join("");
          return (
            '<div class="rowline' + (isArchived ? " is-archived" : "") + '">' +
            '<span class="grow"><strong>' + esc(t.founderName || t.founderEmail) + "</strong>" +
            ' <span class="note" style="margin:0">· ' + esc(t.title || "Untitled") + "</span>" +
            (t.seenAt || isArchived ? "" : ' <span style="color:var(--accent);font-size:0.75rem">· new</span>') +
            "</span>" +
            '<span class="note" style="margin:0">' + esc(relativeDay(t.updatedAt)) + "</span>" +
            '<button type="button" class="disclose" data-shared="' + esc(t.id) + '">' +
            (open ? "Close" : "Read") + "</button>" +
            '<button type="button" class="disclose" data-file="' + (isArchived ? "restore" : "archive") + '" data-id="' + esc(t.id) + '">' +
            (isArchived ? "Put back" : "Archive") + "</button>" +
            '<button type="button" class="disclose danger" data-file="remove" data-id="' + esc(t.id) + '">Remove</button>' +
            "</div>" +
            (open
              ? '<div class="expanded" style="max-width:62ch">' + transcript + "</div>"
              : "")
          );
        };

        sharedList.innerHTML =
          '<p class="note" style="margin:0 0 10px">' + active.length +
          " conversation" + (active.length === 1 ? "" : "s") + " to read" +
          (archived.length ? " · " + archived.length + " archived" : "") + ".</p>" +
          '<div class="scroller">' +
          active.map(row).join("") +
          (archived.length
            ? '<p class="note" style="margin:14px 0 6px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;font-size:0.6875rem">Archived</p>' +
              archived.map(row).join("")
            : "") +
          "</div>";

        sharedList.querySelectorAll("button[data-file]").forEach((b) => {
          b.addEventListener("click", async () => {
            const action = b.dataset.file;
            const id = b.dataset.id;

            /* Removing asks, the way the rest of this page asks: two steps
               rather than a modal. Archiving does not — it is one click back. */
            if (action === "remove" && b.dataset.armed !== "yes") {
              b.dataset.armed = "yes";
              b.textContent = "Take it off the list?";
              setTimeout(() => {
                if (!b.isConnected) return;
                b.dataset.armed = "";
                b.textContent = "Remove";
              }, 4000);
              return;
            }

            let res;
            try {
              res = await fetch("/api/admin/shared", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action, id }),
              });
            } catch {
              return say(sharedMessage, "Could not reach the server.", true);
            }
            const data = await res.json().catch(() => ({}));
            if (!res.ok) return say(sharedMessage, data.error || "That did not work.", true);
            say(sharedMessage,
              action === "archive" ? "Archived."
                : action === "restore" ? "Back on the list."
                : "Taken off the list. The founder still has their conversation.",
              false);
            loadShared();
          });
        });

        sharedList.querySelectorAll("button[data-shared]").forEach((b) => {
          b.addEventListener("click", async () => {
            const id = b.dataset.shared;
            if (sharedOpen.has(id)) {
              sharedOpen.delete(id);
              renderShared();
              return;
            }
            sharedOpen.add(id);
            renderShared();
            // Stamped on first open only. The founder learns it landed, not
            // how often it is read.
            const entry = sharedThreads.find((t) => t.id === id);
            if (entry && !entry.seenAt) {
              try {
                await fetch("/api/admin/shared", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ action: "seen", id }),
                });
                entry.seenAt = new Date().toISOString();
              } catch { /* the read still happened; the stamp can wait */ }
            }
          });
        });
      }

      async function loadShared() {
        let res;
        try {
          res = await fetch("/api/admin/shared");
        } catch {
          say(sharedMessage, "Could not reach the server.", true);
          return;
        }
        if (!res.ok) return;
        const data = await res.json();
        sharedThreads = data.threads || [];
        renderShared();
      }

      // ---- Broadcast ----------------------------------------------------
      //
      // The send button stays disabled until three things are true: a test of
      // this exact wording has been delivered, somebody is selected, and the
      // typed number matches the count. The server checks all three again. This
      // copy stops the mistake; the server copy is what makes it impossible.

      const bcSubject = document.getElementById("bc-subject");
      const bcBody = document.getElementById("bc-body");
      const bcPeople = document.getElementById("bc-people");
      const bcRoleFounder = document.getElementById("bc-role-founder");
      const bcRoleOrganizer = document.getElementById("bc-role-organizer");
      const bcRoleMentor = document.getElementById("bc-role-mentor");
      const bcCount = document.getElementById("bc-count");
      const bcConfirm = document.getElementById("bc-confirm");
      const bcGo = document.getElementById("bc-go");
      const bcTest = document.getElementById("bc-test");
      const bcTestState = document.getElementById("bc-test-state");
      const bcMessage = document.getElementById("bc-message");
      const bcHistory = document.getElementById("bc-history");

      let bcRoster = [];
      let bcPicked = new Set();
      // The exact wording that was last test-sent. Editing anything clears it.
      let bcTestedWording = null;

      function bcWording() {
        return bcSubject.value.trim() + " " + bcBody.value.trim();
      }

      function bcSelected() {
        const roles = [];
        if (bcRoleFounder.checked) roles.push("founder");
        if (bcRoleOrganizer.checked) roles.push("organizer");
        if (bcRoleMentor.checked) roles.push("mentor");
        // Mirrors the server's union-and-deduplicate, so the number shown here
        // is the number the server will demand as confirmation.
        const set = new Set();
        bcRoster.forEach(function (person) {
          if (roles.indexOf(person.role) !== -1 || bcPicked.has(person.email)) {
            set.add(person.email);
          }
        });
        return { roles: roles, emails: Array.from(bcPicked), count: set.size };
      }

      function bcRefresh() {
        const chosen = bcSelected();
        const count = chosen.count;
        bcCount.hidden = false;
        bcCount.className = "message " + (count ? "ok" : "error");
        bcCount.textContent = count
          ? count + (count === 1 ? " person will receive this." : " people will receive this.")
          : "Nobody is selected.";

        const tested = bcTestedWording !== null && bcTestedWording === bcWording();
        if (!tested) bcTestState.textContent = "Not tested yet.";
        bcConfirm.placeholder = String(count);
        bcGo.disabled = !(tested && count > 0 && Number(bcConfirm.value) === count);
      }

      function bcRenderPeople() {
        bcPeople.textContent = "";
        bcRoster.forEach(function (person) {
          const label = document.createElement("label");
          const box = document.createElement("input");
          box.type = "checkbox";
          box.checked = bcPicked.has(person.email);
          box.addEventListener("change", function () {
            if (box.checked) bcPicked.add(person.email);
            else bcPicked.delete(person.email);
            bcRefresh();
          });
          const who = document.createElement("span");
          who.textContent = person.name + " (" + person.email + ")";
          const role = document.createElement("span");
          role.className = "role";
          role.textContent = person.role;
          label.append(box, who, role);
          bcPeople.append(label);
        });
      }

      function bcRenderHistory(rows) {
        bcHistory.textContent = "";
        if (!rows.length) {
          const empty = document.createElement("p");
          empty.className = "note";
          empty.textContent = "Nothing sent yet.";
          bcHistory.append(empty);
          return;
        }
        rows.forEach(function (row) {
          const item = document.createElement("div");
          item.className = "bc-sent";
          const subject = document.createElement("div");
          subject.textContent = row.subject;
          const when = document.createElement("div");
          when.className = "when";
          const failed = row.failed ? ", " + row.failed + " failed" : "";
          when.textContent =
            row.created_at + " to " + row.audience + ": " + row.sent + " sent" + failed +
            " (by " + row.actor_email + ")";
          item.append(subject, when);
          bcHistory.append(item);
        });
      }

      document.querySelectorAll(".bc-tag").forEach(function (button) {
        button.addEventListener("click", function () {
          const tag = "{{" + button.dataset.tag + "}}";
          const start = bcBody.selectionStart == null ? bcBody.value.length : bcBody.selectionStart;
          const end = bcBody.selectionEnd == null ? bcBody.value.length : bcBody.selectionEnd;
          bcBody.value = bcBody.value.slice(0, start) + tag + bcBody.value.slice(end);
          bcBody.focus();
          bcBody.setSelectionRange(start + tag.length, start + tag.length);
          bcRefresh();
        });
      });

      [bcSubject, bcBody].forEach(function (field) {
        field.addEventListener("input", bcRefresh);
      });
      [bcRoleFounder, bcRoleOrganizer, bcRoleMentor].forEach(function (box) {
        box.addEventListener("change", bcRefresh);
      });
      bcConfirm.addEventListener("input", bcRefresh);

      async function bcPost(payload) {
        let res;
        try {
          res = await fetch("/api/admin/broadcast", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
        } catch {
          return { error: "Could not reach the server." };
        }
        try {
          return await res.json();
        } catch {
          return { error: "The server returned an error (" + res.status + ") with no details." };
        }
      }

      bcTest.addEventListener("click", async function () {
        bcTest.disabled = true;
        bcMessage.hidden = true;
        const wording = bcWording();
        const data = await bcPost({
          action: "test",
          subject: bcSubject.value,
          body: bcBody.value,
        });
        bcTest.disabled = false;
        if (data.error) {
          bcTestedWording = null;
          say(bcMessage, data.error, true);
          bcRefresh();
          return;
        }
        bcTestedWording = wording;
        bcTestState.textContent = "Test sent to " + data.to + ". Read it before sending.";
        say(bcMessage, "Test sent. Nothing has gone to the cohort.", false);
        bcRefresh();
      });

      document.getElementById("bc-send").addEventListener("submit", async function (event) {
        event.preventDefault();
        const chosen = bcSelected();
        bcGo.disabled = true;
        bcGo.textContent = "Sending to " + chosen.count + "...";
        const data = await bcPost({
          action: "send",
          subject: bcSubject.value,
          body: bcBody.value,
          roles: chosen.roles,
          emails: chosen.emails,
          confirm: Number(bcConfirm.value),
        });
        bcGo.textContent = "Send to everyone selected";
        if (data.error) {
          say(bcMessage, data.error, true);
          bcRefresh();
          return;
        }
        const failures = (data.failures || []).map(function (f) { return f.email; }).join(", ");
        say(
          bcMessage,
          data.sent + " sent" +
            (data.failed ? ", " + data.failed + " failed: " + failures : "") + ".",
          data.failed > 0,
        );
        // A sent message must not be one stray click away from going out twice.
        bcConfirm.value = "";
        bcTestedWording = null;
        bcRefresh();
        loadBroadcast();
      });

      async function loadBroadcast() {
        let res;
        try {
          res = await fetch("/api/admin/broadcast");
        } catch {
          return;
        }
        if (!res.ok) return;
        const data = await res.json();
        bcRoster = data.people || [];
        bcRenderPeople();
        bcRenderHistory(data.history || []);
        if (!data.configured) {
          say(bcMessage, "Email is not configured, so nothing can be sent.", true);
        }
        bcRefresh();
      }

      /* ── This week ──────────────────────────────────────────────────────
         The mentor's page. Reads what the other tabs already read; writes
         nothing.

         Ordered by what would make somebody open it again. A grid of twenty
         founders is not that — it is a thing you scan once and never return
         to, because it never says anything. Three names with a reason is.

         Everything here is derived from signals a founder either published on
         purpose (a shared conversation) or that the cohort dashboard already
         showed (a check-in score, a missed deadline). No new access. */
      async function loadMentor() {
        const box = document.getElementById("mentor-view");
        if (!box) return;

        let cohort = null, shared = [], deadlines = null, programme = null;
        try {
          const [c, sh, d, pr] = await Promise.all([
            fetch("/api/cohort").then((r) => (r.ok ? r.json() : null)).catch(() => null),
            fetch("/api/admin/shared").then((r) => (r.ok ? r.json() : null)).catch(() => null),
            fetch("/api/deadlines?view=status").then((r) => (r.ok ? r.json() : null)).catch(() => null),
            fetch("/api/programme").then((r) => (r.ok ? r.json() : null)).catch(() => null),
          ]);
          cohort = c; shared = (sh && sh.threads) || []; deadlines = d; programme = pr;
        } catch {
          box.innerHTML = '<p class="note">Could not reach the server.</p>';
          return;
        }
        if (!cohort) {
          box.innerHTML = '<p class="note">Could not read the cohort.</p>';
          return;
        }

        const teams = cohort.teams || [];
        const week = cohort.week || 1;
        const settled = Math.max(1, week - 1);
        const scoreOf = (t) => (t.temp && t.temp[settled - 1]) || 0;

        /* Who to talk to. Ranked, then cut to three — a mentor has one evening,
           not twenty. The reason is the point: a name with no reason beside it
           is another grid. */
        /* Silence is only a reason once a week has actually finished.
           In week one every founder has "no check-in in week 1", which is
           three names with the same non-reason on the page a mentor is meeting
           for the first time — and a page that cries wolf on day one is one
           they stop opening. The cohort dashboard already refuses to count a
           missing check-in before the week is over; this has to as well. */
        const weekSettled = week > 1;
        const reasons = [];
        for (const t of teams) {
          const v = scoreOf(t);
          if (v >= 3) reasons.push({ name: t.name, why: "showing strain in week " + settled, rank: 0 });
          else if (v === 2) reasons.push({ name: t.name, why: "worth a look, week " + settled, rank: 1 });
          else if (v === 0 && weekSettled) reasons.push({ name: t.name, why: "no check-in in week " + settled, rank: 2 });
        }
        /* Somebody who handed over a conversation asked to be read, which
           outranks anything inferred from a score. */
        const unseen = shared.filter((t) => !t.seenAt);
        for (const t of unseen) {
          const already = reasons.find((r) => r.name === t.founderName);
          if (already) { already.why = "shared a conversation, and " + already.why; already.rank = -1; }
          else reasons.push({ name: t.founderName, why: "shared a conversation with you", rank: -1 });
        }
        reasons.sort((a, b) => a.rank - b.rank);
        const top = reasons.slice(0, 3);

        const sections = [];

        sections.push(
          '<section class="panel"><h2>Week ' + week + '</h2>' +
          (programme && programme.phase
            ? '<p class="note" style="margin-top:0">The cohort is on <strong>' + esc(programme.phase) + '</strong>' +
              (programme.title ? ', ' + esc(programme.title) : "") + ".</p>"
            : '<p class="note" style="margin-top:0">No programme set for this week yet.</p>') +
          "</section>");

        if (top.length) {
          sections.push(
            '<section class="panel"><h2>Worth a conversation</h2>' +
            '<ul class="mentor-list">' +
            top.map((r) => '<li><strong>' + esc(r.name) + "</strong><span>" + esc(r.why) + "</span></li>").join("") +
            "</ul></section>");
        }

        /*
         * No "Handed to you" section here.
         *
         * It listed the same conversations as the Shared tab, one tab away,
         * and this page is meant to be the short answer to "who should I talk
         * to". A founder who has just handed something over still shows up in
         * "Worth a conversation" above, ranked ahead of anything inferred from
         * a score, which is the part that belongs on a landing screen.
         */

        /* The team map's one useful sentence, which is invisible one profile
           at a time: what nobody in the room is good at. */
        const map = cohort.map || [];
        if (map.length) {
          const TYPES = [["wonder","Wonder"],["invention","Invention"],["discernment","Discernment"],
                         ["galvanizing","Galvanizing"],["enablement","Enablement"],["tenacity","Tenacity"]];
          const gaps = TYPES.filter(([id]) => !map.some((r) => (r.gifts || []).includes(id)));

          /*
           * The gap claim needs enough people to be a claim.
           *
           * Six kinds of work and two gifts each: one founder leaves four
           * "gaps" by arithmetic, and the page said the cohort was short of
           * four things on the strength of a single profile. That is the same
           * failure as crying wolf on day one — technically derived from the
           * data, and telling a mentor something that is not true.
           *
           * Half the cohort and at least three people. Below that the honest
           * thing is to report the sample and say nothing about the cohort.
           */
          const enough = map.length >= 3 && map.length >= teams.length / 2;
          const list = (labels) =>
            labels.length <= 1
              ? labels[0] || ""
              : labels.slice(0, -1).join(", ") + " or " + labels[labels.length - 1];

          sections.push(
            '<section class="panel"><h2>What this cohort is short of</h2>' +
            "<p class=\"note\" style=\"margin-top:0\">" +
            (!enough
              ? map.length + " of " + teams.length + " founders have shared a working-style profile" +
                (map.length === 1 ? "" : " so far") +
                ". Too few to say what the cohort is short of yet."
              : gaps.length
                ? "Nobody who has shared a working-style profile is gifted at <strong>" +
                  list(gaps.map(([, label]) => label)) +
                  "</strong>. That is the work they will avoid without noticing." +
                  " Based on " + map.length + " of " + teams.length + " founders."
                : "Every kind of work has somebody gifted at it." +
                  " Based on " + map.length + " of " + teams.length + " founders.") +
            "</p></section>");
        }

        const behind = deadlines && deadlines.deadlines
          ? deadlines.deadlines.filter((d) => d.status !== "archived" && (d.behind || []).length)
          : [];
        if (behind.length) {
          sections.push(
            '<section class="panel"><h2>Not done yet</h2><ul class="mentor-list">' +
            behind.slice(0, 4).map((d) =>
              "<li><strong>" + esc(d.title) + "</strong><span>" + d.behind.length +
              (d.behind.length === 1 ? " founder" : " founders") + " · due " + esc(d.dueDate) + "</span></li>").join("") +
            "</ul></section>");
        }

        /* The empty state is the one a mentor is most likely to meet, because
           on day one none of the above exists. Saying what will appear is more
           use than an empty page that looks broken.

           Decided on whether there is any signal at all, not on how many boxes
           happened to get built — an earlier version counted sections, and a
           list of "nobody has checked in yet" was enough to suppress it. */
        const anySignal = top.length || shared.length || map.length || behind.length;
        if (!anySignal) {
          sections.push(
            '<section class="panel"><h2>Nothing to read yet</h2>' +
            '<p class="note" style="margin-top:0">' +
            "This page fills in as the cohort uses the app: founders who check in appear " +
            "when their week looks hard, conversations appear when somebody hands one over, " +
            "and the working-style map appears once people have taken the assessment. " +
            "Nothing here is anything a founder has not chosen to share." +
            "</p></section>");
        }

        box.innerHTML = sections.join("");
      }

      /*
       * A mentor loads two of these. The rest read organizer-only endpoints
       * and would fill the console with 403s that mean nothing is wrong —
       * noise that hides a real failure when there is one.
       */
      load().then(() => {
        loadMentor();
        loadShared();
        loadWishes();
        /* Above the mentor return: they read the queue too, and the badge has
           to be right before anybody opens the tab. */
        loadBugs();
        if (myRole === "mentor") return;
        loadDeadlines();
        loadLibrary();
        loadProgramme();
        loadEvents();
        loadKnowledge();
        loadBroadcast();
      });
    </script>
  </body>
</html>
