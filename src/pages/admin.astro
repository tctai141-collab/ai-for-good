        /* `required` on a hidden input does nothing: hidden inputs are barred
           from constraint validation, so the browser will not stop an empty
           submit the way it did when this was <input type="date" required>.
           The server still rejects it, but saying so here is faster and says
           which field. */
        if (!due.value) return say(message, "Pick a due date.", true);

