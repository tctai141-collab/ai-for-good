---
// Where a founder or organizer turns a one-time invite link into an account.
// Deliberately standalone rather than part of the main app shell: it is the one
// page a signed-out person needs to reach, and it must work even if the app
// bundle changes.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- A setup link is a credential; keep it out of referrers and indexes. -->
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Set your password · Sprint Buddy</title>
    <style>
      :root {
        --bg: #0b0c0f;
        --panel: rgba(20, 22, 27, 0.9);
        --text: #f4f4f5;
        --muted: #9ca3af;
        /* Signal red, matching --brand-accent. This page carries its own token
           set under a different name, which is how the recolour missed it, and
           it is the first screen a founder ever sees. */
        --accent: #5e6ad2;
        --danger: #f4746a;
        --border: rgba(255, 255, 255, 0.12);
        --font: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        /* One face across the app. Kept as a token because this page reads
           it in a few places. */
        --serif: var(--font);
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; background: var(--bg); }
      body {
        font-family: var(--font);
        color: var(--text);
        display: grid;
        place-items: center;
        min-height: 100vh;
        padding: 24px;
      }
      main { width: 100%; max-width: 420px; }
      h1 {
        font-family: var(--serif);
        font-size: 2rem;
        line-height: 1.15;
        margin: 0 0 8px;
      }
      .lede { color: var(--muted); font-size: 0.9375rem; margin: 0 0 28px; line-height: 1.5; }
      .panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 28px;
      }
      label { display: block; margin-bottom: 18px; }
      .label-text {
        display: block;
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 8px;
      }
      input {
        width: 100%;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: rgba(0, 0, 0, 0.35);
        color: var(--text);
        font-family: var(--font);
        font-size: 1rem;
      }
      input:focus { outline: none; border-color: var(--accent); }
      button {
        width: 100%;
        padding: 13px;
        border: 0;
        border-radius: 10px;
        background: var(--accent);
        color: #0b0c0f;
        font-family: var(--font);
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
      }
      button:disabled { opacity: 0.55; cursor: default; }
      .hint { color: var(--muted); font-size: 0.8125rem; margin: -8px 0 18px; }
      .message { margin-top: 18px; font-size: 0.875rem; line-height: 1.5; }
      .message.error { color: var(--danger); }
      .message.ok { color: var(--accent); }
      [hidden] { display: none !important; }

      /* The animated gradient. Fixed and behind everything; the panel keeps
         its own solid background so the form stays legible over it. */
      #backdrop {
        position: fixed;
        inset: 0;
        /*
         * Zero, not -1. A negative z-index puts the canvas behind its parent's
         * background box, and body here paints an opaque one, so the gradient
         * rendered perfectly and was covered by a flat colour. At 0 it sits
         * above the background and below `main`, which is raised to 1.
         */
        z-index: 0;
        display: block;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }
      main { position: relative; z-index: 1; }
      /* The panel sits on moving colour now, so it needs to hold its own
         ground rather than let it through. */
      .panel { backdrop-filter: blur(14px); }

      /* Shown once the password is saved, in place of the form. */
      .done { max-width: 34rem; }
      .done h2 {
        margin: 0 0 10px;
        font-family: var(--serif, Georgia, serif);
        font-size: 1.5rem;
        color: var(--accent);
      }
      .done p { margin: 0; color: var(--muted); line-height: 1.6; }
      .done:focus { outline: none; }
    </style>
  </head>
  <body>
    <canvas id="backdrop" aria-hidden="true"></canvas>
    <main>
      <h1 id="heading">Set your password</h1>
      <p class="lede" id="lede">Checking your link…</p>

      <div class="panel" id="panel" hidden>
        <form id="form">
          <label>
            <span class="label-text">New password</span>
            <input
              type="password"
              id="password"
              autocomplete="new-password"
              minlength="10"
              required
            />
          </label>
          <p class="hint">At least 10 characters. Longer is better than complicated.</p>
          <label>
            <span class="label-text">Confirm password</span>
            <input
              type="password"
              id="confirm"
              autocomplete="new-password"
              minlength="10"
              required
            />
          </label>
          <button type="submit" id="submit">Set password</button>
        </form>
        <p class="message" id="message" hidden></p>
      </div>

      <!--
        Shown instead of the form once the password is saved. The founder is
        not signed in by setting a password: they go back and use it, which is
        the only way anyone finds out on the spot that the thing their password
        manager saved is the thing that works.
      -->
      <section class="panel done" id="done" hidden>
        <h2>Password set</h2>
        <!--
          A message, not a way in.

          There was a "Go to sign in" link here. Tai: a note is enough. It is
          also the more honest end to this page: setting a password does not
          sign anyone in, and a button straight after it reads like it might.
        -->
        <p id="done-text">
          Your password is saved. Head back to the sign-in page and use it.
        </p>
      </section>

      <p class="message error" id="fatal" hidden></p>
    </main>

    <script>
      import { mountAnimatedGradient } from "../lib/animatedGradient";

      const canvas = document.getElementById("backdrop");
      /* Null when WebGL2 is missing. This is the page where a founder sets a
         password; it cannot depend on a GPU, so the canvas simply goes and the
         page keeps its flat background. */
      if (canvas && !mountAnimatedGradient(canvas)) canvas.remove();
    </script>

    <script is:inline>
      const token = new URLSearchParams(location.search).get("token");
      const heading = document.getElementById("heading");
      const lede = document.getElementById("lede");
      const panel = document.getElementById("panel");
      const fatal = document.getElementById("fatal");
      const form = document.getElementById("form");
      const submit = document.getElementById("submit");
      const message = document.getElementById("message");

      function fail(text) {
        lede.hidden = true;
        panel.hidden = true;
        fatal.textContent = text;
        fatal.hidden = false;
      }

      function show(text, isError) {
        message.textContent = text;
        message.className = "message " + (isError ? "error" : "ok");
        message.hidden = false;
      }

      async function init() {
        if (!token) {
          heading.textContent = "No setup link";
          return fail("Open the link the Sprint team sent you.");
        }
        try {
          const res = await fetch("/api/invite?token=" + encodeURIComponent(token));
          const data = await res.json();
          if (!res.ok) {
            heading.textContent = "Link expired";
            return fail(data.error || "This link is no longer valid.");
          }
          heading.textContent = "Welcome, " + data.name.split(" ")[0];
          lede.textContent = "Choose a password for " + data.email + ".";
          panel.hidden = false;
        } catch {
          heading.textContent = "Something went wrong";
          fail("Could not reach the server. Check your connection and reload.");
        }
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const password = document.getElementById("password").value;
        const confirm = document.getElementById("confirm").value;

        if (password !== confirm) return show("The two passwords do not match.", true);
        if (password.length < 10) return show("Use at least 10 characters.", true);

        submit.disabled = true;
        show("Saving…", false);

        try {
          const res = await fetch("/api/invite", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, password }),
          });
          const data = await res.json();
          if (!res.ok) {
            submit.disabled = false;
            return show(data.error || "Could not set your password.", true);
          }
          /*
             No redirect, and no session: the API does not open one any more.
             The setup link stays out of history by being replaced with the
             same page minus its query string, so a back button cannot put a
             spent credential back in the address bar.
          */
          history.replaceState(null, "", location.pathname);
          document.getElementById("panel").hidden = true;
          document.getElementById("heading").textContent = "You are all set";
          document.getElementById("lede").hidden = true;
          const done = document.getElementById("done");
          done.hidden = false;
          /* Focus the message itself. There is no control left to move to, and
             leaving focus on a submit button that is now hidden strands anyone
             using a keyboard or a screen reader. */
          done.setAttribute("tabindex", "-1");
          done.focus();
        } catch {
          submit.disabled = false;
          show("Could not reach the server. Try again.", true);
        }
      });

      init();
    </script>
  </body>
</html>
