---
/**
 * The Aalto mark for /admin, beside the page title.
 *
 * The React app has its own copy at AaltoMark.tsx, which sits next to the
 * Sprint Buddy wordmark. Two files because the two sides of this product are
 * two different technologies, not because they disagree: same source path,
 * same guard, same restraint.
 *
 * No artwork here. The mark is a trademarked asset with approved files and
 * clear-space rules, so this is the slot: drop the reverse-on-dark SVG at
 * public/aalto-logo.svg and it appears.
 *
 * It removes itself if the file is not there. A broken-image icon beside a
 * page title is worse than no logo at all.
 */
---

<img
  class="aalto-mark"
  data-aalto-mark
  src="/aalto-logo.svg"
  alt="Aalto University"
  hidden
/>

<script is:inline>
  (function () {
    var img = document.querySelector("[data-aalto-mark]");
    if (!img) return;
    img.addEventListener("load", function () { img.hidden = false; });
    img.addEventListener("error", function () { img.remove(); });
    // A cached image can finish before the listener is attached.
    if (img.complete && img.naturalWidth > 0) img.hidden = false;
    else if (img.complete) img.remove();
  })();
</script>

<style is:global>
  .aalto-mark {
    display: block;
    height: 22px;
    width: auto;
    max-width: 132px;
    opacity: 0.62;
  }
</style>
