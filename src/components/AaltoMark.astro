---
/**
 * The Aalto mark for /admin, beside the page title.
 *
 * The React app has its own copy at AaltoMark.tsx, which sits next to the
 * Sprint Buddy wordmark. Two files because the two sides of this product are
 * two different technologies, not because they disagree: same source path,
 * same guard, same restraint.
 *
 * No artwork here. The mark is a trademarked asset with approved files and
 * clear-space rules, so this is the slot: drop the reverse-on-dark SVG at
 * public/aalto-logo.svg and it appears.
 *
 * It removes itself if the file is not there. A broken-image icon beside a
 * page title is worse than no logo at all.
 *
 * The rule before it is part of this component rather than the page. It used
 * to be a span in admin.astro, so when the mark removed itself the page was
 * left showing "Cohort admin" followed by a divider with nothing on the far
 * side of it. Both halves live or die together now.
 */
---

<span class="aalto-lockup" data-aalto-mark hidden>
  <span aria-hidden="true" class="aalto-rule"></span>
  <img class="aalto-mark" src="/aalto-logo.svg" alt="Aalto University" />
</span>

<script is:inline>
  (function () {
    var box = document.querySelector("[data-aalto-mark]");
    if (!box) return;
    var img = box.querySelector("img");
    if (!img) return;
    img.addEventListener("load", function () { box.hidden = false; });
    img.addEventListener("error", function () { box.remove(); });
    // A cached image can finish before the listener is attached.
    if (img.complete && img.naturalWidth > 0) box.hidden = false;
    else if (img.complete) box.remove();
  })();
</script>

<style is:global>
  .aalto-lockup { display: inline-flex; align-items: center; gap: 14px; }
  .aalto-rule {
    width: 1px; height: 26px;
    background: var(--border-strong);
    flex-shrink: 0;
  }
  .aalto-mark {
    display: block;
    height: 22px;
    width: auto;
    max-width: 132px;
    opacity: 0.62;
  }
</style>
