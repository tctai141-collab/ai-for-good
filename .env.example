# Sprint Buddy app runtime
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
DB_PATH=/opt/sprint-buddy-data/sprint-buddy.db

# Shared/default OpenClaw gateway used by /api/founder-os/chat
OPENCLAW_URL=http://135.181.71.10:18789/v1/chat/completions
OPENCLAW_TOKEN=replace-with-openclaw-gateway-token

# Founder-specific OpenClaw gateways.
# Add matching routes in src/pages/api/founder-os/chat.ts.
OPENCLAW_URL_FOUNDER2=http://replace-with-founder2-openclaw-ip:18789/v1/chat/completions

# Terraform/OpenClaw provisioning helpers.
# These are read by Terraform as TF_VAR_* when exporting in the shell.
TF_VAR_openclaw_gateway_token=replace-with-openclaw-gateway-token
TF_VAR_deepseek_api_key=replace-with-deepseek-api-key

# OpenClaw-owned Telegram integration.
# Telegram is handled inside OpenClaw agents, not by the Astro app.
TELEGRAM_BOT_TOKEN=replace-with-telegram-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
TELEGRAM_ALLOWED_FOUNDER_MAP=/opt/openclaw/.openclaw/workspace/memory/telegram-founders.json

# OpenClaw-side TTS placeholders for future voice-note support.
TTS_PROVIDER=replace-with-provider
TTS_MODEL=replace-with-model-id
TTS_VOICE_FOUNDER=replace-with-voice-id
TTS_VOICE_MARTEN=replace-with-voice-id
TTS_VOICE_PAUL=replace-with-voice-id

# OpenClaw-side embeddings placeholders for future memory/index refresh.
EMBEDDINGS_PROVIDER=replace-with-provider
EMBEDDINGS_MODEL=replace-with-model-id
EMBEDDINGS_DIMENSIONS=replace-with-dimension-count
VECTOR_STORE_PATH=/opt/openclaw/.openclaw/workspace/memory/vector
