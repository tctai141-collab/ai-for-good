# Sprint Buddy app runtime
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
DB_PATH=/opt/sprint-buddy-data/sprint-buddy.db

# Which week of the 15-week sprint the cohort is in (1-15).
# Drives the schedule context injected into advisor and check-in prompts.
SPRINT_WEEK=1

# AI advisor. Required — /api/founder-os/chat cannot answer without it.
# Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# Optional advisor tuning.
# ANTHROPIC_MODEL defaults to claude-opus-5.
# ANTHROPIC_EFFORT is low | medium | high; raise it to trade latency for depth.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

# Public URL the app is reached at, e.g. https://sprintbuddy.example.com
# Used to build setup links. Without it, links behind a proxy point at localhost.
PUBLIC_BASE_URL=https://replace-with-your-domain

# First day of the 15-week sprint, e.g. 2026-09-09. Setting this makes the
# current week derive itself, and lets the cohort dashboard place check-ins
# into weeks. Without it, SPRINT_WEEK must be bumped by hand every week and the
# cohort heatmap has nothing to plot against.
SPRINT_START_DATE=2026-09-09
