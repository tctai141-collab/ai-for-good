# Sprint Buddy app runtime
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
DB_PATH=/opt/sprint-buddy-data/sprint-buddy.db

# Which week of the 15-week sprint the cohort is in (1-15).
# Drives the schedule context injected into advisor and check-in prompts.
SPRINT_WEEK=1

# AI advisor. Required — /api/founder-os/chat cannot answer without it.
# Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# Optional advisor tuning.
# ANTHROPIC_MODEL defaults to claude-opus-5.
# ANTHROPIC_EFFORT is low | medium | high; raise it to trade latency for depth.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

# Public URL the app is reached at, e.g. https://sprintbuddy.example.com
# Used to build setup links. Without it, links behind a proxy point at localhost.
PUBLIC_BASE_URL=https://replace-with-your-domain

# First day of the 15-week sprint, e.g. 2026-09-08 (a Tuesday). Setting this makes the
# current week derive itself, and lets the cohort dashboard place check-ins
# into weeks. Without it, SPRINT_WEEK must be bumped by hand every week and the
# cohort heatmap has nothing to plot against.
SPRINT_START_DATE=2026-09-08

# --- Database backups (Cloudflare R2, S3-compatible, EU jurisdiction) ---------
# Without these the app logs a warning at boot and takes no backups.
# See docs/operations/backups.md for bucket setup and the restore drill.
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=sprint-buddy-backups
R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
BACKUP_RETENTION_DAYS=30
# Local target instead of R2, for the restore drill or a manual snapshot:
# BACKUP_DIR=./.backups

# --- Invite and password-reset email (Resend, EU region) ---------------------
# Without these, setup links cannot be delivered and account creation fails
# closed rather than handing the link to the operator.
RESEND_API_KEY=<resend-api-key>
RESEND_FROM="Aalto Founder Sprint <no-reply@send.your-verified-domain>"
# Where a founder's reply goes. The From address is a no-reply, but the reset
# email tells them to raise the alarm if they did not request it — that has to
# reach a person. Leave unset only if nobody is monitoring an inbox.
RESEND_REPLY_TO=

# --- Error tracking (optional, EU region) ------------------------------------
SENTRY_DSN=
