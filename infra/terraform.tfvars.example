    location       = "FIN-01"
    kind           = "cpu"
    instance_type  = "CPU.4V.16G"
    os             = "ubuntu-24.04"
    os_volume_size = 80
    ssh_key_ids    = ["replace-with-verda-ssh-key-id"]
    openclaw_port  = 18789
  }
